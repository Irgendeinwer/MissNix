import { Theme } from "../theme.slint";

// =============================================================================
// Material 3 Navigation Rail Item (Vector SVG + Pill Highlight)
// =============================================================================
export component NavRailItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <int> badge-count: 0;
    in property <bool> active: false;
    out property <bool> has-focus <=> keyboard-focus.has-focus;
    callback clicked();
    property <bool> key-down: false;

    forward-focus: keyboard-focus;
    changed has-focus => { if (!root.has-focus) { root.key-down = false; } }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    height: 42px;
    vertical-stretch: 0;
    border-radius: 21px;
    border-width: root.has-focus ? 2px : 0px;
    border-color: Theme.primary;
    background: root.active
        ? Theme.primary-container
        : (touch.has-hover ? Theme.on-surface.with-alpha(0.06) : transparent);

    animate background { duration: 150ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 11px;

        Image {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            colorize: root.active ? Theme.primary : Theme.on-surface-variant;
            image-fit: ImageFit.contain;
        }

        Text {
            text: root.label;
            font-size: 13px;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            color: root.active ? Theme.on-primary-container : Theme.on-surface-variant;
        }

        if root.badge-count > 0 : Rectangle {
            width: max(22px, badge-txt.preferred-width + 10px);
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 10px;
            background: root.active ? Theme.primary : Theme.primary-container;

            badge-txt := Text {
                text: root.badge-count > 99 ? "99+" : "\{root.badge-count}";
                color: root.active ? Theme.on-primary : Theme.on-primary-container;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    keyboard-focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if ((event.text == " " || event.text == "\n") && !root.key-down) {
                root.key-down = true;
                root.clicked();
                return accept;
            }
            reject
        }
        key-released(event) => {
            if (event.text == " " || event.text == "\n") {
                root.key-down = false;
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            keyboard-focus.focus();
            root.clicked();
        }
    }
}

export component SectionCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";

    vertical-stretch: 0;
    min-width: 0px;
    border-radius: 16px;
    background: Theme.surface-container;
    border-width: 1px;
    border-color: Theme.outline-variant;

    VerticalLayout {
        min-width: 0px;
        padding: 20px;
        spacing: 14px;
        alignment: start;

        VerticalLayout {
            spacing: 3px;
            alignment: start;
            Text {
                text: root.title;
                font-size: 15px;
                font-weight: 700;
                color: Theme.on-surface;
                wrap: word-wrap;
            }
            if root.subtitle != "" : Text {
                text: root.subtitle;
                font-size: 12px;
                color: Theme.on-surface-variant;
                wrap: word-wrap;
            }
        }

        @children
    }
}

// =============================================================================
// Material 3 Toggle Switch (Replaces std-widgets Switch so active theme applies)
// =============================================================================
export component M3Switch inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> text: "";
    in property <bool> enabled: true;
    callback toggled(bool);

    height: max(28px, row.preferred-height);
    min-width: 56px;
    preferred-width: row.preferred-width;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    opacity: root.enabled ? 1.0 : 0.45;

    row := HorizontalLayout {
        width: 100%;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 10px;
        alignment: start;

        track := Rectangle {
            width: 44px;
            height: 24px;
            horizontal-stretch: 0;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: root.checked
                ? (sw-touch.has-hover ? Theme.primary.brighter(0.08) : Theme.primary)
                : (sw-touch.has-hover ? Theme.surface-container-highest.brighter(0.10) : Theme.surface-container-highest);
            border-width: root.checked ? 0px : 1.5px;
            border-color: sw-touch.has-hover ? Theme.on-surface-variant : Theme.outline;

            animate background { duration: 150ms; easing: ease-out; }
            animate border-color { duration: 150ms; easing: ease-out; }

            thumb := Rectangle {
                width: root.checked ? 18px : 14px;
                height: root.checked ? 18px : 14px;
                x: root.checked ? 23px : 5px;
                y: (parent.height - self.height) / 2;
                border-radius: self.height / 2;
                background: root.checked
                    ? Theme.on-primary
                    : (sw-touch.has-hover ? Theme.on-surface : Theme.on-surface-variant);

                animate x, width, height { duration: 160ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
                animate background { duration: 150ms; }

                if root.checked : Image {
                    width: 11px;
                    height: 11px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("../../assets/icons/check.svg");
                    colorize: Theme.primary;
                    image-fit: ImageFit.contain;
                }
            }
        }

        if root.text != "" : Text {
            text: root.text;
            font-size: 12.5px;
            font-weight: 500;
            color: Theme.on-surface;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }
    }

    sw-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// =============================================================================
// Material 3 Dropdown Select (Replaces std-widgets ComboBox)
// =============================================================================
export component M3Select inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    out property <string> current-value: (root.current-index >= 0 && root.current-index < root.model.length)
        ? root.model[root.current-index]
        : "";
    callback selected(string);

    height: 36px;
    min-width: 140px;
    vertical-stretch: 0;
    border-radius: 10px;
    background: sel-touch.has-hover ? Theme.surface-container-highest : Theme.surface-container-high;
    border-width: 1px;
    border-color: sel-touch.has-hover ? Theme.primary.with-alpha(0.65) : Theme.outline;
    opacity: root.enabled ? 1.0 : 0.45;

    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;

        Text {
            text: root.current-value;
            font-size: 12.5px;
            font-weight: 500;
            color: Theme.on-surface;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Image {
            width: 15px;
            height: 15px;
            y: (parent.height - self.height) / 2;
            source: @image-url("../../assets/icons/chevron-down.svg");
            colorize: sel-touch.has-hover ? Theme.primary : Theme.on-surface-variant;
            image-fit: ImageFit.contain;
        }
    }

    sel-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: root.model.length * 34px + 10px;
        close-policy: close-on-click-outside;

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 12px;
            background: Theme.surface-container-high;
            border-width: 1px;
            border-color: Theme.outline;
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #000000.with-alpha(0.32);

            VerticalLayout {
                padding: 5px;
                spacing: 0px;
                alignment: start;

                for item[idx] in root.model : Rectangle {
                    height: 34px;
                    border-radius: 8px;
                    background: idx == root.current-index
                        ? Theme.primary-container
                        : (opt-touch.has-hover ? Theme.surface-container-highest : transparent);

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;

                        Text {
                            text: item;
                            font-size: 12.5px;
                            font-weight: idx == root.current-index ? 700 : 500;
                            color: idx == root.current-index ? Theme.on-primary-container : Theme.on-surface;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        if idx == root.current-index : Image {
                            width: 13px;
                            height: 13px;
                            y: (parent.height - self.height) / 2;
                            source: @image-url("../../assets/icons/check.svg");
                            colorize: Theme.on-primary-container;
                            image-fit: ImageFit.contain;
                        }
                    }

                    opt-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-index = idx;
                            root.selected(item);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// Labels stack above the unchanged dropdown when there is not enough room
// for both at their natural widths.
export component M3LabeledSelect inherits Rectangle {
    in property <string> label;
    in property <[string]> model;
    in-out property <int> current-index;
    in property <length> select-width: 290px;
    callback selected(string);

    property <bool> stacked: root.width < 204px + root.select-width;
    min-width: 0px;
    height: root.stacked ? 62px : 36px;
    vertical-stretch: 0;

    Text {
        x: 0px;
        y: 0px;
        width: root.stacked ? root.width : 190px;
        height: root.stacked ? 20px : 36px;
        text: root.label;
        font-size: 12.5px;
        font-weight: 600;
        color: Theme.on-surface;
        vertical-alignment: center;
    }
    M3Select {
        x: root.stacked ? 0px : 204px;
        y: root.stacked ? 26px : 0px;
        width: min(root.select-width, max(0px, root.width - self.x));
        model: root.model;
        current-index <=> root.current-index;
        selected(value) => { root.selected(value); }
    }
}

// =============================================================================
// Material 3 Linear Progress Bar & Spinner (Theme.primary accented)
// =============================================================================
export component M3ProgressBar inherits Rectangle {
    in property <float> progress: 0.0;
    in property <bool> indeterminate: false;

    height: 5px;
    vertical-stretch: 0;
    border-radius: self.height / 2;
    background: Theme.surface-container-highest;
    clip: true;

    property <float> sweep: Math.mod(animation-tick() / 1100ms, 1.0);

    Rectangle {
        x: root.indeterminate
            ? (parent.width * (root.sweep * 1.4 - 0.4))
            : 0px;
        y: 0px;
        width: root.indeterminate
            ? parent.width * 0.40
            : parent.width * Math.clamp(root.progress, 0.0, 1.0);
        height: parent.height;
        border-radius: parent.border-radius;
        background: Theme.primary;
    }
}

export component M3Spinner inherits Rectangle {
    in property <bool> indeterminate: true;

    width: 16px;
    height: 16px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    background: transparent;

    property <float> phase: Math.mod(animation-tick() / 900ms, 1.0);

    Rectangle {
        width: parent.width;
        height: parent.height;
        x: 0px;
        y: 0px;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: Theme.primary.with-alpha(0.26);
        background: transparent;
    }

    Rectangle {
        property <angle> angle: root.phase * 1turn;
        property <length> orbit: (parent.width - 5px) / 2;
        width: 5px;
        height: 5px;
        x: (parent.width - self.width) / 2 + self.orbit * Math.cos(self.angle);
        y: (parent.height - self.height) / 2 + self.orbit * Math.sin(self.angle);
        border-radius: 2.5px;
        background: Theme.primary;
    }
}

// =============================================================================
// Solid Material 3 Vertical Scrollbar (Replaces Slint's 1px outline handle)
// =============================================================================
export component M3ScrollBar inherits Rectangle {
    in property <length> page-size;
    in property <length> maximum;
    in property <length> value;
    callback scrolled(length);

    property <bool> active-bar: self.maximum > 1px && self.page-size > 1px;
    property <length> pad-v: 3px;
    property <length> track-h: max(24px, root.height - 2 * self.pad-v);
    property <float> page-ratio: Math.clamp(self.page-size / max(1px, self.page-size + self.maximum), 0.06, 1.0);
    property <length> thumb-h: max(min(32px, self.track-h), min(self.track-h, self.track-h * self.page-ratio));
    property <length> travel: max(1px, self.track-h - self.thumb-h);
    property <float> frac: Math.clamp(self.value / max(1px, self.maximum), 0.0, 1.0);
    property <length> thumb-y: self.pad-v + self.travel * self.frac;

    width: 11px;
    visible: self.active-bar;
    background: transparent;

    // Subtle tonal track capsule on hover/drag
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.pad-v;
        width: bar-touch.has-hover || bar-touch.pressed ? 7px : 6px;
        height: root.track-h;
        border-radius: self.width / 2;
        background: bar-touch.has-hover || bar-touch.pressed
            ? Theme.surface-container-highest.with-alpha(0.65)
            : transparent;

        animate background, width { duration: 120ms; }
    }

    // Solid rounded pill thumb (zero border outline)
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.thumb-y;
        width: bar-touch.has-hover || bar-touch.pressed ? 7px : 6px;
        height: root.thumb-h;
        border-radius: self.width / 2;
        border-width: 0px;
        background: bar-touch.pressed ? Theme.primary
                  : bar-touch.has-hover ? Theme.on-surface-variant
                  : Theme.on-surface-muted.with-alpha(0.75);

        animate background, width { duration: 120ms; }
    }

    bar-touch := TouchArea {
        property <length> start-val: 0px;
        property <length> start-max: 0px;
        property <length> start-y: 0px;
        property <bool> grabbed-thumb: false;

        mouse-cursor: pointer;

        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                self.start-max = root.maximum;
                self.start-y = self.mouse-y;
                if (self.mouse-y >= root.thumb-y && self.mouse-y <= root.thumb-y + root.thumb-h) {
                    self.grabbed-thumb = true;
                    self.start-val = root.value;
                } else {
                    self.grabbed-thumb = false;
                    self.start-val = max(
                        0px,
                        min(
                            root.maximum,
                            root.maximum * ((self.mouse-y - root.pad-v - root.thumb-h / 2) / root.travel)
                        )
                    );
                    root.scrolled(self.start-val);
                }
            }
        }

        moved => {
            if (self.pressed && root.active-bar) {
                if (self.start-max != root.maximum) {
                    self.start-max = root.maximum;
                    self.start-val = root.value;
                    self.start-y = self.mouse-y;
                }
                if (self.grabbed-thumb) {
                    root.scrolled(max(
                        0px,
                        min(
                            root.maximum,
                            self.start-val + root.maximum * ((self.mouse-y - self.start-y) / root.travel)
                        )
                    ));
                } else {
                    root.scrolled(max(
                        0px,
                        min(
                            root.maximum,
                            root.maximum * ((self.mouse-y - root.pad-v - root.thumb-h / 2) / root.travel)
                        )
                    ));
                }
            }
        }

        scroll-event(event) => {
            if (event.delta-y != 0px && root.active-bar) {
                root.scrolled(max(0px, min(root.maximum, root.value - event.delta-y)));
                return accept;
            }
            reject
        }
    }
}

// Themed horizontal scrollbar for compact toolbars and filter rows that
// cannot fit alongside the inspector at narrow window sizes.
export component M3HorizontalScrollBar inherits Rectangle {
    in property <length> page-size;
    in property <length> maximum;
    in property <length> value;
    callback scrolled(length);

    height: 10px;
    visible: root.maximum > 1px;
    background: transparent;
    property <length> track-width: max(0px, root.width - 4px);
    property <float> page-ratio: Math.clamp(root.page-size / max(1px, root.page-size + root.maximum), 0.0, 1.0);
    property <length> thumb-width: min(root.track-width, max(24px, root.track-width * root.page-ratio));
    property <length> travel: max(1px, root.track-width - root.thumb-width);
    property <length> thumb-x: 2px + root.travel * Math.clamp(root.value / max(1px, root.maximum), 0.0, 1.0);

    Rectangle {
        x: root.thumb-x;
        y: 2px;
        width: root.thumb-width;
        height: 5px;
        border-radius: 2.5px;
        background: bar-touch.pressed ? Theme.primary
                  : bar-touch.has-hover ? Theme.on-surface-variant
                  : Theme.on-surface-muted.with-alpha(0.75);
    }
    bar-touch := TouchArea {
        property <length> start-x: 0px;
        property <length> start-value: 0px;
        property <length> start-maximum: 0px;
        property <bool> grabbed-thumb: false;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                self.start-x = self.mouse-x;
                self.start-maximum = root.maximum;
                self.grabbed-thumb = self.mouse-x >= root.thumb-x && self.mouse-x <= root.thumb-x + root.thumb-width;
                self.start-value = self.grabbed-thumb ? root.value
                    : Math.clamp(root.maximum * ((self.mouse-x - 2px - root.thumb-width / 2) / root.travel), 0px, root.maximum);
                if (!self.grabbed-thumb) { root.scrolled(self.start-value); }
            }
        }
        moved => {
            if (self.pressed) {
                if (self.start-maximum != root.maximum) {
                    self.start-maximum = root.maximum;
                    self.start-value = root.value;
                    self.start-x = self.mouse-x;
                }
                root.scrolled(self.grabbed-thumb
                    ? Math.clamp(self.start-value + root.maximum * ((self.mouse-x - self.start-x) / root.travel), 0px, root.maximum)
                    : Math.clamp(root.maximum * ((self.mouse-x - 2px - root.thumb-width / 2) / root.travel), 0px, root.maximum));
            }
        }
    }
}
