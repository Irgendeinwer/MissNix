import { Theme } from "../theme.slint";

// =============================================================================
// Dynamic Custom Brand Logo (Reacts to Accent Theme & Active Radar Scan/Sync)
// =============================================================================
export component MissNixLogo inherits Rectangle {
    in property <bool> scanning: false;

    width: 40px;
    height: 40px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    border-radius: 12px;
    background: Theme.primary-container;
    border-width: 1px;
    border-color: logo-touch.has-hover ? Theme.primary : Theme.primary.with-alpha(0.42);
    clip: true;

    animate background { duration: 180ms; }
    animate border-color { duration: 150ms; }

    // Subtle pulsing radar wave when syncing/scanning
    if root.scanning : Rectangle {
        property <float> phase: Math.mod(animation-tick() / 1200ms, 1.0);
        width: 14px + self.phase * 26px;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        border-width: 1.5px;
        border-color: Theme.primary.with-alpha(1.0 - self.phase);
        background: transparent;
    }

    Image {
        width: 30px;
        height: 30px;
        x: 5px;
        y: 5px;
        source: @image-url("../../assets/icons/logo-mark.svg");
        colorize: Theme.primary;
        image-fit: ImageFit.contain;
    }

    // Orbiting radar blip dot during active scan/check, resting at 45° otherwise
    Rectangle {
        property <angle> theta: root.scanning
            ? (Math.mod(animation-tick() / 1400ms, 1.0) * 360deg)
            : -45deg;
        width: 5px;
        height: 5px;
        border-radius: 2.5px;
        background: Theme.on-primary-container;
        x: 20px + Math.cos(self.theta) * 9.5px - 2.5px;
        y: 20px + Math.sin(self.theta) * 9.5px - 2.5px;
    }

    logo-touch := TouchArea {}
}

// =============================================================================
// Bounded Material 3 Tonal Badge (Never stretches horizontally or vertically)
// =============================================================================
export component TonalBadge inherits Rectangle {
    in property <string> label;
    in property <brush> badge-bg: Theme.secondary-container;
    in property <brush> badge-fg: Theme.on-secondary-container;

    height: 20px;
    width: txt.preferred-width + 12px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 6px;
    background: root.badge-bg;

    txt := Text {
        width: 100%;
        height: 100%;
        text: root.label;
        color: root.badge-fg;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.4px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// =============================================================================
// Bounded Material 3 Desktop Button (Filled / Tonal / Outlined / Danger)
// =============================================================================
export component M3Button inherits Rectangle {
    in property <string> text;
    // "filled", "tonal", "primary-tonal", "outlined", "danger"
    in property <string> variant: "tonal";
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    in property <bool> fill-width: false;
    callback clicked();

    property <color> base-bg: root.variant == "filled" ? Theme.primary
                            : root.variant == "primary-tonal" ? Theme.primary-container
                            : root.variant == "danger" ? Theme.error-container
                            : root.variant == "outlined" ? #00000000
                            : Theme.secondary-container;

    property <color> fg-color: root.variant == "filled" ? Theme.on-primary
                             : root.variant == "primary-tonal" ? Theme.on-primary-container
                             : root.variant == "danger" ? Theme.on-error-container
                             : root.variant == "outlined" ? Theme.on-surface
                             : Theme.on-secondary-container;

    height: root.compact ? 32px : 36px;
    vertical-stretch: 0;
    horizontal-stretch: root.fill-width ? 1 : 0;
    min-width: content-row.preferred-width;
    preferred-width: content-row.preferred-width;
    border-radius: self.height / 2;
    opacity: root.enabled ? 1.0 : 0.45;

    background: !root.enabled ? root.base-bg
              : touch.pressed ? (root.variant == "outlined" ? Theme.on-surface.with-alpha(0.14) : root.base-bg.darker(0.10))
              : touch.has-hover ? (root.variant == "outlined" ? Theme.on-surface.with-alpha(0.07) : root.base-bg.brighter(0.09))
              : root.base-bg;

    border-width: root.variant == "outlined" ? 1px : 0px;
    border-color: touch.has-hover ? Theme.primary.with-alpha(0.65) : Theme.outline;

    animate background { duration: 115ms; easing: ease-out; }
    animate border-color { duration: 115ms; easing: ease-out; }

    content-row := HorizontalLayout {
        padding-left: root.has-icon ? (root.compact ? 11px : 14px) : (root.compact ? 13px : 16px);
        padding-right: root.compact ? 13px : 16px;
        spacing: 7px;
        alignment: center;

        if root.has-icon : Image {
            width: root.compact ? 15px : 16px;
            height: root.compact ? 15px : 16px;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            colorize: root.fg-color;
            image-fit: ImageFit.contain;
        }

        Text {
            text: root.text;
            font-size: root.compact ? 12px : 12.5px;
            font-weight: 600;
            color: root.fg-color;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// =============================================================================
// Bounded Circular Material 3 Icon Button (Fixed Square, Never Stretches)
// =============================================================================
export component M3IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> size: 34px;
    in property <length> icon-size: 17px;
    in property <bool> active: false;
    in property <bool> filled-primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    width: root.size;
    height: root.size;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: root.size / 2;
    opacity: root.enabled ? 1.0 : 0.42;

    property <color> icon-fg: root.filled-primary ? Theme.on-primary
                            : root.danger ? (root.active ? Theme.on-error-container : Theme.error)
                            : root.active ? Theme.on-primary-container
                            : Theme.on-surface-variant;

    background: root.filled-primary
        ? (touch.pressed ? Theme.primary.darker(0.10) : touch.has-hover ? Theme.primary.brighter(0.08) : Theme.primary)
        : root.danger && root.active
            ? Theme.error-container
            : root.active
                ? (touch.has-hover ? Theme.primary-container.brighter(0.08) : Theme.primary-container)
                : (touch.pressed ? Theme.on-surface.with-alpha(0.14) : touch.has-hover ? Theme.on-surface.with-alpha(0.08) : transparent);

    border-width: root.active && !root.filled-primary ? 1px : 0px;
    border-color: root.danger ? Theme.error.with-alpha(0.45) : Theme.primary.with-alpha(0.45);

    animate background { duration: 115ms; easing: ease-out; }

    Image {
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: root.icon-fg;
        image-fit: ImageFit.contain;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// =============================================================================
// Material 3 Filter Chip (Segmented / Filterable Desktop Chip)
// =============================================================================
export component M3FilterChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    height: 32px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    width: row.preferred-width;
    border-radius: 8px;

    background: root.selected
        ? (touch.has-hover ? Theme.primary-container.brighter(0.08) : Theme.primary-container)
        : (touch.has-hover ? Theme.surface-container-high : Theme.surface-container);

    border-width: 1px;
    border-color: root.selected ? Theme.primary.with-alpha(0.55) : Theme.outline-variant;

    animate background { duration: 120ms; easing: ease-out; }
    animate border-color { duration: 120ms; easing: ease-out; }

    row := HorizontalLayout {
        padding-left: root.selected ? 10px : 12px;
        padding-right: 12px;
        spacing: 5px;
        alignment: center;

        if root.selected : Image {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            source: @image-url("../../assets/icons/check.svg");
            colorize: Theme.on-primary-container;
            image-fit: ImageFit.contain;
        }

        Text {
            text: root.label;
            font-size: 12px;
            font-weight: root.selected ? 700 : 500;
            color: root.selected ? Theme.on-primary-container : Theme.on-surface-variant;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// =============================================================================
// Material 3 Pill Search Field (Bounded Height, Leading Search SVG, Clear X)
// =============================================================================
export component M3SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "Search...";
    callback edited();
    callback accepted(string);

    public function focus-input() {
        inner.focus();
    }

    height: 38px;
    vertical-stretch: 0;
    border-radius: 19px;
    background: inner.has-focus ? Theme.surface-container-highest : Theme.surface-container-high;
    border-width: inner.has-focus ? 1.5px : 1px;
    border-color: inner.has-focus ? Theme.primary : Theme.outline-variant;

    animate background { duration: 130ms; }
    animate border-color { duration: 130ms; }

    HorizontalLayout {
        padding-left: 13px;
        padding-right: 8px;
        spacing: 8px;

        Image {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            source: @image-url("../../assets/icons/search.svg");
            colorize: inner.has-focus ? Theme.primary : Theme.on-surface-muted;
            image-fit: ImageFit.contain;
        }

        Rectangle {
            horizontal-stretch: 1;
            clip: true;

            if root.text == "" : Text {
                width: 100%;
                height: 100%;
                text: root.placeholder;
                font-size: 12.5px;
                color: Theme.on-surface-muted;
                vertical-alignment: center;
                overflow: elide;
            }

            inner := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.text;
                font-size: 12.5px;
                color: Theme.on-surface;
                selection-background-color: Theme.primary.with-alpha(0.35);
                selection-foreground-color: Theme.on-surface;
                vertical-alignment: center;
                single-line: true;
                edited => { root.edited(); }
                accepted => { root.accepted(root.text); }
            }
        }

        if root.text != "" : M3IconButton {
            size: 24px;
            icon-size: 13px;
            y: (parent.height - self.height) / 2;
            icon: @image-url("../../assets/icons/close.svg");
            clicked => {
                root.text = "";
                root.edited();
            }
        }
    }
}

// =============================================================================
// Material 3 Labeled Text Field (Never Loses Field Identity, Bounded Height)
// =============================================================================
export component M3LabeledInput inherits VerticalLayout {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> text;
    callback edited();
    callback accepted(string);

    spacing: 4px;
    vertical-stretch: 0;

    if root.label != "" : Text {
        text: root.label;
        font-size: 11px;
        font-weight: 600;
        color: field-input.has-focus ? Theme.primary : Theme.on-surface-variant;
    }

    Rectangle {
        height: 38px;
        vertical-stretch: 0;
        border-radius: 10px;
        background: field-input.has-focus ? Theme.surface-container-highest : Theme.surface-container-high;
        border-width: field-input.has-focus ? 1.5px : 1px;
        border-color: field-input.has-focus ? Theme.primary : Theme.outline-variant;

        animate background { duration: 120ms; }
        animate border-color { duration: 120ms; }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 8px;
            spacing: 6px;

            Rectangle {
                horizontal-stretch: 1;
                clip: true;

                if root.text == "" : Text {
                    width: 100%;
                    height: 100%;
                    text: root.placeholder;
                    font-size: 12.5px;
                    color: Theme.on-surface-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }

                field-input := TextInput {
                    width: 100%;
                    height: 100%;
                    text <=> root.text;
                    font-size: 12.5px;
                    color: Theme.on-surface;
                    selection-background-color: Theme.primary.with-alpha(0.35);
                    selection-foreground-color: Theme.on-surface;
                    vertical-alignment: center;
                    single-line: true;
                    edited => { root.edited(); }
                    accepted => { root.accepted(root.text); }
                }
            }

            if root.text != "" : M3IconButton {
                size: 24px;
                icon-size: 13px;
                y: (parent.height - self.height) / 2;
                icon: @image-url("../../assets/icons/close.svg");
                clicked => {
                    root.text = "";
                    root.edited();
                }
            }
        }
    }
}

// =============================================================================
// Accent Color Swatch (Material 3 Customization Picker)
// =============================================================================
export component AccentSwatch inherits Rectangle {
    in property <color> swatch-color;
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    height: 36px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    width: row.preferred-width;
    border-radius: 18px;
    background: root.selected ? Theme.surface-container-highest : Theme.surface-container;
    border-width: root.selected ? 1.5px : 1px;
    border-color: root.selected ? root.swatch-color : Theme.outline-variant;

    animate background { duration: 130ms; }
    animate border-color { duration: 130ms; }

    row := HorizontalLayout {
        padding-left: 7px;
        padding-right: 12px;
        spacing: 8px;
        alignment: center;

        Rectangle {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: 11px;
            background: root.swatch-color;

            if root.selected : Image {
                width: 13px;
                height: 13px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: @image-url("../../assets/icons/check.svg");
                colorize: #141414;
                image-fit: ImageFit.contain;
            }
        }

        Text {
            text: root.label;
            font-size: 12px;
            font-weight: root.selected ? 700 : 500;
            color: root.selected ? Theme.on-surface : Theme.on-surface-variant;
            vertical-alignment: center;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
