import { Theme } from "../theme.slint";

// =============================================================================
// Dynamic Custom Brand Logo (Reacts to Accent Theme & Active Radar Scan/Sync)
// =============================================================================
export component MissNixLogo inherits Rectangle {
    in property <bool> scanning: false;

    width: 40px;
    height: 40px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    border-radius: 12px;
    background: Theme.primary-container;
    border-width: 1px;
    border-color: logo-touch.has-hover ? Theme.primary : Theme.primary.with-alpha(0.42);
    clip: true;

    animate background { duration: 180ms; }
    animate border-color { duration: 150ms; }

    // Subtle pulsing radar wave when syncing/scanning
    if root.scanning : Rectangle {
        property <float> phase: Math.mod(animation-tick() / 1200ms, 1.0);
        width: 14px + self.phase * 26px;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        border-width: 1.5px;
        border-color: Theme.primary.with-alpha(1.0 - self.phase);
        background: transparent;
    }

    Image {
        width: 30px;
        height: 30px;
        x: 5px;
        y: 5px;
        source: @image-url("../../assets/icons/logo-mark.svg");
        colorize: Theme.primary;
        image-fit: ImageFit.contain;
    }

    // Orbiting radar blip dot during active scan/check, resting at 45° otherwise
    Rectangle {
        property <angle> theta: root.scanning
            ? (Math.mod(animation-tick() / 1400ms, 1.0) * 360deg)
            : -45deg;
        width: 5px;
        height: 5px;
        border-radius: 2.5px;
        background: Theme.on-primary-container;
        x: 20px + Math.cos(self.theta) * 9.5px - 2.5px;
        y: 20px + Math.sin(self.theta) * 9.5px - 2.5px;
    }

    logo-touch := TouchArea {}
}

// =============================================================================
// Bounded Material 3 Tonal Badge (Never stretches horizontally or vertically)
// =============================================================================
export component TonalBadge inherits Rectangle {
    in property <string> label;
    in property <brush> badge-bg: Theme.secondary-container;
    in property <brush> badge-fg: Theme.on-secondary-container;

    height: 20px;
    width: txt.preferred-width + 12px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 6px;
    background: root.badge-bg;

    txt := Text {
        width: 100%;
        height: 100%;
        text: root.label;
        color: root.badge-fg;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.4px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// =============================================================================
// Bounded Material 3 Desktop Button (Filled / Tonal / Outlined / Danger)
// =============================================================================
export component M3Button inherits Rectangle {
    in property <string> text;
    // "filled", "tonal", "primary-tonal", "outlined", "danger"
    in property <string> variant: "tonal";
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    in property <bool> fill-width: false;
    out property <bool> has-focus <=> keyboard-focus.has-focus;
    callback clicked();
    property <bool> key-down: false;

    forward-focus: keyboard-focus;
    changed has-focus => { if (!root.has-focus) { root.key-down = false; } }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    property <color> base-bg: root.variant == "filled" ? Theme.primary
                            : root.variant == "primary-tonal" ? Theme.primary-container
                            : root.variant == "danger" ? Theme.error-container
                            : root.variant == "outlined" ? #00000000
                            : Theme.secondary-container;

    property <color> fg-color: root.variant == "filled" ? Theme.on-primary
                             : root.variant == "primary-tonal" ? Theme.on-primary-container
                             : root.variant == "danger" ? Theme.on-error-container
                             : root.variant == "outlined" ? Theme.on-surface
                             : Theme.on-secondary-container;

    height: root.compact ? 32px : 36px;
    vertical-stretch: 0;
    horizontal-stretch: root.fill-width ? 1 : 0;
    min-width: content-row.preferred-width;
    preferred-width: content-row.preferred-width;
    border-radius: self.height / 2;
    opacity: root.enabled ? 1.0 : 0.45;

    background: !root.enabled ? root.base-bg
              : touch.pressed ? (root.variant == "outlined" ? Theme.on-surface.with-alpha(0.14) : root.base-bg.darker(0.10))
              : touch.has-hover ? (root.variant == "outlined" ? Theme.on-surface.with-alpha(0.07) : root.base-bg.brighter(0.09))
              : root.base-bg;

    border-width: root.has-focus ? 2px : root.variant == "outlined" ? 1px : 0px;
    border-color: root.has-focus ? Theme.primary : touch.has-hover ? Theme.primary.with-alpha(0.65) : Theme.outline;

    animate background { duration: 115ms; easing: ease-out; }
    animate border-color { duration: 115ms; easing: ease-out; }

    content-row := HorizontalLayout {
        padding-left: root.has-icon ? (root.compact ? 11px : 14px) : (root.compact ? 13px : 16px);
        padding-right: root.compact ? 13px : 16px;
        spacing: 7px;
        alignment: center;

        if root.has-icon : Image {
            width: root.compact ? 15px : 16px;
            height: root.compact ? 15px : 16px;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            colorize: root.fg-color;
            image-fit: ImageFit.contain;
        }

        Text {
            text: root.text;
            font-size: root.compact ? 12px : 12.5px;
            font-weight: 600;
            color: root.fg-color;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    keyboard-focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if ((event.text == " " || event.text == "\n") && !root.key-down) {
                root.key-down = true;
                root.clicked();
                return accept;
            }
            reject
        }
        key-released(event) => {
            if (event.text == " " || event.text == "\n") {
                root.key-down = false;
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            keyboard-focus.focus();
            root.clicked();
        }
    }
}

// =============================================================================
// Bounded Circular Material 3 Icon Button (Fixed Square, Never Stretches)
// =============================================================================
export component M3IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> size: 34px;
    in property <length> icon-size: 17px;
    in property <bool> active: false;
    in property <bool> filled-primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    // Icon-only controls can supply a name for screen readers.
    in property <string> accessible-name: "";
    out property <bool> has-focus <=> keyboard-focus.has-focus;
    callback clicked();
    property <bool> key-down: false;

    forward-focus: keyboard-focus;
    changed has-focus => { if (!root.has-focus) { root.key-down = false; } }
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    width: root.size;
    height: root.size;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: root.size / 2;
    opacity: root.enabled ? 1.0 : 0.42;

    property <color> icon-fg: root.filled-primary ? Theme.on-primary
                            : root.danger ? (root.active ? Theme.on-error-container : Theme.error)
                            : root.active ? Theme.on-primary-container
                            : Theme.on-surface-variant;

    background: root.filled-primary
        ? (touch.pressed ? Theme.primary.darker(0.10) : touch.has-hover ? Theme.primary.brighter(0.08) : Theme.primary)
        : root.danger && root.active
            ? Theme.error-container
            : root.active
                ? (touch.has-hover ? Theme.primary-container.brighter(0.08) : Theme.primary-container)
                : (touch.pressed ? Theme.on-surface.with-alpha(0.14) : touch.has-hover ? Theme.on-surface.with-alpha(0.08) : transparent);

    border-width: root.has-focus ? 2px : root.active && !root.filled-primary ? 1px : 0px;
    border-color: root.danger ? Theme.error.with-alpha(0.65) : Theme.primary.with-alpha(root.has-focus ? 1.0 : 0.45);

    animate background { duration: 115ms; easing: ease-out; }

    Image {
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: root.icon-fg;
        image-fit: ImageFit.contain;
    }

    keyboard-focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if ((event.text == " " || event.text == "\n") && !root.key-down) {
                root.key-down = true;
                root.clicked();
                return accept;
            }
            reject
        }
        key-released(event) => {
            if (event.text == " " || event.text == "\n") {
                root.key-down = false;
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            keyboard-focus.focus();
            root.clicked();
        }
    }
}

// =============================================================================
// Material 3 Filter Chip (Segmented / Filterable Desktop Chip)
// =============================================================================
export component M3FilterChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    height: 32px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    width: row.preferred-width;
    border-radius: 8px;

    background: root.selected
        ? (touch.has-hover ? Theme.primary-container.brighter(0.08) : Theme.primary-container)
        : (touch.has-hover ? Theme.surface-container-high : Theme.surface-container);

    border-width: 1px;
    border-color: root.selected ? Theme.primary.with-alpha(0.55) : Theme.outline-variant;

    animate background { duration: 120ms; easing: ease-out; }
    animate border-color { duration: 120ms; easing: ease-out; }

    row := HorizontalLayout {
        padding-left: root.selected ? 10px : 12px;
        padding-right: 12px;
        spacing: 5px;
        alignment: center;

        if root.selected : Image {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            source: @image-url("../../assets/icons/check.svg");
            colorize: Theme.on-primary-container;
            image-fit: ImageFit.contain;
        }

        Text {
            text: root.label;
            font-size: 12px;
            font-weight: root.selected ? 700 : 500;
            color: root.selected ? Theme.on-primary-container : Theme.on-surface-variant;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// =============================================================================
// Material 3 Pill Search Field (Bounded Height, Leading Search SVG, Clear X)
// =============================================================================
export component M3SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "Search...";
    callback edited();
    callback accepted(string);

    public function focus-input() {
        inner.focus();
    }

    height: 38px;
    vertical-stretch: 0;
    border-radius: 19px;
    background: inner.has-focus ? Theme.surface-container-highest : Theme.surface-container-high;
    border-width: inner.has-focus ? 1.5px : 1px;
    border-color: inner.has-focus ? Theme.primary : Theme.outline-variant;

    animate background { duration: 130ms; }
    animate border-color { duration: 130ms; }

    HorizontalLayout {
        padding-left: 13px;
        padding-right: 8px;
        spacing: 8px;

        Image {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            source: @image-url("../../assets/icons/search.svg");
            colorize: inner.has-focus ? Theme.primary : Theme.on-surface-muted;
            image-fit: ImageFit.contain;
        }

        Rectangle {
            horizontal-stretch: 1;
            clip: true;

            if root.text == "" : Text {
                width: 100%;
                height: 100%;
                text: root.placeholder;
                font-size: 12.5px;
                color: Theme.on-surface-muted;
                vertical-alignment: center;
                overflow: elide;
            }

            inner := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.text;
                font-size: 12.5px;
                color: Theme.on-surface;
                selection-background-color: Theme.primary.with-alpha(0.35);
                selection-foreground-color: Theme.on-surface;
                vertical-alignment: center;
                single-line: true;
                edited => { root.edited(); }
                accepted => { root.accepted(root.text); }
            }
        }

        if root.text != "" : M3IconButton {
            size: 24px;
            icon-size: 13px;
            y: (parent.height - self.height) / 2;
            icon: @image-url("../../assets/icons/close.svg");
            accessible-name: "Clear search";
            clicked => {
                root.text = "";
                root.edited();
                inner.focus();
            }
        }
    }
}

// =============================================================================
// Material 3 Labeled Text Field (Never Loses Field Identity, Bounded Height)
// =============================================================================
export component M3LabeledInput inherits VerticalLayout {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> text;
    callback edited();
    callback accepted(string);

    spacing: 4px;
    vertical-stretch: 0;

    if root.label != "" : Text {
        text: root.label;
        font-size: 11px;
        font-weight: 600;
        color: field-input.has-focus ? Theme.primary : Theme.on-surface-variant;
    }

    Rectangle {
        height: 38px;
        vertical-stretch: 0;
        border-radius: 10px;
        background: field-input.has-focus ? Theme.surface-container-highest : Theme.surface-container-high;
        border-width: field-input.has-focus ? 1.5px : 1px;
        border-color: field-input.has-focus ? Theme.primary : Theme.outline-variant;

        animate background { duration: 120ms; }
        animate border-color { duration: 120ms; }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 8px;
            spacing: 6px;

            Rectangle {
                horizontal-stretch: 1;
                clip: true;

                if root.text == "" : Text {
                    width: 100%;
                    height: 100%;
                    text: root.placeholder;
                    font-size: 12.5px;
                    color: Theme.on-surface-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }

                field-input := TextInput {
                    width: 100%;
                    height: 100%;
                    text <=> root.text;
                    font-size: 12.5px;
                    color: Theme.on-surface;
                    selection-background-color: Theme.primary.with-alpha(0.35);
                    selection-foreground-color: Theme.on-surface;
                    vertical-alignment: center;
                    single-line: true;
                    edited => { root.edited(); }
                    accepted => { root.accepted(root.text); }
                }
            }

            if root.text != "" : M3IconButton {
                size: 24px;
                icon-size: 13px;
                y: (parent.height - self.height) / 2;
                icon: @image-url("../../assets/icons/close.svg");
                accessible-name: "Clear input";
                clicked => {
                    root.text = "";
                    root.edited();
                    field-input.focus();
                }
            }
        }
    }
}

// =============================================================================
// Accent Color Swatch (Material 3 Customization Picker)
// =============================================================================
export component AccentSwatch inherits Rectangle {
    in property <color> swatch-color;
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();

    height: 36px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    width: row.preferred-width;
    border-radius: 18px;
    background: root.selected ? Theme.surface-container-highest : Theme.surface-container;
    border-width: root.selected ? 1.5px : 1px;
    border-color: root.selected ? root.swatch-color : Theme.outline-variant;

    animate background { duration: 130ms; }
    animate border-color { duration: 130ms; }

    row := HorizontalLayout {
        padding-left: 7px;
        padding-right: 12px;
        spacing: 8px;
        alignment: center;

        Rectangle {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: 11px;
            background: root.swatch-color;

            if root.selected : Image {
                width: 13px;
                height: 13px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: @image-url("../../assets/icons/check.svg");
                colorize: #141414;
                image-fit: ImageFit.contain;
            }
        }

        Text {
            text: root.label;
            font-size: 12px;
            font-weight: root.selected ? 700 : 500;
            color: root.selected ? Theme.on-surface : Theme.on-surface-variant;
            vertical-alignment: center;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Fixed-size options flow to another row instead of getting compressed or
// clipped. This is used for settings whose options must remain readable.
export component M3ChipGrid inherits Rectangle {
    in property <[string]> labels;
    in property <[bool]> selections;
    in property <length> item-width: 96px;
    // Measure the longest label with a checkmark so fonts wider than the
    // bundled defaults do not spill past the edge of a fixed-size chip.
    in property <string> widest-label: "";
    callback activated(int);

    property <length> gap: 8px;
    out property <length> cell-width: max(root.item-width, measure-chip.width);
    property <int> columns: max(1, min(root.labels.length,
        Math.floor((root.width + root.gap) / (root.cell-width + root.gap))));
    property <int> rows: Math.ceil(root.labels.length / root.columns);
    min-width: 0px;
    height: root.rows * 32px + max(0, root.rows - 1) * root.gap;
    vertical-stretch: 0;

    measure-chip := M3FilterChip {
        x: 0px;
        y: 0px;
        visible: false;
        label: root.widest-label;
        selected: true;
    }
    for label[idx] in root.labels : M3FilterChip {
        x: Math.mod(idx, root.columns) * (root.cell-width + root.gap);
        y: Math.floor(idx / root.columns) * (32px + root.gap);
        width: min(root.cell-width, root.width);
        label: label;
        selected: root.selections[idx];
        clicked => { root.activated(idx); }
    }
}

export component M3LabeledChipGrid inherits Rectangle {
    in property <string> label;
    in property <[string]> labels;
    in property <[bool]> selections;
    in property <length> item-width: 96px;
    in property <string> widest-label: "";
    callback activated(int);

    property <bool> stacked: root.width < 200px
        + root.labels.length * chips.cell-width + max(0, root.labels.length - 1) * 8px;
    min-width: 0px;
    height: chips.height + (root.stacked ? 26px : 0px);
    vertical-stretch: 0;

    Text {
        x: 0px;
        y: 0px;
        width: root.stacked ? root.width : 190px;
        height: root.stacked ? 20px : 32px;
        text: root.label;
        font-size: 12.5px;
        font-weight: 600;
        color: Theme.on-surface;
        vertical-alignment: center;
    }
    chips := M3ChipGrid {
        x: root.stacked ? 0px : 200px;
        y: root.stacked ? 26px : 0px;
        width: max(0px, root.width - self.x);
        labels: root.labels;
        selections: root.selections;
        item-width: root.item-width;
        widest-label: root.widest-label;
        activated(index) => { root.activated(index); }
    }
}

export component AccentSwatchGrid inherits Rectangle {
    in property <int> selected-index;
    in property <color> custom-color;
    callback selected(int);

    property <[string]> labels: ["Iris", "Frost", "Emerald", "Amber", "Coral", "Copper", "Graphite", "Custom"];
    property <[color]> colors: [#c6b8ff, #76d0ff, #6ddeac, #fdb354, #ffa9ad, #ffad8d, #c4c4c4, root.custom-color];
    property <length> item-width: 110px;
    property <length> gap: 8px;
    // At most four across preserves the desktop's two-row palette.
    property <int> columns: max(1, min(4, Math.floor((root.width + root.gap) / (root.item-width + root.gap))));
    property <int> rows: Math.ceil(root.labels.length / root.columns);
    min-width: 0px;
    height: root.rows * 36px + max(0, root.rows - 1) * root.gap;
    vertical-stretch: 0;

    for label[idx] in root.labels : AccentSwatch {
        x: Math.mod(idx, root.columns) * (root.item-width + root.gap);
        y: Math.floor(idx / root.columns) * (36px + root.gap);
        width: min(root.item-width, root.width);
        label: label;
        swatch-color: root.colors[idx];
        selected: root.selected-index == idx;
        clicked => { root.selected(idx); }
    }
}
