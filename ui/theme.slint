export global Theme {
    in-out property <bool> dark-mode: true;
    // 0 = Iris Violet, 1 = Nord Frost, 2 = Emerald Sage, 3 = Amber Gold,
    // 4 = Coral Rose, 5 = Sunset Copper, 6 = Graphite Mono, 7 = Custom Hex (#RRGGBB)
    in-out property <int> accent-preset: 0;
    in-out property <color> custom-swatch: #8b8ef8;

    // -------------------------------------------------------------------------
    // Dynamic OKLCH Material 3 Surface Container Hierarchy
    // Populated at runtime from `missnix_core::resolve_theme_palette(...)`
    // so surfaces, rails, cards, outlines, and accents share the active hue.
    // -------------------------------------------------------------------------
    in-out property <color> surface: #111018;
    in-out property <color> surface-rail: #16141e;
    in-out property <color> surface-container-low: #191722;
    in-out property <color> surface-container: #1e1c27;
    in-out property <color> surface-container-high: #272532;
    in-out property <color> surface-container-highest: #312f3e;

    in-out property <color> on-surface: #f1eff8;
    in-out property <color> on-surface-variant: #aea9be;
    in-out property <color> on-surface-muted: #7f7a90;

    in-out property <color> outline: #575267;
    in-out property <color> outline-variant: #322f3f;

    // -------------------------------------------------------------------------
    // Dynamic Material 3 Primary & Secondary Tonal Tokens
    // -------------------------------------------------------------------------
    in-out property <color> primary: #c6b8ff;
    in-out property <color> on-primary: #2d1861;
    in-out property <color> primary-container: #382864;
    in-out property <color> on-primary-container: #e8deff;

    in-out property <color> secondary-container: #2b273a;
    in-out property <color> on-secondary-container: #e2ddf1;

    // Semantic Status Tokens
    out property <color> error: root.dark-mode ? #f2b8b5 : #b3261e;
    out property <color> error-container: root.dark-mode ? #4a2326 : #f9dedc;
    out property <color> on-error-container: root.dark-mode ? #f9dedc : #601410;

    out property <color> warning-container: root.dark-mode ? #46381e : #fef3c7;
    out property <color> on-warning-container: root.dark-mode ? #fde68a : #78350f;

    out property <color> success-container: root.dark-mode ? #163e31 : #d1fae5;
    out property <color> on-success-container: root.dark-mode ? #a7f3d0 : #065f46;
}
