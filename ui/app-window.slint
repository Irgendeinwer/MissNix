import {
    Button,
    CheckBox,
    ComboBox,
    LineEdit,
    ListView,
    Palette,
    ProgressIndicator,
    ScrollView,
    Spinner,
    Switch,
} from "std-widgets.slint";

import {
    ArtistRowData,
    FolderRowData,
    LocalAlbumRowData,
    ReleaseCardData,
    SearchCandidateRowData,
    TrackRowData,
} from "models.slint";

import {
    ArtistListRow,
    CoverArtwork,
    FolderItemRow,
    LocalAlbumItem,
    NavRailItem,
    ReleaseCard,
    SearchCandidateRow,
    SectionCard,
    TonalBadge,
    TrackRow,
} from "components.slint";

export {
    ArtistRowData,
    FolderRowData,
    LocalAlbumRowData,
    ReleaseCardData,
    SearchCandidateRowData,
    TrackRowData,
}

export component AppWindow inherits Window {
    title: "MissNix — Local Music Release Radar";
    min-width: 1020px;
    min-height: 660px;
    preferred-width: 1380px;
    preferred-height: 860px;
    background: Palette.background;

    // -------------------------------------------------------------------------
    // Navigation & Global State
    // -------------------------------------------------------------------------
    // 0 = Release Radar (Unread), 1 = All Releases, 2 = Tracked Artists, 3 = Library & Settings
    in-out property <int> active-view: 0;
    in property <int> unseen-badge-count: 0;
    in property <string> library-summary-text: "0 artists · 0 local albums";
    in property <string> status-banner-text: "Ready";
    in property <bool> status-is-warning: false;

    // Background worker telemetry
    in property <bool> is-busy: false;
    in property <bool> progress-indeterminate: false;
    in property <float> progress-fraction: 0.0;
    in property <string> busy-label: "";

    // -------------------------------------------------------------------------
    // Release Feed State
    // -------------------------------------------------------------------------
    in property <[ReleaseCardData]> releases: [];
    in-out property <string> feed-search-text: "";
    in-out property <int> feed-type-index: 0;       // 0 All, 1 Albums, 2 EPs, 3 Singles
    in-out property <int> feed-sort-index: 0;       // 0 Newest, 1 Upcoming, 2 Artist A-Z
    in-out property <bool> feed-hide-owned: true;
    in property <int> filtered-artist-id: 0;
    in property <string> filtered-artist-name: "";

    // Selected Release Inspector State
    in property <int> selected-release-id: 0;
    in property <ReleaseCardData> selected-release;
    in property <[TrackRowData]> selected-release-tracks: [];
    in property <bool> loading-tracks: false;

    // -------------------------------------------------------------------------
    // Tracked Artists State
    // -------------------------------------------------------------------------
    in property <[ArtistRowData]> artists: [];
    in-out property <string> artist-search-text: "";
    in-out property <int> artist-filter-index: 0;   // 0 All, 1 Tracked, 2 Muted, 3 Ignored, 4 Manual
    in-out property <bool> show-add-artist-bar: false;
    in-out property <string> manual-artist-query: "";
    in property <[SearchCandidateRowData]> artist-search-candidates: [];
    in property <bool> searching-external-artists: false;

    // Selected Artist Detail State
    in property <int> selected-artist-id: 0;
    in property <ArtistRowData> selected-artist;
    in property <[LocalAlbumRowData]> selected-artist-local-albums: [];
    in-out property <string> edit-artist-mbid: "";
    in-out property <string> edit-artist-deezer-id: "";

    // -------------------------------------------------------------------------
    // Library & Settings State
    // -------------------------------------------------------------------------
    in property <[FolderRowData]> library-folders: [];
    in-out property <string> new-folder-path: "";

    in-out property <bool> pref-dark-mode: true;
    in-out property <bool> pref-include-albums: true;
    in-out property <bool> pref-include-eps: true;
    in-out property <bool> pref-include-singles: true;
    in-out property <bool> pref-hide-owned: true;
    in-out property <bool> pref-hide-noise: true;
    in-out property <bool> pref-include-compilations: false;
    in-out property <int> pref-lookback-index: 2;   // 0=90d, 1=180d, 2=1y, 3=2y, 4=All
    in-out property <int> pref-provider-index: 0;   // 0=Deezer+MB, 1=Deezer, 2=MB
    in-out property <int> pref-schedule-index: 2;   // 0=Manual, 1=6h, 2=12h, 3=24h

    // -------------------------------------------------------------------------
    // Callbacks to Rust Controller
    // -------------------------------------------------------------------------
    callback navigate(int);
    callback scan-library();
    callback check-all-releases();
    callback cancel-background-task();

    // Feed callbacks
    callback feed-filters-changed();
    callback clear-artist-feed-filter();
    callback select-release(int);
    callback close-release-inspector();
    callback toggle-release-seen(int);
    callback dismiss-release(int);
    callback mark-all-seen();
    callback open-external-url(string);
    callback jump-to-artist(int);

    // Artists callbacks
    callback artist-filters-changed();
    callback select-artist(int);
    callback check-single-artist(int);
    callback view-artist-releases(int);
    callback toggle-artist-mute(int);
    callback toggle-artist-ignore(int);
    callback delete-artist(int);
    callback save-artist-provider-ids(int, string, string);
    callback search-external-artist(string);
    callback add-artist-by-name(string);
    callback add-search-candidate(int);

    // Settings & Folders callbacks
    callback browse-for-folder();
    callback add-folder-path(string);
    callback remove-folder(int);
    callback preferences-changed();
    callback theme-toggled(bool);

    public function apply-theme(dark: bool) {
        root.pref-dark-mode = dark;
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    // -------------------------------------------------------------------------
    // Keyboard Shortcuts
    // -------------------------------------------------------------------------
    forward-focus: key-scope;

    key-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.selected-release-id > 0) {
                    root.close-release-inspector();
                    return accept;
                }
                if (root.show-add-artist-bar) {
                    root.show-add-artist-bar = false;
                    return accept;
                }
            }
            if (event.modifiers.control && (event.text == "r" || event.text == "R")) {
                if (!root.is-busy) {
                    root.check-all-releases();
                }
                return accept;
            }
            if (event.text == "/" && (root.active-view == 0 || root.active-view == 1)) {
                feed-search-input.focus();
                return accept;
            }
            reject
        }

        HorizontalLayout {
            width: 100%;
            height: 100%;

            // =====================================================================
            // LEFT NAVIGATION RAIL (236px)
            // =====================================================================
            Rectangle {
                width: 236px;
                background: Palette.alternate-background;

                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    // Brand Header
                    HorizontalLayout {
                        padding-left: 4px;
                        padding-top: 2px;
                        padding-bottom: 6px;
                        spacing: 10px;

                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 10px;
                            background: Palette.accent-background;

                            Text {
                                text: "◈";
                                font-size: 18px;
                                font-weight: 700;
                                color: Palette.accent-foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: "MissNix";
                                font-size: 17px;
                                font-weight: 800;
                                color: Palette.foreground;
                            }
                            Text {
                                text: "Local Release Radar";
                                font-size: 11px;
                                color: Palette.foreground.with-alpha(0.58);
                            }
                        }
                    }

                    // Primary Navigation Destinations
                    VerticalLayout {
                        spacing: 4px;

                        NavRailItem {
                            glyph: "✦";
                            label: "Release Radar";
                            badge-count: root.unseen-badge-count;
                            active: root.active-view == 0;
                            clicked => { root.navigate(0); }
                        }

                        NavRailItem {
                            glyph: "◎";
                            label: "All Releases";
                            active: root.active-view == 1;
                            clicked => { root.navigate(1); }
                        }

                        NavRailItem {
                            glyph: "♫";
                            label: "Tracked Artists";
                            active: root.active-view == 2;
                            clicked => { root.navigate(2); }
                        }

                        NavRailItem {
                            glyph: "⚙";
                            label: "Library & Settings";
                            active: root.active-view == 3;
                            clicked => { root.navigate(3); }
                        }
                    }

                    // Spacer
                    Rectangle { vertical-stretch: 1; }

                    // Primary Sync & Scan Actions
                    VerticalLayout {
                        spacing: 8px;

                        Button {
                            text: "Check Releases";
                            primary: true;
                            enabled: !root.is-busy;
                            clicked => { root.check-all-releases(); }
                        }

                        Button {
                            text: "Scan Music Folders";
                            enabled: !root.is-busy;
                            clicked => { root.scan-library(); }
                        }
                    }

                    // Non-blocking Background Status & Telemetry Card
                    Rectangle {
                        border-radius: 10px;
                        background: Palette.background.with-alpha(0.65);
                        border-width: 1px;
                        border-color: root.status-is-warning
                            ? #f2b8b5.with-alpha(0.55)
                            : Palette.border.with-alpha(0.22);

                        VerticalLayout {
                            padding: 10px;
                            spacing: 7px;

                            if root.is-busy : VerticalLayout {
                                spacing: 7px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    Spinner {
                                        width: 18px;
                                        height: 18px;
                                        indeterminate: true;
                                    }
                                    Text {
                                        text: root.busy-label;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Palette.foreground;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                }

                                ProgressIndicator {
                                    height: 5px;
                                    indeterminate: root.progress-indeterminate;
                                    progress: root.progress-fraction;
                                }

                                Button {
                                    text: "Cancel";
                                    clicked => { root.cancel-background-task(); }
                                }
                            }

                            if !root.is-busy : VerticalLayout {
                                spacing: 3px;
                                Text {
                                    text: root.library-summary-text;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: Palette.foreground.with-alpha(0.84);
                                    overflow: elide;
                                }
                                Text {
                                    text: root.status-banner-text;
                                    font-size: 11px;
                                    color: root.status-is-warning
                                        ? #f2b8b5
                                        : Palette.foreground.with-alpha(0.56);
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                // Right border divider
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: 100%;
                    background: Palette.border.with-alpha(0.22);
                }
            }

            // =====================================================================
            // CENTER WORKSPACE
            // =====================================================================
            Rectangle {
                horizontal-stretch: 1;
                background: Palette.background;

                // -----------------------------------------------------------------
                // VIEW 0 & VIEW 1: RELEASE RADAR / ALL RELEASES
                // -----------------------------------------------------------------
                VerticalLayout {
                    visible: root.active-view == 0 || root.active-view == 1;
                    width: 100%;
                    height: 100%;

                    // Top Desktop Filter Bar
                    Rectangle {
                        background: Palette.background;

                        VerticalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            padding-top: 12px;
                            padding-bottom: 10px;
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 12px;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: root.active-view == 0 ? "Release Radar" : "All Discovered Releases";
                                        font-size: 20px;
                                        font-weight: 800;
                                        color: Palette.foreground;
                                    }
                                    Text {
                                        text: root.active-view == 0
                                            ? "Unseen albums, EPs, and singles from your local collection"
                                            : "Complete timeline across new, upcoming, seen, and owned releases";
                                        font-size: 12px;
                                        color: Palette.foreground.with-alpha(0.60);
                                    }
                                }

                                Rectangle { horizontal-stretch: 1; }

                                if root.filtered-artist-id > 0 : HorizontalLayout {
                                    spacing: 6px;
                                    TonalBadge {
                                        y: (parent.height - self.height) / 2;
                                        label: "Artist: \{root.filtered-artist-name}";
                                    }
                                    Button {
                                        height: 34px;
                                        y: (parent.height - self.height) / 2;
                                        text: "Clear Artist";
                                        clicked => { root.clear-artist-feed-filter(); }
                                    }
                                }

                                Switch {
                                    text: "Hide owned";
                                    checked <=> root.feed-hide-owned;
                                    toggled => { root.feed-filters-changed(); }
                                }

                                Button {
                                    text: "Mark All Seen";
                                    enabled: root.unseen-badge-count > 0;
                                    clicked => { root.mark-all-seen(); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;

                                feed-search-input := LineEdit {
                                    horizontal-stretch: 1;
                                    text <=> root.feed-search-text;
                                    placeholder-text: "Filter by artist or release title...  (Press / to focus)";
                                    edited => { root.feed-filters-changed(); }
                                }

                                ComboBox {
                                    width: 155px;
                                    model: ["All Types", "Albums Only", "EPs Only", "Singles Only"];
                                    current-index <=> root.feed-type-index;
                                    selected => { root.feed-filters-changed(); }
                                }

                                ComboBox {
                                    width: 175px;
                                    model: ["Newest First", "Upcoming First", "Artist A–Z"];
                                    current-index <=> root.feed-sort-index;
                                    selected => { root.feed-filters-changed(); }
                                }
                            }
                        }

                        Rectangle {
                            y: parent.height - 1px;
                            width: 100%;
                            height: 1px;
                            background: Palette.border.with-alpha(0.20);
                        }
                    }

                    // Empty State when no releases match
                    if root.releases.length == 0 : Rectangle {
                        vertical-stretch: 1;

                        Rectangle {
                            width: min(480px, parent.width - 48px);
                            height: 230px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            border-radius: 14px;
                            background: Palette.alternate-background;
                            border-width: 1px;
                            border-color: Palette.border.with-alpha(0.24);

                            VerticalLayout {
                                padding: 26px;
                                spacing: 12px;
                                alignment: center;

                                Text {
                                    text: root.library-folders.length == 0
                                        ? "Connect Your Local Music Library"
                                        : (root.active-view == 0
                                            ? "You're All Caught Up!"
                                            : "No Matching Releases Found");
                                    font-size: 18px;
                                    font-weight: 700;
                                    color: Palette.foreground;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: root.library-folders.length == 0
                                        ? "Add one or more local music folders to automatically discover the artists you listen to and track their latest drops."
                                        : (root.active-view == 0
                                            ? "No unread releases match your current filters. Run a release check or browse your full timeline."
                                            : "Try broadening your search, release type filter, or lookback window in Library & Settings.");
                                    font-size: 12px;
                                    color: Palette.foreground.with-alpha(0.65);
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 10px;

                                    if root.library-folders.length == 0 : Button {
                                        text: "Add Music Folder";
                                        primary: true;
                                        clicked => { root.navigate(3); }
                                    }

                                    if root.library-folders.length > 0 : Button {
                                        text: "Check Releases Now";
                                        primary: true;
                                        enabled: !root.is-busy;
                                        clicked => { root.check-all-releases(); }
                                    }

                                    if root.library-folders.length > 0 && root.active-view == 0 : Button {
                                        text: "Browse All Releases";
                                        clicked => { root.navigate(1); }
                                    }
                                }
                            }
                        }
                    }

                    // Responsive Multi-Column Cover-Art Grid
                    if root.releases.length > 0 : feed-scroll := ScrollView {
                        vertical-stretch: 1;

                        property <int> cols: max(2, min(6, Math.floor((self.visible-width - 24px) / 210px)));
                        property <length> gap: 14px;
                        property <length> pad: 18px;
                        property <length> card-w: max(168px, Math.floor(((self.visible-width - 2 * pad - (cols - 1) * gap) / cols) / 1px) * 1px);
                        property <length> card-h: card-w + 78px;
                        property <int> total-rows: Math.ceil(root.releases.length / cols);

                        content-width: self.visible-width;
                        content-height: max(self.visible-height, pad * 2 + total-rows * card-h + max(0, total-rows - 1) * gap);

                        for item[idx] in root.releases : ReleaseCard {
                            x: feed-scroll.pad + Math.mod(idx, feed-scroll.cols) * (feed-scroll.card-w + feed-scroll.gap);
                            y: feed-scroll.pad + Math.floor(idx / feed-scroll.cols) * (feed-scroll.card-h + feed-scroll.gap);
                            width: feed-scroll.card-w;
                            height: feed-scroll.card-h;
                            data: item;
                            selected: root.selected-release-id == item.id;

                            select-release(id) => { root.select-release(id); }
                            toggle-seen(id) => { root.toggle-release-seen(id); }
                            dismiss-release(id) => { root.dismiss-release(id); }
                            open-artist(aid) => { root.jump-to-artist(aid); }
                        }
                    }
                }

                // -----------------------------------------------------------------
                // VIEW 2: TRACKED ARTISTS (MASTER-DETAIL)
                // -----------------------------------------------------------------
                if root.active-view == 2 : HorizontalLayout {
                    width: 100%;
                    height: 100%;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        padding: 18px;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: "Tracked Artists";
                                    font-size: 20px;
                                    font-weight: 800;
                                    color: Palette.foreground;
                                }
                                Text {
                                    text: "Discovered from your audio tags & folders — mute, ignore, or add artists manually";
                                    font-size: 12px;
                                    color: Palette.foreground.with-alpha(0.60);
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Button {
                                text: root.show-add-artist-bar ? "Close Add Artist" : "+ Add Artist";
                                primary: !root.show-add-artist-bar;
                                clicked => {
                                    root.show-add-artist-bar = !root.show-add-artist-bar;
                                }
                            }
                        }

                        // Collapsible Manual Artist Search & Add Drawer
                        if root.show-add-artist-bar : Rectangle {
                            border-radius: 12px;
                            background: Palette.alternate-background;
                            border-width: 1px;
                            border-color: Palette.accent-background.with-alpha(0.40);

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                HorizontalLayout {
                                    spacing: 10px;

                                    LineEdit {
                                        horizontal-stretch: 1;
                                        text <=> root.manual-artist-query;
                                        placeholder-text: "Type artist name to search Deezer & MusicBrainz (or add directly)...";
                                        accepted(val) => { root.search-external-artist(val); }
                                    }

                                    Button {
                                        text: "Search Online";
                                        primary: true;
                                        enabled: root.manual-artist-query != "" && !root.searching-external-artists;
                                        clicked => { root.search-external-artist(root.manual-artist-query); }
                                    }

                                    Button {
                                        text: "Add by Name";
                                        enabled: root.manual-artist-query != "";
                                        clicked => { root.add-artist-by-name(root.manual-artist-query); }
                                    }
                                }

                                if root.searching-external-artists : HorizontalLayout {
                                    spacing: 8px;
                                    Spinner { width: 18px; height: 18px; indeterminate: true; }
                                    Text {
                                        text: "Searching Deezer & MusicBrainz...";
                                        font-size: 12px;
                                        color: Palette.foreground.with-alpha(0.65);
                                        vertical-alignment: center;
                                    }
                                }

                                if root.artist-search-candidates.length > 0 : VerticalLayout {
                                    spacing: 6px;
                                    for cand in root.artist-search-candidates : SearchCandidateRow {
                                        candidate: cand;
                                        add-candidate(idx) => { root.add-search-candidate(idx); }
                                    }
                                }
                            }
                        }

                        // Artist Filter Bar
                        HorizontalLayout {
                            spacing: 10px;

                            LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.artist-search-text;
                                placeholder-text: "Filter artists by name...";
                                edited => { root.artist-filters-changed(); }
                            }

                            ComboBox {
                                width: 180px;
                                model: ["All Artists", "Tracked Only", "Muted", "Ignored", "Manual Only"];
                                current-index <=> root.artist-filter-index;
                                selected => { root.artist-filters-changed(); }
                            }
                        }

                        if root.artists.length == 0 : Rectangle {
                            vertical-stretch: 1;
                            Text {
                                text: "No artists found. Scan your local music folders or click '+ Add Artist' above.";
                                font-size: 13px;
                                color: Palette.foreground.with-alpha(0.58);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        if root.artists.length > 0 : ListView {
                            vertical-stretch: 1;
                            for art in root.artists : VerticalLayout {
                                padding-bottom: 6px;
                                ArtistListRow {
                                    artist: art;
                                    selected: root.selected-artist-id == art.id;
                                    select-artist(id) => { root.select-artist(id); }
                                    quick-check(id) => { root.check-single-artist(id); }
                                    toggle-mute(id) => { root.toggle-artist-mute(id); }
                                    toggle-ignore(id) => { root.toggle-artist-ignore(id); }
                                }
                            }
                        }
                    }

                    // Right Artist Detail & Disambiguation Pane
                    if root.selected-artist-id > 0 : Rectangle {
                        width: 360px;
                        background: Palette.alternate-background;

                        Rectangle {
                            x: 0px;
                            width: 1px;
                            height: 100%;
                            background: Palette.border.with-alpha(0.22);
                        }

                        ScrollView {
                            width: 100%;
                            height: 100%;

                            VerticalLayout {
                                padding: 18px;
                                spacing: 14px;

                                HorizontalLayout {
                                    spacing: 10px;
                                    Text {
                                        text: root.selected-artist.name;
                                        font-size: 18px;
                                        font-weight: 800;
                                        color: Palette.foreground;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Button {
                                        text: "✕";
                                        clicked => { root.select-artist(0); }
                                    }
                                }

                                if root.selected-artist.disambiguation != "" : Text {
                                    text: root.selected-artist.disambiguation;
                                    font-size: 12px;
                                    color: Palette.foreground.with-alpha(0.66);
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: "\{root.selected-artist.source-label} · \{root.selected-artist.release-count} discovered releases";
                                    font-size: 12px;
                                    color: Palette.foreground.with-alpha(0.60);
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    Button {
                                        text: "Check Now";
                                        primary: true;
                                        enabled: !root.is-busy;
                                        clicked => { root.check-single-artist(root.selected-artist.id); }
                                    }
                                    Button {
                                        text: "View Drops";
                                        clicked => { root.view-artist-releases(root.selected-artist.id); }
                                    }
                                }

                                if root.selected-artist.external-url != "" : Button {
                                    text: "Open Artist Page ↗";
                                    clicked => { root.open-external-url(root.selected-artist.external-url); }
                                }

                                if root.selected-artist.is-manual : Button {
                                    text: "Delete Manual Artist";
                                    clicked => { root.delete-artist(root.selected-artist.id); }
                                }

                                // Provider Identity / Homonym Override
                                Rectangle {
                                    height: 1px;
                                    background: Palette.border.with-alpha(0.20);
                                }

                                Text {
                                    text: "Provider Identity Link";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: Palette.foreground;
                                }
                                Text {
                                    text: "Auto-matched via tags & local discography. Override if two artists share this name:";
                                    font-size: 11px;
                                    color: Palette.foreground.with-alpha(0.58);
                                    wrap: word-wrap;
                                }

                                LineEdit {
                                    text <=> root.edit-artist-deezer-id;
                                    placeholder-text: "Deezer Artist ID (numeric)";
                                }

                                LineEdit {
                                    text <=> root.edit-artist-mbid;
                                    placeholder-text: "MusicBrainz Artist MBID (UUID)";
                                }

                                Button {
                                    text: "Save Provider IDs";
                                    clicked => {
                                        root.save-artist-provider-ids(
                                            root.selected-artist.id,
                                            root.edit-artist-mbid,
                                            root.edit-artist-deezer-id
                                        );
                                    }
                                }

                                // Owned Local Albums
                                Rectangle {
                                    height: 1px;
                                    background: Palette.border.with-alpha(0.20);
                                }

                                Text {
                                    text: "Local Library Albums (\{root.selected-artist-local-albums.length})";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: Palette.foreground;
                                }

                                if root.selected-artist-local-albums.length == 0 : Text {
                                    text: "No local albums indexed for this artist.";
                                    font-size: 11px;
                                    color: Palette.foreground.with-alpha(0.52);
                                }

                                for alb in root.selected-artist-local-albums : LocalAlbumItem {
                                    album: alb;
                                }
                            }
                        }
                    }
                }

                // -----------------------------------------------------------------
                // VIEW 3: LIBRARY & SETTINGS
                // -----------------------------------------------------------------
                if root.active-view == 3 : ScrollView {
                    width: 100%;
                    height: 100%;

                    VerticalLayout {
                        padding: 22px;
                        spacing: 16px;
                        alignment: start;

                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Library & Preferences";
                                font-size: 20px;
                                font-weight: 800;
                                color: Palette.foreground;
                            }
                            Text {
                                text: "Configure local music folders, smart deduplication rules, release providers, and theme";
                                font-size: 12px;
                                color: Palette.foreground.with-alpha(0.60);
                            }
                        }

                        // Card 1: Local Music Folders
                        SectionCard {
                            title: "Local Music Folders";
                            subtitle: "MissNix scans FLAC, MP3, Ogg Vorbis, Opus, M4A, WAV, and AIFF tags (falling back to Artist/Album folder names when tags are incomplete).";

                            HorizontalLayout {
                                spacing: 10px;

                                LineEdit {
                                    horizontal-stretch: 1;
                                    text <=> root.new-folder-path;
                                    placeholder-text: "Enter music directory path (e.g. ~/Music) or click Browse...";
                                    accepted(val) => { root.add-folder-path(val); }
                                }

                                Button {
                                    text: "Add Path";
                                    enabled: root.new-folder-path != "";
                                    clicked => { root.add-folder-path(root.new-folder-path); }
                                }

                                Button {
                                    text: "Browse...";
                                    clicked => { root.browse-for-folder(); }
                                }
                            }

                            if root.library-folders.length == 0 : Text {
                                text: "No folders added yet.";
                                font-size: 12px;
                                color: Palette.foreground.with-alpha(0.55);
                            }

                            for folder in root.library-folders : FolderItemRow {
                                folder: folder;
                                remove-folder(id) => { root.remove-folder(id); }
                            }

                            HorizontalLayout {
                                alignment: start;
                                Button {
                                    text: "Rescan All Folders Now";
                                    primary: true;
                                    enabled: !root.is-busy && root.library-folders.length > 0;
                                    clicked => { root.scan-library(); }
                                }
                            }
                        }

                        // Card 2: Release Filtering & Smart Deduplication
                        SectionCard {
                            title: "Release Radar & Smart Deduplication";
                            subtitle: "Control which release types appear in your feed and automatically suppress albums you already own locally.";

                            HorizontalLayout {
                                spacing: 24px;
                                CheckBox {
                                    text: "Albums";
                                    checked <=> root.pref-include-albums;
                                    toggled => { root.preferences-changed(); }
                                }
                                CheckBox {
                                    text: "EPs";
                                    checked <=> root.pref-include-eps;
                                    toggled => { root.preferences-changed(); }
                                }
                                CheckBox {
                                    text: "Singles";
                                    checked <=> root.pref-include-singles;
                                    toggled => { root.preferences-changed(); }
                                }
                            }

                            Switch {
                                text: "Smart Local Deduplication — hide releases already in your local music folders";
                                checked <=> root.pref-hide-owned;
                                toggled => { root.preferences-changed(); }
                            }

                            Switch {
                                text: "Filter out greatest-hits compilations, live bootlegs & karaoke editions";
                                checked <=> root.pref-hide-noise;
                                toggled => { root.preferences-changed(); }
                            }

                            Switch {
                                text: "Include one-off track artists from 'Various Artists' soundtrack/compilation albums";
                                checked <=> root.pref-include-compilations;
                                toggled => { root.preferences-changed(); }
                            }

                            HorizontalLayout {
                                spacing: 14px;
                                Text {
                                    text: "Release lookback window:";
                                    font-size: 13px;
                                    color: Palette.foreground;
                                    vertical-alignment: center;
                                    width: 210px;
                                }
                                ComboBox {
                                    width: 240px;
                                    model: [
                                        "Last 90 days",
                                        "Last 6 months",
                                        "Last 1 year",
                                        "Last 2 years",
                                        "All time"
                                    ];
                                    current-index <=> root.pref-lookback-index;
                                    selected => { root.preferences-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        // Card 3: Data Sources, Schedule & Theme
                        SectionCard {
                            title: "Providers, Schedule & Appearance";
                            subtitle: "Deezer provides fast artwork, tracklists, and 30s previews; MusicBrainz provides exact MBID disambiguation and upcoming release announcements.";

                            HorizontalLayout {
                                spacing: 14px;
                                Text {
                                    text: "Release lookup sources:";
                                    font-size: 13px;
                                    color: Palette.foreground;
                                    vertical-alignment: center;
                                    width: 210px;
                                }
                                ComboBox {
                                    width: 300px;
                                    model: [
                                        "Deezer + MusicBrainz (Recommended)",
                                        "Deezer Only",
                                        "MusicBrainz Only"
                                    ];
                                    current-index <=> root.pref-provider-index;
                                    selected => { root.preferences-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }

                            HorizontalLayout {
                                spacing: 14px;
                                Text {
                                    text: "Automatic check schedule:";
                                    font-size: 13px;
                                    color: Palette.foreground;
                                    vertical-alignment: center;
                                    width: 210px;
                                }
                                ComboBox {
                                    width: 300px;
                                    model: [
                                        "Manual check only",
                                        "Every 6 hours",
                                        "Every 12 hours",
                                        "Every 24 hours"
                                    ];
                                    current-index <=> root.pref-schedule-index;
                                    selected => { root.preferences-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }

                            Switch {
                                text: "Dark Material Theme";
                                checked <=> root.pref-dark-mode;
                                toggled => {
                                    Palette.color-scheme = root.pref-dark-mode
                                        ? ColorScheme.dark
                                        : ColorScheme.light;
                                    root.theme-toggled(root.pref-dark-mode);
                                }
                            }
                        }
                    }
                }
            }

            // =====================================================================
            // RIGHT RELEASE DETAIL INSPECTOR PANE (384px, visible on selection)
            // =====================================================================
            if (root.active-view == 0 || root.active-view == 1) && root.selected-release-id > 0 : Rectangle {
                width: 384px;
                background: Palette.alternate-background;

                Rectangle {
                    x: 0px;
                    width: 1px;
                    height: 100%;
                    background: Palette.border.with-alpha(0.24);
                }

                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;

                    // Inspector Header
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Release Details";
                            font-size: 14px;
                            font-weight: 700;
                            color: Palette.foreground.with-alpha(0.75);
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "Close (Esc)";
                            clicked => { root.close-release-inspector(); }
                        }
                    }

                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: 12px;
                            padding-right: 4px;

                            // High-res Artwork
                            HorizontalLayout {
                                alignment: center;
                                CoverArtwork {
                                    width: 240px;
                                    height: 240px;
                                    cover: root.selected-release.cover;
                                    has-cover: root.selected-release.has-cover;
                                    monogram: root.selected-release.monogram;
                                    accent-hue: root.selected-release.accent-hue;
                                    corner-radius: 12px;
                                }
                            }

                            // Badges Row
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;

                                TonalBadge {
                                    label: root.selected-release.release-type;
                                }

                                if root.selected-release.upcoming : TonalBadge {
                                    label: "UPCOMING";
                                    badge-bg: #1e4d3b;
                                    badge-fg: #a6f4c5;
                                }

                                if root.selected-release.owned-locally : TonalBadge {
                                    label: "IN LOCAL LIBRARY";
                                    badge-bg: #323544;
                                    badge-fg: #cfd4e6;
                                }

                                if root.selected-release.explicit : TonalBadge {
                                    label: "EXPLICIT";
                                    badge-bg: #4a3438;
                                    badge-fg: #f2b8b5;
                                }

                                TonalBadge {
                                    label: root.selected-release.provider-label;
                                }
                            }

                            // Title, Artist & Release Date
                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: root.selected-release.title;
                                    font-size: 18px;
                                    font-weight: 800;
                                    color: Palette.foreground;
                                    wrap: word-wrap;
                                }

                                Rectangle {
                                    height: 22px;
                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: root.selected-release.artist-name;
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: insp-artist-touch.has-hover
                                            ? Palette.accent-background.brighter(0.15)
                                            : Palette.accent-background;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    insp-artist-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.jump-to-artist(root.selected-release.artist-id); }
                                    }
                                }

                                Text {
                                    text: root.selected-release.release-date != ""
                                        ? "Released \{root.selected-release.release-date}"
                                        : "Release date TBA";
                                    font-size: 12px;
                                    color: Palette.foreground.with-alpha(0.58);
                                }
                            }

                            // Action Buttons
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    horizontal-stretch: 1;
                                    text: root.selected-release.unseen ? "Mark as Seen" : "Mark Unread";
                                    primary: root.selected-release.unseen;
                                    clicked => { root.toggle-release-seen(root.selected-release.id); }
                                }
                                Button {
                                    text: "Dismiss";
                                    clicked => { root.dismiss-release(root.selected-release.id); }
                                }
                            }

                            if root.selected-release.external-url != "" || root.selected-release.musicbrainz-url != "" : HorizontalLayout {
                                spacing: 8px;

                                if root.selected-release.external-url != "" : Button {
                                    horizontal-stretch: 1;
                                    text: "Open in Deezer ↗";
                                    clicked => { root.open-external-url(root.selected-release.external-url); }
                                }

                                if root.selected-release.musicbrainz-url != "" : Button {
                                    horizontal-stretch: 1;
                                    text: "MusicBrainz ↗";
                                    clicked => { root.open-external-url(root.selected-release.musicbrainz-url); }
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Palette.border.with-alpha(0.22);
                            }

                            // Tracklist Header & Rows
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Tracklist";
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: Palette.foreground;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                if root.selected-release-tracks.length > 0 : Text {
                                    text: "\{root.selected-release-tracks.length} tracks";
                                    font-size: 11px;
                                    color: Palette.foreground.with-alpha(0.55);
                                    vertical-alignment: center;
                                }
                            }

                            if root.loading-tracks : HorizontalLayout {
                                spacing: 8px;
                                padding-top: 8px;
                                Spinner { width: 20px; height: 20px; indeterminate: true; }
                                Text {
                                    text: "Loading tracklist...";
                                    font-size: 12px;
                                    color: Palette.foreground.with-alpha(0.62);
                                    vertical-alignment: center;
                                }
                            }

                            if !root.loading-tracks && root.selected-release-tracks.length == 0 : Text {
                                text: "Tracklist not yet available for this release.";
                                font-size: 12px;
                                color: Palette.foreground.with-alpha(0.52);
                            }

                            for trk in root.selected-release-tracks : TrackRow {
                                track: trk;
                                play-preview(url) => { root.open-external-url(url); }
                            }
                        }
                    }
                }
            }
        }
    }
}
