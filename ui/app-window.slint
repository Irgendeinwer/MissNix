import {
    ComboBox,
    ListView,
    Palette,
    ProgressIndicator,
    ScrollView,
    Spinner,
    Switch,
} from "std-widgets.slint";

import { Theme } from "theme.slint";

import {
    ArtistRowData,
    FolderRowData,
    LocalAlbumRowData,
    ReleaseCardData,
    SearchCandidateRowData,
    TrackRowData,
} from "models.slint";

import {
    AccentSwatch,
    ArtistAvatar,
    ArtistListRow,
    CoverArtwork,
    FolderItemRow,
    LocalAlbumItem,
    M3Button,
    M3FilterChip,
    M3IconButton,
    M3LabeledInput,
    M3SearchField,
    MissNixLogo,
    NavRailItem,
    PreviewMiniPlayer,
    ReleaseCard,
    SearchCandidateRow,
    SectionCard,
    TonalBadge,
    TrackRow,
} from "components.slint";

export {
    ArtistRowData,
    FolderRowData,
    LocalAlbumRowData,
    ReleaseCardData,
    SearchCandidateRowData,
    TrackRowData,
}

export component AppWindow inherits Window {
    title: "MissNix — Local Music Release Radar";
    min-width: 980px;
    min-height: 640px;
    preferred-width: 1400px;
    preferred-height: 880px;
    background: Theme.surface;

    // -------------------------------------------------------------------------
    // Navigation & Global State
    // -------------------------------------------------------------------------
    // 0 = Release Radar, 1 = Tracked Artists, 2 = Library & Settings
    in-out property <int> active-view: 0;
    in property <int> unseen-badge-count: 0;
    in property <string> library-summary-text: "0 tracked artists · 0 local albums";
    in property <string> status-banner-text: "Ready";
    in property <bool> status-is-warning: false;

    // Background worker telemetry
    in property <bool> is-busy: false;
    in property <bool> progress-indeterminate: false;
    in property <float> progress-fraction: 0.0;
    in property <string> busy-label: "";

    // -------------------------------------------------------------------------
    // In-App 30s Audio Preview Player State
    // -------------------------------------------------------------------------
    in property <bool> preview-active: false;
    in property <bool> preview-playing: false;
    in property <bool> preview-buffering: false;
    in property <int> preview-release-id: 0;
    in property <int> preview-disc-number: 0;
    in property <int> preview-track-number: 0;
    in property <string> preview-track-title: "";
    in property <string> preview-artist-name: "";
    in property <string> preview-release-title: "";
    in property <image> preview-cover;
    in property <bool> preview-has-cover: false;
    in property <string> preview-monogram: "♪";
    in property <int> preview-accent-hue: 0;
    in property <float> preview-progress: 0.0;
    in property <string> preview-elapsed-label: "0:00";
    in property <string> preview-duration-label: "0:30";
    in property <float> preview-level: 0.0;
    in-out property <int> preview-volume-pct: 80;

    // -------------------------------------------------------------------------
    // Unified Release Radar Feed State
    // -------------------------------------------------------------------------
    in property <[ReleaseCardData]> releases: [];
    in-out property <string> feed-search-text: "";
    in-out property <int> feed-status-index: 0;     // 0 All, 1 Unread, 2 Upcoming
    in-out property <int> feed-type-index: 0;       // 0 All Types, 1 Albums, 2 EPs, 3 Singles
    in-out property <int> feed-sort-index: 0;       // 0 Newest, 1 Upcoming, 2 Artist A-Z
    in-out property <bool> feed-hide-owned: true;
    in property <int> filtered-artist-id: 0;
    in property <string> filtered-artist-name: "";
    in property <string> filtered-artist-status: "tracked";

    // Unified Right Inspector Mode: 0 = Closed, 1 = Release Details, 2 = Artist Details
    in-out property <int> inspector-mode: 0;

    // Selected Release Inspector State
    in property <int> selected-release-id: 0;
    in property <ReleaseCardData> selected-release;
    in property <string> selected-release-artist-status: "tracked";
    in property <[TrackRowData]> selected-release-tracks: [];
    in property <bool> loading-tracks: false;

    // -------------------------------------------------------------------------
    // Tracked Artists State
    // -------------------------------------------------------------------------
    in property <[ArtistRowData]> artists: [];
    in-out property <string> artist-search-text: "";
    in-out property <int> artist-filter-index: 0;   // 0 All, 1 Tracked, 2 Muted, 3 Ignored, 4 Manual
    in-out property <bool> show-add-artist-bar: false;
    in-out property <string> manual-artist-query: "";
    in property <[SearchCandidateRowData]> artist-search-candidates: [];
    in property <bool> searching-external-artists: false;

    // Selected Artist Detail State
    in property <int> selected-artist-id: 0;
    in property <ArtistRowData> selected-artist;
    in property <[LocalAlbumRowData]> selected-artist-local-albums: [];
    in-out property <string> edit-artist-mbid: "";
    in-out property <string> edit-artist-deezer-id: "";

    // -------------------------------------------------------------------------
    // Library & Settings State
    // -------------------------------------------------------------------------
    in property <[FolderRowData]> library-folders: [];
    in-out property <string> new-folder-path: "";

    in-out property <bool> pref-dark-mode: true;
    in-out property <int> pref-accent-preset: 0;    // 0..5
    in-out property <int> pref-grid-density: 1;     // 0=Compact, 1=Comfortable, 2=Spacious
    in-out property <int> pref-ui-scale-pct: 100;   // 90, 100, 115, 125, 150, 175, 200
    in-out property <int> pref-discovery-mode: 0;   // 0=AlbumArtist+Folder, 1=FolderOnly, 2=AllTags+Folder
    in-out property <bool> pref-split-collaborations: true;
    in-out property <bool> pref-include-albums: true;
    in-out property <bool> pref-include-eps: true;
    in-out property <bool> pref-include-singles: true;
    in-out property <bool> pref-hide-owned: true;
    in-out property <bool> pref-hide-noise: true;
    in-out property <bool> pref-include-compilations: false;
    in-out property <int> pref-lookback-index: 2;   // 0=90d, 1=180d, 2=1y, 3=2y, 4=All
    in-out property <int> pref-provider-index: 0;   // 0=Deezer+MB, 1=Deezer, 2=MB
    in-out property <int> pref-schedule-index: 2;   // 0=Manual, 1=6h, 2=12h, 3=24h

    // -------------------------------------------------------------------------
    // Callbacks to Rust Controller
    // -------------------------------------------------------------------------
    callback navigate(int);
    callback scan-library();
    callback check-all-releases();
    callback cancel-background-task();

    // Audio Preview callbacks
    callback play-track-preview(int, int, int);     // (release_id, disc_number, track_number)
    callback toggle-preview-pause();
    callback seek-preview(float);
    callback set-preview-volume(int);
    callback stop-preview();

    // Feed & Inspector callbacks
    callback feed-filters-changed();
    callback clear-artist-feed-filter();
    callback select-release(int);
    callback close-inspector();
    callback toggle-release-seen(int);
    callback dismiss-release(int);
    callback mark-all-seen();
    callback open-external-url(string);
    callback inspect-artist(int);

    // Artists callbacks
    callback artist-filters-changed();
    callback select-artist(int);
    callback check-single-artist(int);
    callback view-artist-releases(int);
    callback toggle-artist-mute(int);
    callback toggle-artist-ignore(int);
    callback delete-artist(int);
    callback save-artist-provider-ids(int, string, string);
    callback search-external-artist(string);
    callback add-artist-by-name(string);
    callback add-search-candidate(int);

    // Settings & Folders callbacks
    callback browse-for-folder();
    callback add-folder-path(string);
    callback remove-folder(int);
    callback preferences-changed();
    callback scan-preferences-changed();
    callback theme-toggled(bool);
    callback ui-scale-changed(int);

    public function apply-theme(dark: bool, accent: int) {
        root.pref-dark-mode = dark;
        root.pref-accent-preset = accent;
        Theme.dark-mode = dark;
        Theme.accent-preset = accent;
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    // -------------------------------------------------------------------------
    // Keyboard Shortcuts
    // -------------------------------------------------------------------------
    forward-focus: key-scope;

    key-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.inspector-mode != 0) {
                    root.close-inspector();
                    return accept;
                }
                if (root.show-add-artist-bar) {
                    root.show-add-artist-bar = false;
                    return accept;
                }
            }
            if (event.text == " " && root.preview-active) {
                root.toggle-preview-pause();
                return accept;
            }
            if (event.modifiers.control && (event.text == "r" || event.text == "R")) {
                if (!root.is-busy) {
                    root.check-all-releases();
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "=" || event.text == "+")) {
                root.ui-scale-changed(min(200, root.pref-ui-scale-pct + 15));
                return accept;
            }
            if (event.modifiers.control && event.text == "-") {
                root.ui-scale-changed(max(90, root.pref-ui-scale-pct - 15));
                return accept;
            }
            if (event.modifiers.control && event.text == "0") {
                root.ui-scale-changed(100);
                return accept;
            }
            if (event.text == "/" && root.active-view == 0) {
                feed-search-input.focus-input();
                return accept;
            }
            if (event.text == "/" && root.active-view == 1) {
                artist-search-input.focus-input();
                return accept;
            }
            reject
        }

        HorizontalLayout {
            width: 100%;
            height: 100%;

            // =====================================================================
            // LEFT MATERIAL 3 NAVIGATION RAIL (3 Unified Destinations)
            // =====================================================================
            Rectangle {
                width: 224px;
                horizontal-stretch: 0;
                background: Theme.surface-rail;

                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    // Brand Header with Dynamic SVG Radar Logo
                    HorizontalLayout {
                        padding-left: 4px;
                        padding-top: 2px;
                        padding-bottom: 6px;
                        spacing: 11px;

                        MissNixLogo {
                            y: (parent.height - self.height) / 2;
                            scanning: root.is-busy;
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: "MissNix";
                                font-size: 17px;
                                font-weight: 800;
                                color: Theme.on-surface;
                            }
                            Text {
                                text: "Release Radar";
                                font-size: 11px;
                                color: Theme.on-surface-muted;
                            }
                        }
                    }

                    // Primary Navigation Destinations with Animated Sliding Pill
                    Rectangle {
                        height: 3 * 42px + 2 * 4px;
                        vertical-stretch: 0;

                        Rectangle {
                            x: 2px;
                            y: root.active-view * 46px + 11px;
                            width: 3px;
                            height: 20px;
                            border-radius: 1.5px;
                            background: Theme.primary;

                            animate y { duration: 190ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
                        }

                        VerticalLayout {
                            spacing: 4px;

                            NavRailItem {
                                icon: @image-url("../assets/icons/radar.svg");
                                label: "Release Radar";
                                badge-count: root.unseen-badge-count;
                                active: root.active-view == 0;
                                clicked => { root.navigate(0); }
                            }

                            NavRailItem {
                                icon: @image-url("../assets/icons/artists.svg");
                                label: "Tracked Artists";
                                active: root.active-view == 1;
                                clicked => { root.navigate(1); }
                            }

                            NavRailItem {
                                icon: @image-url("../assets/icons/settings.svg");
                                label: "Library & Settings";
                                active: root.active-view == 2;
                                clicked => { root.navigate(2); }
                            }
                        }
                    }

                    // Spacer pushes sync actions & telemetry cleanly to bottom
                    Rectangle { vertical-stretch: 1; }

                    // Bounded Primary Sync & Scan Actions
                    VerticalLayout {
                        spacing: 8px;
                        vertical-stretch: 0;

                        M3Button {
                            fill-width: true;
                            variant: "filled";
                            has-icon: true;
                            icon: @image-url("../assets/icons/refresh.svg");
                            text: "Check Releases";
                            enabled: !root.is-busy;
                            clicked => { root.check-all-releases(); }
                        }

                        M3Button {
                            fill-width: true;
                            variant: "tonal";
                            has-icon: true;
                            icon: @image-url("../assets/icons/folder.svg");
                            text: "Scan Music Folders";
                            enabled: !root.is-busy;
                            clicked => { root.scan-library(); }
                        }
                    }

                    // Non-blocking Background Status & Telemetry Card
                    Rectangle {
                        vertical-stretch: 0;
                        border-radius: 12px;
                        background: Theme.surface-container;
                        border-width: 1px;
                        border-color: root.status-is-warning
                            ? Theme.error.with-alpha(0.55)
                            : Theme.outline-variant;

                        VerticalLayout {
                            padding: 11px;
                            spacing: 8px;
                            alignment: start;

                            if root.is-busy : VerticalLayout {
                                spacing: 8px;
                                alignment: start;

                                HorizontalLayout {
                                    spacing: 8px;
                                    Spinner {
                                        width: 16px;
                                        height: 16px;
                                        y: (parent.height - self.height) / 2;
                                        indeterminate: true;
                                    }
                                    Text {
                                        text: root.busy-label;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Theme.on-surface;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                }

                                ProgressIndicator {
                                    height: 5px;
                                    indeterminate: root.progress-indeterminate;
                                    progress: root.progress-fraction;
                                }

                                M3Button {
                                    fill-width: true;
                                    compact: true;
                                    variant: "outlined";
                                    text: "Cancel";
                                    clicked => { root.cancel-background-task(); }
                                }
                            }

                            if !root.is-busy : VerticalLayout {
                                spacing: 3px;
                                alignment: start;

                                Text {
                                    text: root.library-summary-text;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Theme.on-surface;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.status-banner-text;
                                    font-size: 11px;
                                    color: root.status-is-warning
                                        ? Theme.error
                                        : Theme.on-surface-muted;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: 100%;
                    background: Theme.outline-variant;
                }
            }

            // =====================================================================
            // CENTER WORKSPACE + DOCKED BOTTOM PREVIEW MINI-PLAYER
            // =====================================================================
            VerticalLayout {
                horizontal-stretch: 1;
                height: 100%;

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface;
                    clip: true;

                    // -------------------------------------------------------------
                    // VIEW 0: UNIFIED RELEASE RADAR
                    // -------------------------------------------------------------
                    VerticalLayout {
                        visible: root.active-view == 0;
                        width: 100%;
                        height: 100%;

                        // Top Desktop Filter Bar
                        Rectangle {
                            vertical-stretch: 0;
                            background: Theme.surface;

                            VerticalLayout {
                                padding-left: 20px;
                                padding-right: 20px;
                                padding-top: 14px;
                                padding-bottom: 12px;
                                spacing: 11px;
                                alignment: start;

                                HorizontalLayout {
                                    spacing: 10px;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: "Release Radar";
                                            font-size: 21px;
                                            font-weight: 800;
                                            color: Theme.on-surface;
                                        }
                                        Text {
                                            text: "New, upcoming, and catalog releases across your tracked artists";
                                            font-size: 12px;
                                            color: Theme.on-surface-variant;
                                        }
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    if root.filtered-artist-id > 0 : HorizontalLayout {
                                        spacing: 6px;

                                        TonalBadge {
                                            y: (parent.height - self.height) / 2;
                                            label: "ARTIST: \{root.filtered-artist-name}";
                                            badge-bg: Theme.primary-container;
                                            badge-fg: Theme.on-primary-container;
                                        }

                                        M3Button {
                                            y: (parent.height - self.height) / 2;
                                            compact: true;
                                            variant: root.filtered-artist-status == "muted" ? "primary-tonal" : "outlined";
                                            has-icon: true;
                                            icon: root.filtered-artist-status == "muted"
                                                ? @image-url("../assets/icons/volume-on.svg")
                                                : @image-url("../assets/icons/volume-off.svg");
                                            text: root.filtered-artist-status == "muted" ? "Unmute" : "Mute";
                                            clicked => { root.toggle-artist-mute(root.filtered-artist-id); }
                                        }

                                        M3Button {
                                            y: (parent.height - self.height) / 2;
                                            compact: true;
                                            variant: root.filtered-artist-status == "ignored" ? "primary-tonal" : "danger";
                                            has-icon: true;
                                            icon: @image-url("../assets/icons/eye-off.svg");
                                            text: root.filtered-artist-status == "ignored" ? "Restore" : "Hide";
                                            clicked => { root.toggle-artist-ignore(root.filtered-artist-id); }
                                        }

                                        M3Button {
                                            y: (parent.height - self.height) / 2;
                                            compact: true;
                                            variant: "outlined";
                                            has-icon: true;
                                            icon: @image-url("../assets/icons/close.svg");
                                            text: "Clear";
                                            clicked => { root.clear-artist-feed-filter(); }
                                        }
                                    }

                                    Switch {
                                        text: "Hide owned";
                                        checked <=> root.feed-hide-owned;
                                        toggled => { root.feed-filters-changed(); }
                                    }

                                    M3Button {
                                        y: (parent.height - self.height) / 2;
                                        variant: "primary-tonal";
                                        has-icon: true;
                                        icon: @image-url("../assets/icons/done-all.svg");
                                        text: "Mark All Seen";
                                        enabled: root.unseen-badge-count > 0;
                                        clicked => { root.mark-all-seen(); }
                                    }
                                }

                                // Unified Filter Row (Search + Status Chips + Type Chips + Sort)
                                HorizontalLayout {
                                    spacing: 8px;

                                    feed-search-input := M3SearchField {
                                        min-width: 170px;
                                        max-width: 290px;
                                        horizontal-stretch: 1;
                                        text <=> root.feed-search-text;
                                        placeholder: "Search artist or release...  (/)";
                                        edited => { root.feed-filters-changed(); }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 0;

                                        HorizontalLayout {
                                            spacing: 5px;
                                            height: 32px;

                                            M3FilterChip {
                                                label: "All";
                                                selected: root.feed-status-index == 0;
                                                clicked => {
                                                    root.feed-status-index = 0;
                                                    root.feed-filters-changed();
                                                }
                                            }
                                            M3FilterChip {
                                                label: root.unseen-badge-count > 0
                                                    ? "Unread (\{root.unseen-badge-count})"
                                                    : "Unread";
                                                selected: root.feed-status-index == 1;
                                                clicked => {
                                                    root.feed-status-index = 1;
                                                    root.feed-filters-changed();
                                                }
                                            }
                                            M3FilterChip {
                                                label: "Upcoming";
                                                selected: root.feed-status-index == 2;
                                                clicked => {
                                                    root.feed-status-index = 2;
                                                    root.feed-filters-changed();
                                                }
                                            }

                                            Rectangle {
                                                width: 1px;
                                                height: 20px;
                                                y: 6px;
                                                background: Theme.outline-variant;
                                            }

                                            M3FilterChip {
                                                label: "All Types";
                                                selected: root.feed-type-index == 0;
                                                clicked => {
                                                    root.feed-type-index = 0;
                                                    root.feed-filters-changed();
                                                }
                                            }
                                            M3FilterChip {
                                                label: "Albums";
                                                selected: root.feed-type-index == 1;
                                                clicked => {
                                                    root.feed-type-index = 1;
                                                    root.feed-filters-changed();
                                                }
                                            }
                                            M3FilterChip {
                                                label: "EPs";
                                                selected: root.feed-type-index == 2;
                                                clicked => {
                                                    root.feed-type-index = 2;
                                                    root.feed-filters-changed();
                                                }
                                            }
                                            M3FilterChip {
                                                label: "Singles";
                                                selected: root.feed-type-index == 3;
                                                clicked => {
                                                    root.feed-type-index = 3;
                                                    root.feed-filters-changed();
                                                }
                                            }
                                        }
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    ComboBox {
                                        width: 158px;
                                        height: 34px;
                                        y: (parent.height - self.height) / 2;
                                        model: ["Newest First", "Upcoming First", "Artist A–Z"];
                                        current-index <=> root.feed-sort-index;
                                        selected => { root.feed-filters-changed(); }
                                    }
                                }
                            }

                            Rectangle {
                                y: parent.height - 1px;
                                width: 100%;
                                height: 1px;
                                background: Theme.outline-variant;
                            }
                        }

                        // Empty State when no releases match
                        if root.releases.length == 0 : VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;

                            HorizontalLayout {
                                alignment: center;
                                padding-left: 24px;
                                padding-right: 24px;

                                Rectangle {
                                    max-width: 460px;
                                    horizontal-stretch: 1;
                                    height: 244px;
                                    border-radius: 18px;
                                    background: Theme.surface-container;
                                    border-width: 1px;
                                    border-color: Theme.outline-variant;

                                    VerticalLayout {
                                        padding: 28px;
                                        spacing: 12px;
                                        alignment: center;

                                        HorizontalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 44px;
                                                height: 44px;
                                                border-radius: 22px;
                                                background: Theme.primary-container;

                                                Image {
                                                    width: 22px;
                                                    height: 22px;
                                                    x: 11px;
                                                    y: 11px;
                                                    source: @image-url("../assets/icons/sparkles.svg");
                                                    colorize: Theme.primary;
                                                }
                                            }
                                        }

                                        Text {
                                            text: root.library-folders.length == 0
                                                ? "Add one or more local music folders to automatically discover your artists and track new albums, EPs, and singles."
                                                : "No releases match your active filters. Run a release check or broaden your status, type, or lookback filters.";
                                            font-size: 12px;
                                            color: Theme.on-surface-variant;
                                            horizontal-alignment: center;
                                            wrap: word-wrap;
                                        }

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 10px;

                                            if root.library-folders.length == 0 : M3Button {
                                                variant: "filled";
                                                has-icon: true;
                                                icon: @image-url("../assets/icons/folder-plus.svg");
                                                text: "Add Music Folder";
                                                clicked => { root.navigate(2); }
                                            }

                                            if root.library-folders.length > 0 : M3Button {
                                                variant: "filled";
                                                has-icon: true;
                                                icon: @image-url("../assets/icons/refresh.svg");
                                                text: "Check Releases Now";
                                                enabled: !root.is-busy;
                                                clicked => { root.check-all-releases(); }
                                            }

                                            if root.library-folders.length > 0 && (root.feed-status-index != 0 || root.feed-type-index != 0 || root.feed-search-text != "") : M3Button {
                                                variant: "tonal";
                                                text: "Reset Filters";
                                                clicked => {
                                                    root.feed-status-index = 0;
                                                    root.feed-type-index = 0;
                                                    root.feed-search-text = "";
                                                    root.feed-filters-changed();
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Smooth Viewport-Culled Multi-Column Cover Grid (Zero Resize Jitter)
                        if root.releases.length > 0 : feed-scroll := ScrollView {
                            vertical-stretch: 1;

                            property <length> target-cell: root.pref-grid-density == 0 ? 170px
                                                         : root.pref-grid-density == 2 ? 236px
                                                         : 200px;
                            property <length> gap: 14px;
                            property <length> pad: 20px;
                            property <length> avail-w: max(320px, self.visible-width - 2 * self.pad);
                            property <int> cols: max(2, min(10, Math.floor((self.avail-w + self.gap) / (self.target-cell + self.gap))));
                            property <length> card-w: (self.avail-w - (self.cols - 1) * self.gap) / self.cols;
                            property <length> card-h: self.card-w + 76px;
                            property <int> total-rows: Math.ceil(root.releases.length / self.cols);
                            property <length> scroll-top: -self.viewport-y;

                            content-width: self.visible-width;
                            content-height: max(self.visible-height, self.pad * 2 + self.total-rows * self.card-h + max(0, self.total-rows - 1) * self.gap);

                            for item[idx] in root.releases : Rectangle {
                                property <int> row-idx: Math.floor(idx / feed-scroll.cols);
                                property <int> col-idx: Math.mod(idx, feed-scroll.cols);
                                property <length> item-y: feed-scroll.pad + self.row-idx * (feed-scroll.card-h + feed-scroll.gap);
                                property <bool> in-viewport:
                                    (self.item-y + feed-scroll.card-h >= feed-scroll.scroll-top - feed-scroll.card-h)
                                    && (self.item-y <= feed-scroll.scroll-top + feed-scroll.visible-height + feed-scroll.card-h);

                                x: feed-scroll.pad + self.col-idx * (feed-scroll.card-w + feed-scroll.gap);
                                y: self.item-y;
                                width: feed-scroll.card-w;
                                height: feed-scroll.card-h;

                                if self.in-viewport : ReleaseCard {
                                    width: 100%;
                                    height: 100%;
                                    data: item;
                                    selected: root.inspector-mode == 1 && root.selected-release-id == item.id;
                                    playing-this-release: root.preview-active && root.preview-playing && root.preview-release-id == item.id;

                                    select-release(id) => { root.select-release(id); }
                                    toggle-seen(id) => { root.toggle-release-seen(id); }
                                    dismiss-release(id) => { root.dismiss-release(id); }
                                    open-artist(aid) => { root.inspect-artist(aid); }
                                }
                            }
                        }
                    }

                    // -------------------------------------------------------------
                    // VIEW 1: TRACKED ARTISTS (BALANCED CENTERED LIST)
                    // -------------------------------------------------------------
                    HorizontalLayout {
                        visible: root.active-view == 1;
                        width: 100%;
                        height: 100%;
                        alignment: center;

                        VerticalLayout {
                            max-width: 1040px;
                            horizontal-stretch: 1;
                            height: 100%;
                            padding-left: 20px;
                            padding-right: 20px;
                            padding-top: 16px;
                            padding-bottom: 14px;
                            spacing: 12px;

                            HorizontalLayout {
                                spacing: 12px;
                                vertical-stretch: 0;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: "Tracked Artists";
                                        font-size: 21px;
                                        font-weight: 800;
                                        color: Theme.on-surface;
                                    }
                                    Text {
                                        text: "Primary artists discovered from your library — click any artist to inspect, mute, hide, or override IDs";
                                        font-size: 12px;
                                        color: Theme.on-surface-variant;
                                    }
                                }

                                Rectangle { horizontal-stretch: 1; }

                                M3Button {
                                    y: (parent.height - self.height) / 2;
                                    variant: root.show-add-artist-bar ? "outlined" : "filled";
                                    has-icon: true;
                                    icon: root.show-add-artist-bar
                                        ? @image-url("../assets/icons/close.svg")
                                        : @image-url("../assets/icons/plus.svg");
                                    text: root.show-add-artist-bar ? "Close" : "Add Artist";
                                    clicked => {
                                        root.show-add-artist-bar = !root.show-add-artist-bar;
                                    }
                                }
                            }

                            // Collapsible Manual Artist Search & Add Card
                            if root.show-add-artist-bar : Rectangle {
                                vertical-stretch: 0;
                                border-radius: 14px;
                                background: Theme.surface-container;
                                border-width: 1px;
                                border-color: Theme.primary.with-alpha(0.45);

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 10px;
                                    alignment: start;

                                    HorizontalLayout {
                                        spacing: 10px;

                                        M3SearchField {
                                            horizontal-stretch: 1;
                                            text <=> root.manual-artist-query;
                                            placeholder: "Search Deezer & MusicBrainz for an artist to track...";
                                            accepted(val) => { root.search-external-artist(val); }
                                        }

                                        M3Button {
                                            y: (parent.height - self.height) / 2;
                                            variant: "filled";
                                            text: "Search Online";
                                            enabled: root.manual-artist-query != "" && !root.searching-external-artists;
                                            clicked => { root.search-external-artist(root.manual-artist-query); }
                                        }

                                        M3Button {
                                            y: (parent.height - self.height) / 2;
                                            variant: "tonal";
                                            text: "Add by Name";
                                            enabled: root.manual-artist-query != "";
                                            clicked => { root.add-artist-by-name(root.manual-artist-query); }
                                        }
                                    }

                                    if root.searching-external-artists : HorizontalLayout {
                                        spacing: 8px;
                                        Spinner { width: 16px; height: 16px; indeterminate: true; }
                                        Text {
                                            text: "Searching Deezer & MusicBrainz...";
                                            font-size: 12px;
                                            color: Theme.on-surface-variant;
                                            vertical-alignment: center;
                                        }
                                    }

                                    if root.artist-search-candidates.length > 0 : VerticalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        for cand in root.artist-search-candidates : SearchCandidateRow {
                                            candidate: cand;
                                            add-candidate(idx) => { root.add-search-candidate(idx); }
                                        }
                                    }
                                }
                            }

                            // Artist Search & Material 3 Filter Chips
                            HorizontalLayout {
                                spacing: 10px;
                                vertical-stretch: 0;

                                artist-search-input := M3SearchField {
                                    min-width: 190px;
                                    max-width: 340px;
                                    horizontal-stretch: 1;
                                    text <=> root.artist-search-text;
                                    placeholder: "Filter artists by name...  (/)";
                                    edited => { root.artist-filters-changed(); }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        height: 32px;

                                        M3FilterChip {
                                            label: "All";
                                            selected: root.artist-filter-index == 0;
                                            clicked => {
                                                root.artist-filter-index = 0;
                                                root.artist-filters-changed();
                                            }
                                        }
                                        M3FilterChip {
                                            label: "Tracked";
                                            selected: root.artist-filter-index == 1;
                                            clicked => {
                                                root.artist-filter-index = 1;
                                                root.artist-filters-changed();
                                            }
                                        }
                                        M3FilterChip {
                                            label: "Muted";
                                            selected: root.artist-filter-index == 2;
                                            clicked => {
                                                root.artist-filter-index = 2;
                                                root.artist-filters-changed();
                                            }
                                        }
                                        M3FilterChip {
                                            label: "Ignored";
                                            selected: root.artist-filter-index == 3;
                                            clicked => {
                                                root.artist-filter-index = 3;
                                                root.artist-filters-changed();
                                            }
                                        }
                                        M3FilterChip {
                                            label: "Manual";
                                            selected: root.artist-filter-index == 4;
                                            clicked => {
                                                root.artist-filter-index = 4;
                                                root.artist-filters-changed();
                                            }
                                        }
                                    }
                                }

                                Rectangle { horizontal-stretch: 1; }
                            }

                            if root.artists.length == 0 : Rectangle {
                                vertical-stretch: 1;
                                Text {
                                    text: "No matching artists found. Scan your music folders or click 'Add Artist' above.";
                                    font-size: 13px;
                                    color: Theme.on-surface-muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            if root.artists.length > 0 : ListView {
                                vertical-stretch: 1;
                                for art in root.artists : VerticalLayout {
                                    padding-bottom: 6px;
                                    ArtistListRow {
                                        artist: art;
                                        selected: root.inspector-mode == 2 && root.selected-artist-id == art.id;
                                        select-artist(id) => {
                                            root.select-artist(
                                                (root.inspector-mode == 2 && root.selected-artist-id == id) ? 0 : id
                                            );
                                        }
                                        view-drops(id) => { root.view-artist-releases(id); }
                                        toggle-mute(id) => { root.toggle-artist-mute(id); }
                                        toggle-ignore(id) => { root.toggle-artist-ignore(id); }
                                    }
                                }
                            }
                        }
                    }

                    // -------------------------------------------------------------
                    // VIEW 2: LIBRARY & CUSTOMIZATION SETTINGS
                    // -------------------------------------------------------------
                    if root.active-view == 2 : settings-scroll := ScrollView {
                        width: 100%;
                        height: 100%;

                        HorizontalLayout {
                            width: settings-scroll.visible-width;
                            padding-top: 22px;
                            padding-bottom: 28px;
                            padding-left: 22px;
                            padding-right: 22px;
                            alignment: center;

                            VerticalLayout {
                                max-width: 900px;
                                horizontal-stretch: 1;
                                spacing: 16px;
                                alignment: start;

                                VerticalLayout {
                                    spacing: 2px;
                                    alignment: start;
                                    Text {
                                        text: "Library & Preferences";
                                        font-size: 21px;
                                        font-weight: 800;
                                        color: Theme.on-surface;
                                    }
                                    Text {
                                        text: "Customize Material 3 appearance, HiDPI interface scaling, artist discovery rules, and release sources";
                                        font-size: 12px;
                                        color: Theme.on-surface-variant;
                                    }
                                }

                                // Card 1: Appearance, HiDPI Scaling & Desktop Layout
                                SectionCard {
                                    title: "Appearance, HiDPI Scaling & Layout";
                                    subtitle: "Personalize MissNix's Material 3 accent palette, dark/light surface scheme, UI scale factor, and cover-art grid density.";

                                    Switch {
                                        text: "Dark Material 3 Surface Theme";
                                        checked <=> root.pref-dark-mode;
                                        toggled => {
                                            root.apply-theme(root.pref-dark-mode, root.pref-accent-preset);
                                            root.theme-toggled(root.pref-dark-mode);
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 8px;
                                        alignment: start;

                                        Text {
                                            text: "Accent Color Palette";
                                            font-size: 12.5px;
                                            font-weight: 600;
                                            color: Theme.on-surface;
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;

                                            AccentSwatch {
                                                swatch-color: #d0bcff;
                                                label: "Iris";
                                                selected: root.pref-accent-preset == 0;
                                                clicked => {
                                                    root.apply-theme(root.pref-dark-mode, 0);
                                                    root.preferences-changed();
                                                }
                                            }
                                            AccentSwatch {
                                                swatch-color: #7dd3fc;
                                                label: "Frost";
                                                selected: root.pref-accent-preset == 1;
                                                clicked => {
                                                    root.apply-theme(root.pref-dark-mode, 1);
                                                    root.preferences-changed();
                                                }
                                            }
                                            AccentSwatch {
                                                swatch-color: #6ee7b7;
                                                label: "Emerald";
                                                selected: root.pref-accent-preset == 2;
                                                clicked => {
                                                    root.apply-theme(root.pref-dark-mode, 2);
                                                    root.preferences-changed();
                                                }
                                            }
                                            AccentSwatch {
                                                swatch-color: #fcd34d;
                                                label: "Amber";
                                                selected: root.pref-accent-preset == 3;
                                                clicked => {
                                                    root.apply-theme(root.pref-dark-mode, 3);
                                                    root.preferences-changed();
                                                }
                                            }
                                            AccentSwatch {
                                                swatch-color: #fda4af;
                                                label: "Coral";
                                                selected: root.pref-accent-preset == 4;
                                                clicked => {
                                                    root.apply-theme(root.pref-dark-mode, 4);
                                                    root.preferences-changed();
                                                }
                                            }
                                            AccentSwatch {
                                                swatch-color: #fdba74;
                                                label: "Copper";
                                                selected: root.pref-accent-preset == 5;
                                                clicked => {
                                                    root.apply-theme(root.pref-dark-mode, 5);
                                                    root.preferences-changed();
                                                }
                                            }
                                        }
                                    }

                                    // HiDPI UI Scaling Selector
                                    VerticalLayout {
                                        spacing: 6px;
                                        alignment: start;

                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;

                                            Text {
                                                text: "Interface Scale (HiDPI):";
                                                font-size: 12.5px;
                                                font-weight: 600;
                                                color: Theme.on-surface;
                                                vertical-alignment: center;
                                                width: 190px;
                                            }

                                            M3FilterChip {
                                                label: "90%";
                                                selected: root.pref-ui-scale-pct == 90;
                                                clicked => { root.ui-scale-changed(90); }
                                            }
                                            M3FilterChip {
                                                label: "100%";
                                                selected: root.pref-ui-scale-pct == 100;
                                                clicked => { root.ui-scale-changed(100); }
                                            }
                                            M3FilterChip {
                                                label: "115%";
                                                selected: root.pref-ui-scale-pct == 115;
                                                clicked => { root.ui-scale-changed(115); }
                                            }
                                            M3FilterChip {
                                                label: "125%";
                                                selected: root.pref-ui-scale-pct == 125;
                                                clicked => { root.ui-scale-changed(125); }
                                            }
                                            M3FilterChip {
                                                label: "150%";
                                                selected: root.pref-ui-scale-pct == 150;
                                                clicked => { root.ui-scale-changed(150); }
                                            }
                                            M3FilterChip {
                                                label: "175%";
                                                selected: root.pref-ui-scale-pct == 175;
                                                clicked => { root.ui-scale-changed(175); }
                                            }
                                            M3FilterChip {
                                                label: "200%";
                                                selected: root.pref-ui-scale-pct == 200;
                                                clicked => { root.ui-scale-changed(200); }
                                            }
                                        }

                                        Text {
                                            text: "Active scale: \{root.pref-ui-scale-pct}%  ·  Shortcuts: Ctrl + / Ctrl - / Ctrl 0 (ideal for high-DPI monitors without compositor scaling)";
                                            font-size: 11px;
                                            color: Theme.on-surface-muted;
                                            wrap: word-wrap;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;

                                        Text {
                                            text: "Release Cover Grid Size:";
                                            font-size: 12.5px;
                                            font-weight: 600;
                                            color: Theme.on-surface;
                                            vertical-alignment: center;
                                            width: 190px;
                                        }

                                        M3FilterChip {
                                            label: "Compact";
                                            selected: root.pref-grid-density == 0;
                                            clicked => {
                                                root.pref-grid-density = 0;
                                                root.preferences-changed();
                                            }
                                        }
                                        M3FilterChip {
                                            label: "Comfortable";
                                            selected: root.pref-grid-density == 1;
                                            clicked => {
                                                root.pref-grid-density = 1;
                                                root.preferences-changed();
                                            }
                                        }
                                        M3FilterChip {
                                            label: "Spacious";
                                            selected: root.pref-grid-density == 2;
                                            clicked => {
                                                root.pref-grid-density = 2;
                                                root.preferences-changed();
                                            }
                                        }
                                    }
                                }

                                // Card 2: Local Music Folders & Artist Discovery Mode
                                SectionCard {
                                    title: "Local Music Folders & Artist Discovery";
                                    subtitle: "Configure your music directories and choose how MissNix extracts artist identity from ALBUMARTIST tags, folder names, and collaboration credits.";

                                    HorizontalLayout {
                                        spacing: 10px;

                                        M3LabeledInput {
                                            horizontal-stretch: 1;
                                            placeholder: "Enter music directory path (e.g. ~/Music) or click Browse...";
                                            text <=> root.new-folder-path;
                                            accepted(val) => { root.add-folder-path(val); }
                                        }

                                        M3Button {
                                            y: (parent.height - self.height) / 2;
                                            variant: "primary-tonal";
                                            has-icon: true;
                                            icon: @image-url("../assets/icons/plus.svg");
                                            text: "Add Path";
                                            enabled: root.new-folder-path != "";
                                            clicked => { root.add-folder-path(root.new-folder-path); }
                                        }

                                        M3Button {
                                            y: (parent.height - self.height) / 2;
                                            variant: "outlined";
                                            has-icon: true;
                                            icon: @image-url("../assets/icons/folder-plus.svg");
                                            text: "Browse...";
                                            clicked => { root.browse-for-folder(); }
                                        }
                                    }

                                    if root.library-folders.length == 0 : Text {
                                        text: "No music folders added yet.";
                                        font-size: 12px;
                                        color: Theme.on-surface-muted;
                                    }

                                    for folder in root.library-folders : FolderItemRow {
                                        folder: folder;
                                        remove-folder(id) => { root.remove-folder(id); }
                                    }

                                    Rectangle {
                                        height: 1px;
                                        background: Theme.outline-variant;
                                    }

                                    VerticalLayout {
                                        spacing: 8px;
                                        alignment: start;

                                        Text {
                                            text: "Artist Discovery Source";
                                            font-size: 13px;
                                            font-weight: 700;
                                            color: Theme.on-surface;
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;

                                            M3FilterChip {
                                                label: "Album Artist + Folder (Recommended)";
                                                selected: root.pref-discovery-mode == 0;
                                                clicked => {
                                                    root.pref-discovery-mode = 0;
                                                    root.scan-preferences-changed();
                                                }
                                            }
                                            M3FilterChip {
                                                label: "Folder Structure Only";
                                                selected: root.pref-discovery-mode == 1;
                                                clicked => {
                                                    root.pref-discovery-mode = 1;
                                                    root.scan-preferences-changed();
                                                }
                                            }
                                            M3FilterChip {
                                                label: "All Metadata Tags + Folder";
                                                selected: root.pref-discovery-mode == 2;
                                                clicked => {
                                                    root.pref-discovery-mode = 2;
                                                    root.scan-preferences-changed();
                                                }
                                            }
                                        }

                                        Text {
                                            text: root.pref-discovery-mode == 0
                                                ? "Uses ALBUMARTIST tags and structured <Artist>/<Album> folder names first so guest track credits never pollute your artist list."
                                                : root.pref-discovery-mode == 1
                                                    ? "Discovers artists strictly from <MusicRoot>/<Artist>/<Album> directory names, ignoring embedded artist tags."
                                                    : "Reads ALBUMARTIST and track ARTIST tags across all files, falling back to folder names.";
                                            font-size: 11.5px;
                                            color: Theme.on-surface-muted;
                                            wrap: word-wrap;
                                        }
                                    }

                                    Switch {
                                        text: "Clean multi-artist collaboration delimiters (';', '/', 'feat.', ', ') into primary artist";
                                        checked <=> root.pref-split-collaborations;
                                        toggled => { root.scan-preferences-changed(); }
                                    }

                                    Switch {
                                        text: "Include one-off track artists from 'Various Artists' soundtrack/compilation albums";
                                        checked <=> root.pref-include-compilations;
                                        toggled => { root.scan-preferences-changed(); }
                                    }

                                    HorizontalLayout {
                                        alignment: start;
                                        M3Button {
                                            variant: "filled";
                                            has-icon: true;
                                            icon: @image-url("../assets/icons/refresh.svg");
                                            text: "Rescan All Folders Now";
                                            enabled: !root.is-busy && root.library-folders.length > 0;
                                            clicked => { root.scan-library(); }
                                        }
                                    }
                                }

                                // Card 3: Release Filtering & Smart Deduplication
                                SectionCard {
                                    title: "Release Radar & Smart Deduplication";
                                    subtitle: "Control which release types appear in your feed and suppress albums already owned in your local library.";

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;

                                        Text {
                                            text: "Included Release Types:";
                                            font-size: 12.5px;
                                            font-weight: 600;
                                            color: Theme.on-surface;
                                            vertical-alignment: center;
                                            width: 190px;
                                        }

                                        M3FilterChip {
                                            label: "Albums";
                                            selected: root.pref-include-albums;
                                            clicked => {
                                                root.pref-include-albums = !root.pref-include-albums;
                                                root.preferences-changed();
                                            }
                                        }
                                        M3FilterChip {
                                            label: "EPs";
                                            selected: root.pref-include-eps;
                                            clicked => {
                                                root.pref-include-eps = !root.pref-include-eps;
                                                root.preferences-changed();
                                            }
                                        }
                                        M3FilterChip {
                                            label: "Singles";
                                            selected: root.pref-include-singles;
                                            clicked => {
                                                root.pref-include-singles = !root.pref-include-singles;
                                                root.preferences-changed();
                                            }
                                        }
                                    }

                                    Switch {
                                        text: "Smart Local Deduplication — hide releases already in your local music folders";
                                        checked <=> root.pref-hide-owned;
                                        toggled => { root.preferences-changed(); }
                                    }

                                    Switch {
                                        text: "Filter out greatest-hits compilations, live bootlegs & karaoke editions";
                                        checked <=> root.pref-hide-noise;
                                        toggled => { root.preferences-changed(); }
                                    }

                                    HorizontalLayout {
                                        spacing: 14px;
                                        alignment: start;
                                        Text {
                                            text: "Release lookback window:";
                                            font-size: 12.5px;
                                            font-weight: 600;
                                            color: Theme.on-surface;
                                            vertical-alignment: center;
                                            width: 190px;
                                        }
                                        ComboBox {
                                            width: 240px;
                                            height: 36px;
                                            model: [
                                                "Last 90 days",
                                                "Last 6 months",
                                                "Last 1 year",
                                                "Last 2 years",
                                                "All time"
                                            ];
                                            current-index <=> root.pref-lookback-index;
                                            selected => { root.preferences-changed(); }
                                        }
                                    }
                                }

                                // Card 4: Data Sources & Sync Schedule
                                SectionCard {
                                    title: "Metadata Providers & Automatic Schedule";
                                    subtitle: "Deezer provides artwork, tracklists, and in-app 30s audio previews; MusicBrainz provides exact MBID disambiguation and upcoming release dates.";

                                    HorizontalLayout {
                                        spacing: 14px;
                                        alignment: start;
                                        Text {
                                            text: "Release lookup sources:";
                                            font-size: 12.5px;
                                            font-weight: 600;
                                            color: Theme.on-surface;
                                            vertical-alignment: center;
                                            width: 190px;
                                        }
                                        ComboBox {
                                            width: 290px;
                                            height: 36px;
                                            model: [
                                                "Deezer + MusicBrainz (Recommended)",
                                                "Deezer Only",
                                                "MusicBrainz Only"
                                            ];
                                            current-index <=> root.pref-provider-index;
                                            selected => { root.preferences-changed(); }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 14px;
                                        alignment: start;
                                        Text {
                                            text: "Automatic check schedule:";
                                            font-size: 12.5px;
                                            font-weight: 600;
                                            color: Theme.on-surface;
                                            vertical-alignment: center;
                                            width: 190px;
                                        }
                                        ComboBox {
                                            width: 290px;
                                            height: 36px;
                                            model: [
                                                "Manual check only",
                                                "Every 6 hours",
                                                "Every 12 hours",
                                                "Every 24 hours"
                                            ];
                                            current-index <=> root.pref-schedule-index;
                                            selected => { root.preferences-changed(); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Docked In-App 30s Audio Preview Mini-Player
                PreviewMiniPlayer {
                    active: root.preview-active;
                    playing: root.preview-playing;
                    buffering: root.preview-buffering;
                    track-title: root.preview-track-title;
                    artist-name: root.preview-artist-name;
                    release-title: root.preview-release-title;
                    cover: root.preview-cover;
                    has-cover: root.preview-has-cover;
                    monogram: root.preview-monogram;
                    accent-hue: root.preview-accent-hue;
                    progress: root.preview-progress;
                    elapsed-label: root.preview-elapsed-label;
                    duration-label: root.preview-duration-label;
                    level: root.preview-level;
                    volume-pct: root.preview-volume-pct;

                    toggle-pause => { root.toggle-preview-pause(); }
                    seek(frac) => { root.seek-preview(frac); }
                    volume-changed(pct) => {
                        root.preview-volume-pct = pct;
                        root.set-preview-volume(pct);
                    }
                    stop-preview => { root.stop-preview(); }
                    open-playing-release => {
                        if (root.preview-release-id > 0) {
                            if (root.active-view != 0) {
                                root.navigate(0);
                            }
                            root.select-release(root.preview-release-id);
                        }
                    }
                }
            }

            // =====================================================================
            // UNIFIED FULL-WIDTH RIGHT INSPECTOR DRAWER (RELEASE OR ARTIST)
            // =====================================================================
            Rectangle {
                property <bool> drawer-open:
                    (root.active-view == 0 || root.active-view == 1)
                    && ((root.inspector-mode == 1 && root.selected-release-id > 0)
                        || (root.inspector-mode == 2 && root.selected-artist-id > 0));
                width: self.drawer-open ? 386px : 0px;
                horizontal-stretch: 0;
                background: Theme.surface-rail;
                clip: true;

                animate width { duration: 190ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }

                Rectangle {
                    x: 0px;
                    width: 1px;
                    height: 100%;
                    background: Theme.outline-variant;
                }

                // -----------------------------------------------------------------
                // MODE 1: RELEASE DETAILS INSPECTOR (with Quick Artist Mute/Hide)
                // -----------------------------------------------------------------
                if self.drawer-open && root.inspector-mode == 1 : VerticalLayout {
                    width: 386px;
                    height: 100%;
                    padding: 18px;
                    spacing: 12px;

                    // Full-Width Sticky Header
                    HorizontalLayout {
                        width: 100%;
                        spacing: 8px;
                        vertical-stretch: 0;
                        Text {
                            text: "Release Details";
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.on-surface-variant;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        M3IconButton {
                            size: 32px;
                            icon-size: 15px;
                            icon: @image-url("../assets/icons/close.svg");
                            clicked => { root.close-inspector(); }
                        }
                    }

                    rel-scroll := ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            width: rel-scroll.visible-width;
                            padding-right: 4px;
                            spacing: 12px;
                            alignment: start;

                            // High-res Artwork
                            HorizontalLayout {
                                alignment: center;
                                CoverArtwork {
                                    width: 224px;
                                    height: 224px;
                                    cover: root.selected-release.cover;
                                    has-cover: root.selected-release.has-cover;
                                    monogram: root.selected-release.monogram;
                                    accent-hue: root.selected-release.accent-hue;
                                    corner-radius: 14px;
                                }
                            }

                            // Bounded Badges Row
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                vertical-stretch: 0;

                                TonalBadge {
                                    label: root.selected-release.release-type;
                                    badge-bg: Theme.primary-container;
                                    badge-fg: Theme.on-primary-container;
                                }

                                if root.selected-release.upcoming : TonalBadge {
                                    label: "UPCOMING";
                                    badge-bg: Theme.success-container;
                                    badge-fg: Theme.on-success-container;
                                }

                                if root.selected-release.owned-locally : TonalBadge {
                                    label: "IN LIBRARY";
                                }

                                if root.selected-release.explicit : TonalBadge {
                                    label: "EXPLICIT";
                                    badge-bg: Theme.error-container;
                                    badge-fg: Theme.on-error-container;
                                }

                                TonalBadge {
                                    label: root.selected-release.provider-label;
                                }
                            }

                            // Title, Clickable Artist & Release Date
                            VerticalLayout {
                                spacing: 4px;
                                alignment: start;
                                vertical-stretch: 0;

                                Text {
                                    text: root.selected-release.title;
                                    font-size: 18px;
                                    font-weight: 800;
                                    color: Theme.on-surface;
                                    wrap: word-wrap;
                                }

                                Rectangle {
                                    height: 22px;
                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: root.selected-release.artist-name;
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: insp-artist-touch.has-hover
                                            ? Theme.primary.brighter(0.15)
                                            : Theme.primary;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    insp-artist-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.inspect-artist(root.selected-release.artist-id); }
                                    }
                                }

                                Text {
                                    text: root.selected-release.release-date != ""
                                        ? "Released \{root.selected-release.release-date}"
                                        : "Release date TBA";
                                    font-size: 12px;
                                    color: Theme.on-surface-muted;
                                }
                            }

                            // Release Actions (Seen / Dismiss)
                            HorizontalLayout {
                                spacing: 8px;
                                vertical-stretch: 0;

                                M3Button {
                                    fill-width: true;
                                    variant: root.selected-release.unseen ? "filled" : "tonal";
                                    has-icon: true;
                                    icon: @image-url("../assets/icons/check.svg");
                                    text: root.selected-release.unseen ? "Mark as Seen" : "Mark Unread";
                                    clicked => { root.toggle-release-seen(root.selected-release.id); }
                                }

                                M3Button {
                                    variant: "outlined";
                                    has-icon: true;
                                    icon: @image-url("../assets/icons/eye-off.svg");
                                    text: "Dismiss";
                                    clicked => { root.dismiss-release(root.selected-release.id); }
                                }
                            }

                            // Quick Artist Triage Row directly inside Release Details
                            HorizontalLayout {
                                spacing: 6px;
                                vertical-stretch: 0;

                                M3Button {
                                    fill-width: true;
                                    compact: true;
                                    variant: root.selected-release-artist-status == "muted" ? "primary-tonal" : "outlined";
                                    has-icon: true;
                                    icon: root.selected-release-artist-status == "muted"
                                        ? @image-url("../assets/icons/volume-on.svg")
                                        : @image-url("../assets/icons/volume-off.svg");
                                    text: root.selected-release-artist-status == "muted" ? "Unmute Artist" : "Mute Artist";
                                    clicked => { root.toggle-artist-mute(root.selected-release.artist-id); }
                                }

                                M3Button {
                                    fill-width: true;
                                    compact: true;
                                    variant: root.selected-release-artist-status == "ignored" ? "primary-tonal" : "danger";
                                    has-icon: true;
                                    icon: @image-url("../assets/icons/eye-off.svg");
                                    text: root.selected-release-artist-status == "ignored" ? "Restore Artist" : "Hide Artist";
                                    clicked => { root.toggle-artist-ignore(root.selected-release.artist-id); }
                                }
                            }

                            if root.selected-release.external-url != "" || root.selected-release.musicbrainz-url != "" : HorizontalLayout {
                                spacing: 8px;
                                vertical-stretch: 0;

                                if root.selected-release.external-url != "" : M3Button {
                                    fill-width: true;
                                    compact: true;
                                    variant: "outlined";
                                    has-icon: true;
                                    icon: @image-url("../assets/icons/external.svg");
                                    text: "Deezer";
                                    clicked => { root.open-external-url(root.selected-release.external-url); }
                                }

                                if root.selected-release.musicbrainz-url != "" : M3Button {
                                    fill-width: true;
                                    compact: true;
                                    variant: "outlined";
                                    has-icon: true;
                                    icon: @image-url("../assets/icons/external.svg");
                                    text: "MusicBrainz";
                                    clicked => { root.open-external-url(root.selected-release.musicbrainz-url); }
                                }
                            }

                            Rectangle {
                                height: 1px;
                                vertical-stretch: 0;
                                background: Theme.outline-variant;
                            }

                            // Tracklist Header & Rows
                            HorizontalLayout {
                                spacing: 8px;
                                vertical-stretch: 0;
                                Text {
                                    text: "Tracklist  ·  Click 30s for In-App Preview";
                                    font-size: 12.5px;
                                    font-weight: 700;
                                    color: Theme.on-surface;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                if root.selected-release-tracks.length > 0 : Text {
                                    text: "\{root.selected-release-tracks.length}";
                                    font-size: 11px;
                                    color: Theme.on-surface-muted;
                                    vertical-alignment: center;
                                }
                            }

                            if root.loading-tracks : HorizontalLayout {
                                spacing: 8px;
                                padding-top: 6px;
                                vertical-stretch: 0;
                                Spinner { width: 18px; height: 18px; indeterminate: true; }
                                Text {
                                    text: "Loading tracklist...";
                                    font-size: 12px;
                                    color: Theme.on-surface-variant;
                                    vertical-alignment: center;
                                }
                            }

                            if !root.loading-tracks && root.selected-release-tracks.length == 0 : Text {
                                text: "Tracklist not yet available for this release.";
                                font-size: 12px;
                                color: Theme.on-surface-muted;
                            }

                            for trk in root.selected-release-tracks : TrackRow {
                                track: trk;
                                is-current-track: root.preview-active
                                    && root.preview-release-id == root.selected-release.id
                                    && root.preview-disc-number == trk.disc-number
                                    && root.preview-track-number == trk.track-number;
                                is-playing: root.preview-playing;
                                is-buffering: root.preview-buffering;
                                audio-level: root.preview-level;
                                play-preview(clicked-trk) => {
                                    root.play-track-preview(
                                        root.selected-release.id,
                                        clicked-trk.disc-number,
                                        clicked-trk.track-number
                                    );
                                }
                            }
                        }
                    }
                }

                // -----------------------------------------------------------------
                // MODE 2: ARTIST INSPECTOR (Full-Width Sticky Header + Mute/Hide)
                // -----------------------------------------------------------------
                if self.drawer-open && root.inspector-mode == 2 : VerticalLayout {
                    width: 386px;
                    height: 100%;
                    padding: 18px;
                    spacing: 12px;

                    // Full-Width Sticky Header (Uses 100% of the 386px Panel!)
                    HorizontalLayout {
                        width: 100%;
                        spacing: 12px;
                        vertical-stretch: 0;

                        ArtistAvatar {
                            size: 46px;
                            y: (parent.height - self.height) / 2;
                            avatar: root.selected-artist.avatar;
                            has-avatar: root.selected-artist.has-avatar;
                            monogram: root.selected-artist.monogram;
                            accent-hue: root.selected-artist.accent-hue;
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            horizontal-stretch: 1;

                            Text {
                                text: root.selected-artist.name;
                                font-size: 17px;
                                font-weight: 800;
                                color: Theme.on-surface;
                                overflow: elide;
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;

                                TonalBadge {
                                    label: root.selected-artist.status == "tracked" ? "TRACKED"
                                         : root.selected-artist.status == "muted" ? "MUTED"
                                         : "HIDDEN";
                                    badge-bg: root.selected-artist.status == "tracked" ? Theme.primary-container
                                            : root.selected-artist.status == "muted" ? Theme.warning-container
                                            : Theme.error-container;
                                    badge-fg: root.selected-artist.status == "tracked" ? Theme.on-primary-container
                                            : root.selected-artist.status == "muted" ? Theme.on-warning-container
                                            : Theme.on-error-container;
                                }
                            }
                        }

                        M3IconButton {
                            y: (parent.height - self.height) / 2;
                            size: 32px;
                            icon-size: 15px;
                            icon: @image-url("../assets/icons/close.svg");
                            clicked => { root.close-inspector(); }
                        }
                    }

                    art-scroll := ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            width: art-scroll.visible-width;
                            padding-right: 4px;
                            spacing: 13px;
                            alignment: start;

                            if root.selected-artist.disambiguation != "" : Text {
                                text: root.selected-artist.disambiguation;
                                font-size: 12px;
                                color: Theme.on-surface-variant;
                                wrap: word-wrap;
                            }

                            Text {
                                text: "\{root.selected-artist.source-label} · \{root.selected-artist.release-count} releases found";
                                font-size: 12px;
                                color: Theme.on-surface-muted;
                                wrap: word-wrap;
                            }

                            // Prominent Quick Mute / Hide Artist Row
                            HorizontalLayout {
                                spacing: 8px;
                                vertical-stretch: 0;

                                M3Button {
                                    fill-width: true;
                                    variant: root.selected-artist.status == "muted" ? "primary-tonal" : "outlined";
                                    has-icon: true;
                                    icon: root.selected-artist.status == "muted"
                                        ? @image-url("../assets/icons/volume-on.svg")
                                        : @image-url("../assets/icons/volume-off.svg");
                                    text: root.selected-artist.status == "muted" ? "Unmute Artist" : "Mute Artist";
                                    clicked => { root.toggle-artist-mute(root.selected-artist.id); }
                                }

                                M3Button {
                                    fill-width: true;
                                    variant: root.selected-artist.status == "ignored" ? "primary-tonal" : "danger";
                                    has-icon: true;
                                    icon: @image-url("../assets/icons/eye-off.svg");
                                    text: root.selected-artist.status == "ignored" ? "Restore Artist" : "Hide Artist";
                                    clicked => { root.toggle-artist-ignore(root.selected-artist.id); }
                                }
                            }

                            // Secondary Actions (Check Now / Filter Radar)
                            HorizontalLayout {
                                spacing: 8px;
                                vertical-stretch: 0;

                                M3Button {
                                    fill-width: true;
                                    variant: "filled";
                                    has-icon: true;
                                    icon: @image-url("../assets/icons/refresh.svg");
                                    text: "Check Now";
                                    enabled: !root.is-busy;
                                    clicked => { root.check-single-artist(root.selected-artist.id); }
                                }

                                M3Button {
                                    fill-width: true;
                                    variant: "tonal";
                                    has-icon: true;
                                    icon: @image-url("../assets/icons/radar.svg");
                                    text: "Filter Radar";
                                    clicked => { root.view-artist-releases(root.selected-artist.id); }
                                }
                            }

                            if root.selected-artist.external-url != "" : M3Button {
                                fill-width: true;
                                variant: "outlined";
                                has-icon: true;
                                icon: @image-url("../assets/icons/external.svg");
                                text: "Open Artist Page";
                                clicked => { root.open-external-url(root.selected-artist.external-url); }
                            }

                            if root.selected-artist.is-manual : M3Button {
                                fill-width: true;
                                variant: "danger";
                                has-icon: true;
                                icon: @image-url("../assets/icons/trash.svg");
                                text: "Delete Manual Artist";
                                clicked => { root.delete-artist(root.selected-artist.id); }
                            }

                            Rectangle {
                                height: 1px;
                                vertical-stretch: 0;
                                background: Theme.outline-variant;
                            }

                            VerticalLayout {
                                spacing: 3px;
                                vertical-stretch: 0;
                                Text {
                                    text: "Provider Identity Link";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: Theme.on-surface;
                                }
                                Text {
                                    text: "Auto-matched via tags & local albums. Override if two artists share the same name:";
                                    font-size: 11px;
                                    color: Theme.on-surface-muted;
                                    wrap: word-wrap;
                                }
                            }

                            M3LabeledInput {
                                label: "Deezer Artist ID";
                                placeholder: "e.g. 9052";
                                text <=> root.edit-artist-deezer-id;
                            }

                            M3LabeledInput {
                                label: "MusicBrainz Artist MBID";
                                placeholder: "UUID (xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)";
                                text <=> root.edit-artist-mbid;
                            }

                            M3Button {
                                fill-width: true;
                                variant: "primary-tonal";
                                has-icon: true;
                                icon: @image-url("../assets/icons/check.svg");
                                text: "Save Provider IDs";
                                clicked => {
                                    root.save-artist-provider-ids(
                                        root.selected-artist.id,
                                        root.edit-artist-mbid,
                                        root.edit-artist-deezer-id
                                    );
                                }
                            }

                            Rectangle {
                                height: 1px;
                                vertical-stretch: 0;
                                background: Theme.outline-variant;
                            }

                            Text {
                                text: "Local Library Albums (\{root.selected-artist-local-albums.length})";
                                font-size: 13px;
                                font-weight: 700;
                                color: Theme.on-surface;
                            }

                            if root.selected-artist-local-albums.length == 0 : Text {
                                text: "No local albums indexed for this artist.";
                                font-size: 11.5px;
                                color: Theme.on-surface-muted;
                            }

                            for alb in root.selected-artist-local-albums : LocalAlbumItem {
                                album: alb;
                            }
                        }
                    }
                }
            }
        }
    }
}
