import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    ArtistRowData,
    FolderRowData,
    LocalAlbumRowData,
    ReleaseCardData,
    SearchCandidateRowData,
    TrackRowData,
} from "models.slint";
import { PreviewMiniPlayer } from "components.slint";
import { ArtistsView } from "views/artists-view.slint";
import { InspectorDrawer } from "views/inspector-drawer.slint";
import { NavRail } from "views/nav-rail.slint";
import { RadarView } from "views/radar-view.slint";
import { SettingsView } from "views/settings-view.slint";

export {
    ArtistRowData,
    FolderRowData,
    LocalAlbumRowData,
    ReleaseCardData,
    SearchCandidateRowData,
    Theme,
    TrackRowData,
}

export component AppWindow inherits Window {
    title: "MissNix — Local Music Release Radar";
    // The shell can reflow into an overlay inspector and compact navigation.
    // A compositor can still give us less logical space after a scale change.
    min-width: 480px;
    min-height: 400px;
    preferred-width: 1400px;
    preferred-height: 880px;
    background: Theme.surface;

    // -------------------------------------------------------------------------
    // Navigation & Global State
    // -------------------------------------------------------------------------
    // 0 = Release Radar, 1 = Tracked Artists, 2 = Library & Settings
    in-out property <int> active-view: 0;
    in property <int> unseen-badge-count: 0;
    in property <int> filtered-unseen-count: 0;
    in property <string> library-summary-text: "0 tracked artists\n0 local albums";
    in property <string> status-banner-text: "Ready";
    in property <bool> status-is-warning: false;

    // Background worker telemetry
    in property <bool> is-busy: false;
    // Folder/scan-preference changes made during a task are reconciled afterwards.
    in property <bool> scan-pending: false;
    in property <int> search-request-id: 0;
    in property <bool> progress-indeterminate: false;
    in property <float> progress-fraction: 0.0;
    in property <string> busy-label: "";

    // -------------------------------------------------------------------------
    // In-App 30s Audio Preview Player State
    // -------------------------------------------------------------------------
    in property <bool> preview-active: false;
    in property <bool> preview-playing: false;
    in property <bool> preview-buffering: false;
    in property <int> preview-release-id: 0;
    in property <int> preview-disc-number: 0;
    in property <int> preview-track-number: 0;
    in property <string> preview-track-title: "";
    in property <string> preview-artist-name: "";
    in property <string> preview-release-title: "";
    in property <image> preview-cover;
    in property <bool> preview-has-cover: false;
    in property <string> preview-monogram: "♪";
    in property <int> preview-accent-hue: 0;
    in property <float> preview-progress: 0.0;
    in property <string> preview-elapsed-label: "0:00";
    in property <string> preview-duration-label: "0:30";
    in property <float> preview-level: 0.0;
    in-out property <int> preview-volume-pct: 80;

    // -------------------------------------------------------------------------
    // Unified Release Radar Feed State
    // -------------------------------------------------------------------------
    in property <[ReleaseCardData]> releases: [];
    in-out property <string> feed-search-text: "";
    in-out property <int> feed-status-index: 0;     // 0 All, 1 Unread, 2 Upcoming
    in-out property <int> feed-type-index: 0;       // 0 All Types, 1 Albums, 2 EPs, 3 Singles
    in-out property <int> feed-sort-index: 0;       // 0 Newest, 1 Upcoming, 2 Artist A-Z
    in-out property <bool> feed-hide-owned: true;
    in property <int> filtered-artist-id: 0;
    in property <string> filtered-artist-name: "";
    in property <string> filtered-artist-status: "tracked";

    // Unified Right Inspector Mode: 0 = Closed, 1 = Release Details, 2 = Artist Details
    in-out property <int> inspector-mode: 0;

    // Keep at least 700 logical pixels for the main view before docking a
    // 404px inspector beside the 244px rail. Below that it overlays instead.
    property <bool> overlay-inspector: root.width < 1348px;
    property <bool> compact-navigation: root.width < 980px;
    property <bool> navigation-expanded: false;
    property <length> navigation-width: root.compact-navigation ? 72px : 244px;

    changed compact-navigation => {
        if (!root.compact-navigation) { root.navigation-expanded = false; }
    }
    // Closing a panel can remove the focused control. Restore a live focus
    // target so Escape and the global shortcuts continue to work afterwards.
    changed navigation-expanded => { key-scope.focus(); }
    changed is-busy => {
        if (!root.is-busy && nav.cancel-has-focus) { key-scope.focus(); }
    }
    changed show-add-artist-bar => {
        if (!root.show-add-artist-bar) { key-scope.focus(); }
    }
    changed inspector-mode => {
        if (root.inspector-mode != 0) { root.navigation-expanded = false; }
        key-scope.focus();
    }

    // Selected Release Inspector State
    in property <int> selected-release-id: 0;
    in property <ReleaseCardData> selected-release;
    in property <string> selected-release-artist-status: "tracked";
    in property <[TrackRowData]> selected-release-tracks: [];
    in property <bool> loading-tracks: false;

    // -------------------------------------------------------------------------
    // Tracked Artists State
    // -------------------------------------------------------------------------
    in property <[ArtistRowData]> artists: [];
    in-out property <string> artist-search-text: "";
    in-out property <int> artist-filter-index: 0;   // 0 All, 1 Tracked, 2 Muted, 3 Ignored, 4 Manual
    in-out property <bool> show-add-artist-bar: false;
    in-out property <string> manual-artist-query: "";
    in property <[SearchCandidateRowData]> artist-search-candidates: [];
    in property <bool> searching-external-artists: false;

    // Selected Artist Detail State
    in property <int> selected-artist-id: 0;
    in property <ArtistRowData> selected-artist;
    in property <[LocalAlbumRowData]> selected-artist-local-albums: [];
    in-out property <string> edit-artist-mbid: "";
    in-out property <string> edit-artist-deezer-id: "";

    // -------------------------------------------------------------------------
    // Library & Settings State
    // -------------------------------------------------------------------------
    in property <[FolderRowData]> library-folders: [];
    in-out property <string> new-folder-path: "";

    in-out property <bool> pref-dark-mode: true;
    in-out property <int> pref-accent-preset: 0;    // 0..6 presets, 7 = Custom Hex
    in-out property <string> pref-custom-accent-hex: "#6366F1";
    in-out property <int> pref-grid-density: 1;     // 0=Compact, 1=Comfortable, 2=Spacious
    in-out property <int> pref-ui-scale-pct: 100;   // 90, 100, 115, 125, 150, 175, 200
    in-out property <int> pref-discovery-mode: 0;   // 0=AlbumArtist+Folder, 1=FolderOnly, 2=AllTags+Folder
    in-out property <bool> pref-split-collaborations: true;
    in-out property <bool> pref-include-albums: true;
    in-out property <bool> pref-include-eps: true;
    in-out property <bool> pref-include-singles: true;
    in-out property <bool> pref-hide-owned: true;
    in-out property <bool> pref-hide-noise: true;
    in-out property <bool> pref-include-compilations: false;
    in-out property <int> pref-lookback-index: 2;   // 0=90d, 1=180d, 2=1y, 3=2y, 4=All
    in-out property <int> pref-provider-index: 0;   // 0=Deezer+MB, 1=Deezer, 2=MB
    in-out property <int> pref-schedule-index: 2;   // 0=Manual, 1=6h, 2=12h, 3=24h

    // -------------------------------------------------------------------------
    // Callbacks to Rust Controller
    // -------------------------------------------------------------------------
    callback navigate(int);
    callback scan-library();
    callback check-all-releases();
    callback cancel-background-task();

    // Audio Preview callbacks
    callback play-track-preview(int, int, int);     // (release_id, disc_number, track_number)
    callback toggle-preview-pause();
    callback seek-preview(float);
    callback set-preview-volume(int);
    callback stop-preview();

    // Feed & Inspector callbacks
    callback feed-filters-changed();
    callback clear-artist-feed-filter();
    callback select-release(int);
    callback close-inspector();
    callback toggle-release-seen(int);
    callback dismiss-release(int);
    callback mark-all-seen();
    callback open-external-url(string);
    callback inspect-artist(int);

    // Artists callbacks
    callback artist-filters-changed();
    callback select-artist(int);
    callback check-single-artist(int);
    callback view-artist-releases(int);
    callback toggle-artist-mute(int);
    callback toggle-artist-ignore(int);
    callback delete-artist(int);
    callback save-artist-provider-ids(int, string, string);
    callback search-external-artist(string);
    callback add-artist-by-name(string);
    callback add-search-candidate(int);

    // Settings & Folders callbacks
    callback browse-for-folder();
    callback add-folder-path(string);
    callback remove-folder(int);
    callback preferences-changed();
    callback scan-preferences-changed();
    callback theme-toggled(bool);
    callback custom-accent-changed(string, bool);
    callback ui-scale-changed(int);

    public function apply-theme(dark: bool, accent: int) {
        root.pref-dark-mode = dark;
        root.pref-accent-preset = accent;
        Theme.dark-mode = dark;
        Theme.accent-preset = accent;
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    // -------------------------------------------------------------------------
    // Keyboard Shortcuts
    // -------------------------------------------------------------------------
    forward-focus: key-scope;

    key-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.inspector-mode != 0) {
                    root.close-inspector();
                    return accept;
                }
                if (root.navigation-expanded) {
                    root.navigation-expanded = false;
                    return accept;
                }
                if (root.show-add-artist-bar) {
                    root.show-add-artist-bar = false;
                    return accept;
                }
            }
            if (event.text == " " && root.preview-active) {
                root.toggle-preview-pause();
                return accept;
            }
            if (event.modifiers.control && (event.text == "r" || event.text == "R")) {
                if (!root.is-busy) {
                    root.check-all-releases();
                }
                return accept;
            }
            if (event.modifiers.control && (event.text == "=" || event.text == "+")) {
                root.ui-scale-changed(min(200, root.pref-ui-scale-pct + 15));
                return accept;
            }
            if (event.modifiers.control && event.text == "-") {
                root.ui-scale-changed(max(90, root.pref-ui-scale-pct - 15));
                return accept;
            }
            if (event.modifiers.control && event.text == "0") {
                root.ui-scale-changed(100);
                return accept;
            }
            if (event.text == "/" && root.active-view == 0) {
                radar-view.focus-search();
                return accept;
            }
            if (event.text == "/" && root.active-view == 1) {
                artists-view.focus-search();
                return accept;
            }
            reject
        }

        HorizontalLayout {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;

            // The rail itself is layered above the shell so it can expand over
            // the content without resizing it on narrow windows.
            Rectangle {
                width: root.navigation-width;
                horizontal-stretch: 0;
            }

            VerticalLayout {
                // Only a docked inspector reserves space. An overlay leaves
                // the main view and its controls at their full usable width.
                horizontal-stretch: 1;
                min-width: 0px;
                height: 100%;

                Rectangle {
                    vertical-stretch: 1;
                    min-height: 0px;
                    background: Theme.surface;
                    clip: true;

                    radar-view := RadarView {
                        active-view <=> root.active-view;
                        check-all-releases => { root.check-all-releases(); }
                        clear-artist-feed-filter => { root.clear-artist-feed-filter(); }
                        dismiss-release(a0) => { root.dismiss-release(a0); }
                        feed-filters-changed => { root.feed-filters-changed(); }
                        feed-hide-owned <=> root.feed-hide-owned;
                        feed-search-text <=> root.feed-search-text;
                        feed-sort-index <=> root.feed-sort-index;
                        feed-status-index <=> root.feed-status-index;
                        feed-type-index <=> root.feed-type-index;
                        filtered-artist-id: root.filtered-artist-id;
                        filtered-artist-name: root.filtered-artist-name;
                        filtered-artist-status: root.filtered-artist-status;
                        inspect-artist(a0) => { root.inspect-artist(a0); }
                        inspector-mode <=> root.inspector-mode;
                        is-busy: root.is-busy;
                        library-folders: root.library-folders;
                        mark-all-seen => { root.mark-all-seen(); }
                        navigate(a0) => { root.navigate(a0); }
                        pref-grid-density <=> root.pref-grid-density;
                        preview-active: root.preview-active;
                        preview-playing: root.preview-playing;
                        preview-release-id: root.preview-release-id;
                        releases: root.releases;
                        select-release(a0) => { root.select-release(a0); }
                        selected-release-id: root.selected-release-id;
                        toggle-artist-ignore(a0) => { root.toggle-artist-ignore(a0); }
                        toggle-artist-mute(a0) => { root.toggle-artist-mute(a0); }
                        toggle-release-seen(a0) => { root.toggle-release-seen(a0); }
                        filtered-unseen-count: root.filtered-unseen-count;
                    }

                    artists-view := ArtistsView {
                        active-view <=> root.active-view;
                        add-artist-by-name(a0) => { root.add-artist-by-name(a0); }
                        add-search-candidate(a0) => { root.add-search-candidate(a0); }
                        artist-filter-index <=> root.artist-filter-index;
                        artist-filters-changed => { root.artist-filters-changed(); }
                        artist-search-candidates: root.artist-search-candidates;
                        artist-search-text <=> root.artist-search-text;
                        artists: root.artists;
                        inspector-mode <=> root.inspector-mode;
                        manual-artist-query <=> root.manual-artist-query;
                        search-external-artist(a0) => { root.search-external-artist(a0); }
                        searching-external-artists: root.searching-external-artists;
                        select-artist(a0) => { root.select-artist(a0); }
                        selected-artist-id: root.selected-artist-id;
                        show-add-artist-bar <=> root.show-add-artist-bar;
                        toggle-artist-ignore(a0) => { root.toggle-artist-ignore(a0); }
                        toggle-artist-mute(a0) => { root.toggle-artist-mute(a0); }
                        view-artist-releases(a0) => { root.view-artist-releases(a0); }
                    }

                    SettingsView {
                        active-view <=> root.active-view;
                        add-folder-path(a0) => { root.add-folder-path(a0); }
                        apply-theme(dark, accent) => { root.apply-theme(dark, accent); }
                        browse-for-folder => { root.browse-for-folder(); }
                        custom-accent-changed(a0, a1) => { root.custom-accent-changed(a0, a1); }
                        is-busy: root.is-busy;
                        library-folders: root.library-folders;
                        new-folder-path <=> root.new-folder-path;
                        pref-accent-preset <=> root.pref-accent-preset;
                        pref-custom-accent-hex <=> root.pref-custom-accent-hex;
                        pref-dark-mode <=> root.pref-dark-mode;
                        pref-discovery-mode <=> root.pref-discovery-mode;
                        pref-grid-density <=> root.pref-grid-density;
                        pref-hide-noise <=> root.pref-hide-noise;
                        pref-hide-owned <=> root.pref-hide-owned;
                        pref-include-albums <=> root.pref-include-albums;
                        pref-include-compilations <=> root.pref-include-compilations;
                        pref-include-eps <=> root.pref-include-eps;
                        pref-include-singles <=> root.pref-include-singles;
                        pref-lookback-index <=> root.pref-lookback-index;
                        pref-provider-index <=> root.pref-provider-index;
                        pref-schedule-index <=> root.pref-schedule-index;
                        pref-split-collaborations <=> root.pref-split-collaborations;
                        pref-ui-scale-pct <=> root.pref-ui-scale-pct;
                        preferences-changed => { root.preferences-changed(); }
                        remove-folder(a0) => { root.remove-folder(a0); }
                        scan-library => { root.scan-library(); }
                        scan-preferences-changed => { root.scan-preferences-changed(); }
                        theme-toggled(a0) => { root.theme-toggled(a0); }
                        ui-scale-changed(a0) => { root.ui-scale-changed(a0); }
                    }
                }

                PreviewMiniPlayer {
                    active: root.preview-active;
                    playing: root.preview-playing;
                    buffering: root.preview-buffering;
                    track-title: root.preview-track-title;
                    artist-name: root.preview-artist-name;
                    release-title: root.preview-release-title;
                    cover: root.preview-cover;
                    has-cover: root.preview-has-cover;
                    monogram: root.preview-monogram;
                    accent-hue: root.preview-accent-hue;
                    progress: root.preview-progress;
                    elapsed-label: root.preview-elapsed-label;
                    duration-label: root.preview-duration-label;
                    level: root.preview-level;
                    volume-pct: root.preview-volume-pct;

                    toggle-pause => { root.toggle-preview-pause(); }
                    seek(frac) => { root.seek-preview(frac); }
                    volume-changed(pct) => {
                        root.preview-volume-pct = pct;
                        root.set-preview-volume(pct);
                    }
                    stop-preview => { root.stop-preview(); }
                    open-playing-release => {
                        if (root.preview-release-id > 0) {
                            if (root.active-view != 0) {
                                root.navigate(0);
                            }
                            root.select-release(root.preview-release-id);
                        }
                    }
                }
            }

            Rectangle {
                width: !root.overlay-inspector && drawer.drawer-open ? 404px : 0px;
                horizontal-stretch: 0;
            }
        }

        // Expanded navigation temporarily covers the content in compact mode.
        if root.compact-navigation && root.navigation-expanded : Rectangle {
            x: root.navigation-width;
            width: max(0px, parent.width - self.x);
            height: 100%;
            background: #000000.with-alpha(0.35);
            TouchArea { clicked => { root.navigation-expanded = false; } }
        }

        nav := NavRail {
            x: 0px;
            y: 0px;
            width: root.compact-navigation && !root.navigation-expanded ? 72px : 244px;
            height: 100%;
            compact: root.compact-navigation && !root.navigation-expanded;
            collapsible: root.compact-navigation;
            expand-navigation => { root.navigation-expanded = true; }
            collapse-navigation => { root.navigation-expanded = false; }
            active-view <=> root.active-view;
            busy-label: root.busy-label;
            cancel-background-task => { root.cancel-background-task(); }
            check-all-releases => { root.check-all-releases(); }
            is-busy: root.is-busy;
            library-summary-text: root.library-summary-text;
            navigate(a0) => {
                root.navigation-expanded = false;
                root.navigate(a0);
            }
            progress-fraction: root.progress-fraction;
            progress-indeterminate: root.progress-indeterminate;
            scan-library => { root.scan-library(); }
            status-banner-text: root.status-banner-text;
            status-is-warning: root.status-is-warning;
            unseen-badge-count: root.unseen-badge-count;
        }

        // Dismiss an overlay by clicking outside it. The docked inspector has
        // no scrim, so its neighboring grid remains directly interactive.
        if root.overlay-inspector && drawer.drawer-open : Rectangle {
            width: 100%;
            height: 100%;
            background: #000000.with-alpha(0.35);
            TouchArea { clicked => { root.close-inspector(); } }
        }

        drawer := InspectorDrawer {
            x: max(0px, parent.width - self.width);
            y: 0px;
            height: 100%;
            available-width: root.width;
            active-view <=> root.active-view;
            check-single-artist(a0) => { root.check-single-artist(a0); }
            close-inspector => { root.close-inspector(); }
            delete-artist(a0) => { root.delete-artist(a0); }
            dismiss-release(a0) => { root.dismiss-release(a0); }
            edit-artist-deezer-id <=> root.edit-artist-deezer-id;
            edit-artist-mbid <=> root.edit-artist-mbid;
            inspect-artist(a0) => { root.inspect-artist(a0); }
            inspector-mode <=> root.inspector-mode;
            is-busy: root.is-busy;
            loading-tracks: root.loading-tracks;
            open-external-url(a0) => { root.open-external-url(a0); }
            play-track-preview(a0, a1, a2) => { root.play-track-preview(a0, a1, a2); }
            preview-active: root.preview-active;
            preview-buffering: root.preview-buffering;
            preview-disc-number: root.preview-disc-number;
            preview-level: root.preview-level;
            preview-playing: root.preview-playing;
            preview-release-id: root.preview-release-id;
            preview-track-number: root.preview-track-number;
            save-artist-provider-ids(a0, a1, a2) => { root.save-artist-provider-ids(a0, a1, a2); }
            selected-artist: root.selected-artist;
            selected-artist-id: root.selected-artist-id;
            selected-artist-local-albums: root.selected-artist-local-albums;
            selected-release: root.selected-release;
            selected-release-artist-status: root.selected-release-artist-status;
            selected-release-id: root.selected-release-id;
            selected-release-tracks: root.selected-release-tracks;
            toggle-artist-ignore(a0) => { root.toggle-artist-ignore(a0); }
            toggle-artist-mute(a0) => { root.toggle-artist-mute(a0); }
            toggle-release-seen(a0) => { root.toggle-release-seen(a0); }
            view-artist-releases(a0) => { root.view-artist-releases(a0); }
        }
    }
}
