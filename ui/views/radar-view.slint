import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { FolderRowData, ReleaseCardData } from "../models.slint";
import {
    M3Button,
    M3FilterChip,
    M3HorizontalScrollBar,
    M3ScrollBar,
    M3SearchField,
    M3Select,
    M3Switch,
    ReleaseCard,
    TonalBadge,
} from "../components.slint";

export component RadarView inherits Rectangle {
    in-out property <int> active-view;
    callback check-all-releases();
    callback clear-artist-feed-filter();
    callback dismiss-release(int);
    callback feed-filters-changed();
    in-out property <bool> feed-hide-owned;
    in-out property <string> feed-search-text;
    in-out property <int> feed-sort-index;
    in-out property <int> feed-status-index;
    in-out property <int> feed-type-index;
    in property <int> filtered-artist-id;
    in property <string> filtered-artist-name;
    in property <string> filtered-artist-status;
    callback inspect-artist(int);
    in-out property <int> inspector-mode;
    in property <bool> is-busy;
    in property <[FolderRowData]> library-folders;
    callback mark-all-seen();
    callback navigate(int);
    in-out property <int> pref-grid-density;
    in property <bool> preview-active;
    in property <bool> preview-playing;
    in property <int> preview-release-id;
    in property <[ReleaseCardData]> releases;
    callback select-release(int);
    in property <int> selected-release-id;
    callback toggle-artist-ignore(int);
    callback toggle-artist-mute(int);
    callback toggle-release-seen(int);
    in property <int> filtered-unseen-count;

    public function focus-search() {
        feed-search-input.focus-input();
    }

    visible: root.active-view == 0;
    width: 100%;
    height: 100%;
    clip: true;

    // In a short/high-scale window the toolbar and a usable grid viewport may
    // not both fit vertically. Scroll the page rather than hiding the grid or
    // pushing the preview player off screen.
    page-scroll := ScrollView {
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        content-width: self.visible-width;
        content-height: max(self.visible-height, radar-page.preferred-height);

        radar-page := VerticalLayout {
            width: page-scroll.visible-width;
            height: max(page-scroll.visible-height, self.preferred-height);

            // Top Desktop Filter Bar
            Rectangle {
                vertical-stretch: 0;
                background: Theme.surface;

                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 14px;
                    padding-bottom: 12px;
                    spacing: 11px;
                    alignment: start;

                    // At narrower widths the title and actions get separate rows.
                    // The optional artist actions can scroll rather than disappearing
                    // under the inspector, even for unusually long artist names.
                    heading := Rectangle {
                        property <length> action-width: action-row.preferred-width + 12px;
                        property <bool> stacked: self.width < self.action-width + 390px || root.filtered-artist-id > 0;
                        height: self.stacked ? 90px : 40px;
                        vertical-stretch: 0;

                        VerticalLayout {
                            x: 0px;
                            y: 0px;
                            width: heading.stacked ? heading.width : max(0px, heading.width - heading.action-width - 8px);
                            height: 40px;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Release Radar";
                                font-size: 21px;
                                font-weight: 800;
                                color: Theme.on-surface;
                                overflow: elide;
                            }
                            Text {
                                text: "New, upcoming, and catalog releases across your tracked artists";
                                font-size: 12px;
                                color: Theme.on-surface-variant;
                                overflow: elide;
                            }
                        }

                        action-scroll := ScrollView {
                            x: heading.stacked ? 0px : max(0px, heading.width - heading.action-width);
                            y: heading.stacked ? 46px : 0px;
                            width: heading.stacked ? heading.width : min(heading.action-width, heading.width);
                            height: 48px;
                            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            content-width: max(self.visible-width, action-row.preferred-width);
                            content-height: 36px;

                            action-row := HorizontalLayout {
                                x: 0px;
                                y: 0px;
                                width: self.preferred-width;
                                height: 36px;
                                spacing: 10px;

                                if root.filtered-artist-id > 0 : HorizontalLayout {
                                    spacing: 6px;
                                    TonalBadge {
                                        y: (parent.height - self.height) / 2;
                                        label: "ARTIST: \{root.filtered-artist-name}";
                                        badge-bg: Theme.primary-container;
                                        badge-fg: Theme.on-primary-container;
                                    }
                                    M3Button {
                                        y: (parent.height - self.height) / 2;
                                        compact: true;
                                        variant: root.filtered-artist-status == "muted" ? "primary-tonal" : "outlined";
                                        has-icon: true;
                                        icon: root.filtered-artist-status == "muted"
                                            ? @image-url("../../assets/icons/volume-on.svg")
                                            : @image-url("../../assets/icons/volume-off.svg");
                                        text: root.filtered-artist-status == "muted" ? "Unmute" : "Mute";
                                        clicked => { root.toggle-artist-mute(root.filtered-artist-id); }
                                    }
                                    M3Button {
                                        y: (parent.height - self.height) / 2;
                                        compact: true;
                                        variant: root.filtered-artist-status == "ignored" || root.filtered-artist-status == "missing" ? "primary-tonal" : "danger";
                                        has-icon: true;
                                        icon: root.filtered-artist-status == "missing"
                                            ? @image-url("../../assets/icons/plus.svg")
                                            : @image-url("../../assets/icons/eye-off.svg");
                                        text: root.filtered-artist-status == "missing" ? "Track"
                                            : root.filtered-artist-status == "ignored" ? "Restore" : "Hide";
                                        clicked => { root.toggle-artist-ignore(root.filtered-artist-id); }
                                    }
                                    M3Button {
                                        y: (parent.height - self.height) / 2;
                                        compact: true;
                                        variant: "outlined";
                                        has-icon: true;
                                        icon: @image-url("../../assets/icons/close.svg");
                                        text: "Clear";
                                        clicked => { root.clear-artist-feed-filter(); }
                                    }
                                }
                                M3Switch {
                                    y: (parent.height - self.height) / 2;
                                    text: "Hide owned";
                                    checked <=> root.feed-hide-owned;
                                    toggled => { root.feed-filters-changed(); }
                                }
                                M3Button {
                                    y: (parent.height - self.height) / 2;
                                    variant: "primary-tonal";
                                    has-icon: true;
                                    icon: @image-url("../../assets/icons/done-all.svg");
                                    text: "Mark Filtered Seen";
                                    enabled: root.filtered-unseen-count > 0;
                                    clicked => { root.mark-all-seen(); }
                                }
                            }
                        }
                        M3HorizontalScrollBar {
                            x: action-scroll.x;
                            y: action-scroll.y + 38px;
                            width: action-scroll.visible-width;
                            page-size: action-scroll.visible-width;
                            maximum: max(0px, action-scroll.content-width - action-scroll.visible-width);
                            value: -action-scroll.content-x;
                            scrolled(val) => { action-scroll.content-x = -val; }
                        }
                    }

                    // Keep search, sort, and all filter chips accessible when the
                    // inspector narrows the radar. Only the chips need to scroll at
                    // very small widths; the search field remains the same instance.
                    filter-bar := Rectangle {
                        property <bool> narrow: self.width < chip-row.preferred-width + 344px;
                        property <bool> stacked: self.width < 340px;
                        height: self.stacked ? 124px : self.narrow ? 84px : 44px;
                        vertical-stretch: 0;

                        feed-search-input := M3SearchField {
                            x: 0px;
                            y: 0px;
                            width: filter-bar.stacked ? filter-bar.width
                                : filter-bar.narrow ? max(0px, filter-bar.width - 166px)
                                : min(290px, max(170px, filter-bar.width - chip-row.preferred-width - 174px));
                            height: 34px;
                            text <=> root.feed-search-text;
                            placeholder: "Search artist or release...  (/)";
                            edited => { root.feed-filters-changed(); }
                        }

                        sort-select := M3Select {
                            x: filter-bar.stacked ? 0px : max(0px, filter-bar.width - self.width);
                            y: filter-bar.stacked ? 40px : 0px;
                            width: min(158px, filter-bar.width);
                            height: 34px;
                            model: ["Newest First", "Upcoming First", "Artist A–Z"];
                            current-index <=> root.feed-sort-index;
                            selected => { root.feed-filters-changed(); }
                        }

                        chip-scroll := ScrollView {
                            x: filter-bar.narrow ? 0px : feed-search-input.width + 8px;
                            y: filter-bar.stacked ? 80px : filter-bar.narrow ? 40px : 0px;
                            width: filter-bar.narrow ? filter-bar.width : max(0px, sort-select.x - self.x - 8px);
                            // Material ScrollView reserves 12px even with its scrollbar off.
                            height: 44px;
                            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            content-width: max(self.visible-width, chip-row.preferred-width);
                            content-height: 32px;

                            chip-row := HorizontalLayout {
                                x: 0px;
                                y: 0px;
                                spacing: 5px;
                                width: self.preferred-width;
                                height: 32px;

                                M3FilterChip {
                                    label: "All";
                                    selected: root.feed-status-index == 0;
                                    clicked => {
                                        root.feed-status-index = 0;
                                        root.feed-filters-changed();
                                    }
                                }
                                M3FilterChip {
                                    label: "Unread";
                                    selected: root.feed-status-index == 1;
                                    clicked => {
                                        root.feed-status-index = 1;
                                        root.feed-filters-changed();
                                    }
                                }
                                M3FilterChip {
                                    label: "Upcoming";
                                    selected: root.feed-status-index == 2;
                                    clicked => {
                                        root.feed-status-index = 2;
                                        root.feed-filters-changed();
                                    }
                                }
                                Rectangle {
                                    width: 1px;
                                    height: 20px;
                                    y: 6px;
                                    background: Theme.outline-variant;
                                }
                                M3FilterChip {
                                    label: "All Types";
                                    selected: root.feed-type-index == 0;
                                    clicked => {
                                        root.feed-type-index = 0;
                                        root.feed-filters-changed();
                                    }
                                }
                                M3FilterChip {
                                    label: "Albums";
                                    selected: root.feed-type-index == 1;
                                    clicked => {
                                        root.feed-type-index = 1;
                                        root.feed-filters-changed();
                                    }
                                }
                                M3FilterChip {
                                    label: "EPs";
                                    selected: root.feed-type-index == 2;
                                    clicked => {
                                        root.feed-type-index = 2;
                                        root.feed-filters-changed();
                                    }
                                }
                                M3FilterChip {
                                    label: "Singles";
                                    selected: root.feed-type-index == 3;
                                    clicked => {
                                        root.feed-type-index = 3;
                                        root.feed-filters-changed();
                                    }
                                }
                            }
                        }

                        M3HorizontalScrollBar {
                            x: chip-scroll.x;
                            y: chip-scroll.y + 34px;
                            width: chip-scroll.visible-width;
                            page-size: chip-scroll.visible-width;
                            maximum: max(0px, chip-scroll.content-width - chip-scroll.visible-width);
                            value: -chip-scroll.content-x;
                            scrolled(val) => { chip-scroll.content-x = -val; }
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    width: 100%;
                    height: 1px;
                    background: Theme.outline-variant;
                }
            }

            // Empty state actions wrap instead of forcing a card wider than
            // the viewport when both Check and Reset are available.
            if root.releases.length == 0 : VerticalLayout {
                min-height: empty-card.height;
                vertical-stretch: 1;
                alignment: center;

                HorizontalLayout {
                    min-width: 0px;
                    alignment: center;
                    padding-left: page-scroll.visible-width < 350px ? 10px : 24px;
                    padding-right: page-scroll.visible-width < 350px ? 10px : 24px;

                    empty-card := Rectangle {
                        min-width: 0px;
                        preferred-width: 460px;
                        max-width: 460px;
                        horizontal-stretch: 1;
                        height: max(244px, empty-content.preferred-height);
                        border-radius: 18px;
                        background: Theme.surface-container;
                        border-width: 1px;
                        border-color: Theme.outline-variant;

                        empty-content := VerticalLayout {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 100%;
                            min-width: 0px;
                            padding: empty-card.width < 350px ? 16px : 28px;
                            spacing: 12px;
                            alignment: center;

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    border-radius: 22px;
                                    background: Theme.primary-container;

                                    Image {
                                        width: 22px;
                                        height: 22px;
                                        x: 11px;
                                        y: 11px;
                                        source: @image-url("../../assets/icons/sparkles.svg");
                                        colorize: Theme.primary;
                                    }
                                }
                            }

                            Text {
                                text: root.library-folders.length == 0
                                    ? "Add one or more local music folders to automatically discover your artists and track new albums, EPs, and singles."
                                    : "No releases match your active filters. Run a release check or broaden your status, type, or lookback filters.";
                                font-size: 12px;
                                color: Theme.on-surface-variant;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }

                            if root.library-folders.length == 0 : HorizontalLayout {
                                alignment: center;
                                M3Button {
                                    variant: "filled";
                                    has-icon: true;
                                    icon: @image-url("../../assets/icons/folder-plus.svg");
                                    text: "Add Music Folder";
                                    clicked => { root.navigate(2); }
                                }
                            }

                            if root.library-folders.length > 0 : Rectangle {
                                property <bool> has-reset: root.feed-status-index != 0
                                    || root.feed-type-index != 0 || root.feed-search-text != "";
                                property <bool> stacked: self.has-reset
                                    && self.width < check-action.width + reset-action.width + 10px;
                                property <length> actions-width: check-action.width
                                    + (self.has-reset ? reset-action.width + 10px : 0px);
                                min-width: 0px;
                                height: self.stacked ? 82px : 36px;
                                vertical-stretch: 0;

                                check-action := M3Button {
                                    x: parent.stacked ? max(0px, (parent.width - self.width) / 2)
                                        : max(0px, (parent.width - parent.actions-width) / 2);
                                    y: 0px;
                                    width: self.preferred-width;
                                    variant: "filled";
                                    has-icon: true;
                                    icon: @image-url("../../assets/icons/refresh.svg");
                                    text: "Check Releases Now";
                                    enabled: !root.is-busy;
                                    clicked => { root.check-all-releases(); }
                                }

                                reset-action := M3Button {
                                    visible: parent.has-reset;
                                    x: parent.stacked ? max(0px, (parent.width - self.width) / 2)
                                        : check-action.x + check-action.width + 10px;
                                    y: parent.stacked ? 46px : 0px;
                                    width: self.preferred-width;
                                    variant: "tonal";
                                    text: "Reset Filters";
                                    clicked => {
                                        root.feed-status-index = 0;
                                        root.feed-type-index = 0;
                                        root.feed-search-text = "";
                                        root.feed-filters-changed();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Viewport-culled cover grid. The inspector reserves its final width at once,
            // avoiding repeated column changes while the drawer slides into place.
            if root.releases.length > 0 : Rectangle {
                min-height: 280px;
                vertical-stretch: 1;
                clip: true;

                feed-scroll := ScrollView {
                    width: 100%;
                    height: 100%;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                    property <length> target-cell: root.pref-grid-density == 0 ? 170px
                                                 : root.pref-grid-density == 2 ? 236px
                                                 : 200px;
                    property <length> gap: 14px;
                    property <length> pad: 20px;
                    property <length> avail-w: max(1px, self.visible-width - 2 * self.pad);
                    // At the minimum window width the inspector may leave room for
                    // only one card. Never keep an inaccessible clipped second column.
                    property <int> cols: self.avail-w < 2 * 145px + self.gap ? 1
                        : max(2, min(10, Math.floor((self.avail-w + self.gap) / (self.target-cell + self.gap))));
                    property <length> card-w: (self.avail-w - (self.cols - 1) * self.gap) / self.cols;
                    property <length> card-h: self.card-w + 76px;
                    property <int> total-rows: Math.ceil(root.releases.length / self.cols);
                    property <length> scroll-top: -self.content-y;

                    content-width: self.visible-width;
                    content-height: max(self.visible-height, self.pad * 2 + self.total-rows * self.card-h + max(0, self.total-rows - 1) * self.gap);

                    function reveal-card(top: length, card-height: length) {
                        let view-top = -self.content-y;
                        let margin = 12px;
                        let max-scroll = max(0px, self.content-height - self.visible-height);
                        if (top < view-top + margin || card-height > self.visible-height - 2 * margin) {
                            self.content-y = -min(max-scroll, max(0px, top - margin));
                        } else if (top + card-height > view-top + self.visible-height - margin) {
                            self.content-y = -min(max-scroll, max(0px, top + card-height - self.visible-height + margin));
                        }
                    }

                    for item[idx] in root.releases : Rectangle {
                        property <int> row-idx: Math.floor(idx / feed-scroll.cols);
                        property <int> col-idx: Math.mod(idx, feed-scroll.cols);
                        property <length> item-y: feed-scroll.pad + self.row-idx * (feed-scroll.card-h + feed-scroll.gap);
                        property <length> viewport-height: feed-scroll.visible-height;
                        property <bool> selected-card: root.inspector-mode == 1 && root.selected-release-id == item.id;
                        property <bool> in-viewport:
                            (self.item-y + feed-scroll.card-h >= feed-scroll.scroll-top - feed-scroll.card-h)
                            && (self.item-y <= feed-scroll.scroll-top + feed-scroll.visible-height + feed-scroll.card-h);

                        // Selection and the final grid geometry can update separately. Keep
                        // the active item visible after either change, without following
                        // the selection when the user subsequently scrolls by hand.
                        changed selected-card => {
                            if self.selected-card { feed-scroll.reveal-card(self.item-y, self.height); }
                        }
                        changed item-y => {
                            if self.selected-card { feed-scroll.reveal-card(self.item-y, self.height); }
                        }
                        changed height => {
                            if self.selected-card { feed-scroll.reveal-card(self.item-y, self.height); }
                        }
                        changed viewport-height => {
                            if self.selected-card { feed-scroll.reveal-card(self.item-y, self.height); }
                        }

                        x: feed-scroll.pad + self.col-idx * (feed-scroll.card-w + feed-scroll.gap);
                        y: self.item-y;
                        width: feed-scroll.card-w;
                        height: feed-scroll.card-h;

                        if self.in-viewport : ReleaseCard {
                            width: 100%;
                            height: 100%;
                            data: item;
                            selected: parent.selected-card;
                            playing-this-release: root.preview-active && root.preview-playing && root.preview-release-id == item.id;

                            select-release(id) => { root.select-release(id); }
                            toggle-seen(id) => { root.toggle-release-seen(id); }
                            dismiss-release(id) => { root.dismiss-release(id); }
                            open-artist(aid) => { root.inspect-artist(aid); }
                        }
                    }
                }

                M3ScrollBar {
                    x: parent.width - self.width
                        - (page-scroll.content-height > page-scroll.visible-height ? 12px : 2px);
                    y: 4px;
                    height: parent.height - 8px;
                    page-size: feed-scroll.visible-height;
                    maximum: max(0px, feed-scroll.content-height - feed-scroll.visible-height);
                    value: -feed-scroll.content-y;
                    scrolled(val) => { feed-scroll.content-y = -val; }
                }
            }
        }
    }

    M3ScrollBar {
        x: parent.width - self.width - 2px;
        y: 4px;
        height: max(0px, parent.height - 8px);
        page-size: page-scroll.visible-height;
        maximum: max(0px, page-scroll.content-height - page-scroll.visible-height);
        value: -page-scroll.content-y;
        scrolled(val) => { page-scroll.content-y = -val; }
    }
}
