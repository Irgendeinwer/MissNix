import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { FolderRowData } from "../models.slint";
import {
    AccentSwatchGrid,
    FolderItemRow,
    M3Button,
    M3ChipGrid,
    M3HorizontalScrollBar,
    M3LabeledChipGrid,
    M3LabeledInput,
    M3LabeledSelect,
    M3ScrollBar,
    M3Switch,
    SectionCard,
} from "../components.slint";

export component SettingsView inherits Rectangle {
    in-out property <int> active-view;
    callback add-folder-path(string);
    callback apply-theme(bool, int);
    callback browse-for-folder();
    callback custom-accent-changed(string, bool);
    in property <bool> is-busy;
    in property <[FolderRowData]> library-folders;
    in-out property <string> new-folder-path;
    in-out property <int> pref-accent-preset;
    in-out property <string> pref-custom-accent-hex;
    in-out property <bool> pref-dark-mode;
    in-out property <int> pref-discovery-mode;
    in-out property <int> pref-grid-density;
    in-out property <bool> pref-hide-noise;
    in-out property <bool> pref-hide-owned;
    in-out property <bool> pref-include-albums;
    in-out property <bool> pref-include-compilations;
    in-out property <bool> pref-include-eps;
    in-out property <bool> pref-include-singles;
    in-out property <int> pref-lookback-index;
    in-out property <int> pref-provider-index;
    in-out property <int> pref-schedule-index;
    in-out property <bool> pref-split-collaborations;
    in-out property <int> pref-ui-scale-pct;
    callback preferences-changed();
    callback remove-folder(int);
    callback scan-library();
    callback scan-preferences-changed();
    callback theme-toggled(bool);
    callback ui-scale-changed(int);

    visible: root.active-view == 2;
    width: 100%;
    height: 100%;

    settings-scroll := ScrollView {
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        // Only extremely narrow logical widths need horizontal panning. Keep
        // controls readable even if the system font needs wider chips.
        // The extra 84px is the horizontal page and card padding.
        content-width: max(max(396px, self.visible-width), discovery-grid.cell-width + 84px);

        HorizontalLayout {
            width: settings-scroll.content-width;
            padding-top: 22px;
            padding-bottom: 28px;
            padding-left: 22px;
            padding-right: 22px;
            alignment: center;

            VerticalLayout {
                min-width: 0px;
                max-width: 900px;
                horizontal-stretch: 1;
                spacing: 16px;
                alignment: start;

                VerticalLayout {
                    spacing: 2px;
                    alignment: start;
                    Text {
                        text: "Library & Preferences";
                        font-size: 21px;
                        font-weight: 800;
                        color: Theme.on-surface;
                    }
                    Text {
                        text: "Customize Material 3 appearance, HiDPI interface scaling, artist discovery rules, and release sources";
                        wrap: word-wrap;
                        font-size: 12px;
                        color: Theme.on-surface-variant;
                    }
                }

                // Card 1: Appearance, HiDPI Scaling & Desktop Layout
                SectionCard {
                    title: "Appearance, HiDPI Scaling & Layout";
                    subtitle: "Personalize MissNix's OKLCH Material 3 tonal palette (including surfaces, rails, switches & cards), UI scale factor, and grid density.";

                    M3Switch {
                        text: "Dark Material 3 Surface Theme";
                        checked <=> root.pref-dark-mode;
                        toggled => {
                            root.apply-theme(root.pref-dark-mode, root.pref-accent-preset);
                            root.theme-toggled(root.pref-dark-mode);
                        }
                    }

                    VerticalLayout {
                        spacing: 10px;
                        alignment: start;

                        Text {
                            text: "Material 3 Tonal Palette";
                            font-size: 12.5px;
                            font-weight: 600;
                            color: Theme.on-surface;
                        }

                        AccentSwatchGrid {
                            selected-index: root.pref-accent-preset;
                            custom-color: Theme.custom-swatch;
                            selected(index) => {
                                root.apply-theme(root.pref-dark-mode, index);
                                root.preferences-changed();
                            }
                        }

                        // Custom Hex Seed Generator + Live Tonal Strip
                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;

                            custom-controls := Rectangle {
                                property <bool> stacked: self.width < 300px;
                                property <bool> palette-below: self.width < 490px;
                                height: self.stacked ? 124px : self.palette-below ? 82px : 38px;
                                min-width: 0px;
                                vertical-stretch: 0;

                                hex-input := M3LabeledInput {
                                    x: 0px;
                                    y: 0px;
                                    width: custom-controls.stacked ? min(175px, custom-controls.width)
                                        : min(175px, max(0px, custom-controls.width - apply-hex.width - 10px));
                                    placeholder: "#EA6C34";
                                    text <=> root.pref-custom-accent-hex;
                                    edited => { root.custom-accent-changed(root.pref-custom-accent-hex, false); }
                                    accepted(val) => { root.custom-accent-changed(val, true); }
                                }
                                apply-hex := M3Button {
                                    x: custom-controls.stacked ? 0px : hex-input.width + 10px;
                                    y: custom-controls.stacked ? 44px : 1px;
                                    width: self.preferred-width;
                                    variant: root.pref-accent-preset == 7 ? "filled" : "primary-tonal";
                                    text: "Apply Custom Hex";
                                    clicked => { root.custom-accent-changed(root.pref-custom-accent-hex, true); }
                                }
                                Rectangle {
                                    x: custom-controls.palette-below ? 0px : apply-hex.x + apply-hex.width + 10px;
                                    y: custom-controls.stacked ? 88px : custom-controls.palette-below ? 44px : 3px;
                                    width: 124px;
                                    height: 32px;
                                    border-radius: 9px;
                                    border-width: 1px;
                                    border-color: Theme.outline;
                                    clip: true;
                                    HorizontalLayout {
                                        Rectangle { horizontal-stretch: 1; background: Theme.surface; }
                                        Rectangle { horizontal-stretch: 1; background: Theme.surface-container-high; }
                                        Rectangle { horizontal-stretch: 1; background: Theme.primary-container; }
                                        Rectangle { horizontal-stretch: 1; background: Theme.primary; }
                                    }
                                }
                            }

                            Text {
                                text: "Enter any #RRGGBB color to generate a matching dark & light tonal palette.";
                                font-size: 11.5px;
                                color: Theme.on-surface-muted;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // HiDPI UI Scaling Selector
                    VerticalLayout {
                        spacing: 7px;
                        alignment: start;

                        Text {
                            text: "Interface Scale (HiDPI):";
                            font-size: 12.5px;
                            font-weight: 600;
                            color: Theme.on-surface;
                        }

                        M3ChipGrid {
                            labels: ["90%", "100%", "115%", "125%", "150%", "175%", "200%"];
                            selections: [root.pref-ui-scale-pct == 90, root.pref-ui-scale-pct == 100,
                                root.pref-ui-scale-pct == 115, root.pref-ui-scale-pct == 125,
                                root.pref-ui-scale-pct == 150, root.pref-ui-scale-pct == 175,
                                root.pref-ui-scale-pct == 200];
                            item-width: 84px;
                            widest-label: "100%";
                            activated(index) => {
                                if (index == 0) { root.ui-scale-changed(90); }
                                else if (index == 1) { root.ui-scale-changed(100); }
                                else if (index == 2) { root.ui-scale-changed(115); }
                                else if (index == 3) { root.ui-scale-changed(125); }
                                else if (index == 4) { root.ui-scale-changed(150); }
                                else if (index == 5) { root.ui-scale-changed(175); }
                                else if (index == 6) { root.ui-scale-changed(200); }
                            }
                        }

                        Text {
                            text: "Active scale: \{root.pref-ui-scale-pct}%  ·  Shortcuts: Ctrl + / Ctrl - / Ctrl 0 (ideal for high-DPI monitors without compositor scaling)";
                            font-size: 11px;
                            color: Theme.on-surface-muted;
                            wrap: word-wrap;
                        }
                    }

                    M3LabeledChipGrid {
                        label: "Release Cover Grid Size:";
                        labels: ["Compact", "Comfortable", "Spacious"];
                        selections: [root.pref-grid-density == 0, root.pref-grid-density == 1, root.pref-grid-density == 2];
                        item-width: 132px;
                        widest-label: "Comfortable";
                        activated(index) => {
                            root.pref-grid-density = index;
                            root.preferences-changed();
                        }
                    }
                }

                // Card 2: Local Music Folders & Artist Discovery Mode
                SectionCard {
                    title: "Local Music Folders & Artist Discovery";
                    subtitle: "Configure your music directories and choose how MissNix extracts artist identity from ALBUMARTIST tags, folder names, and collaboration credits.";

                    folder-controls := Rectangle {
                        property <bool> stacked: self.width < 490px;
                        property <bool> buttons-stacked: self.width < add-path.width + browse.width + 10px;
                        height: self.buttons-stacked ? 126px : self.stacked ? 86px : 38px;
                        min-width: 0px;
                        vertical-stretch: 0;

                        folder-input := M3LabeledInput {
                            x: 0px;
                            y: 0px;
                            width: folder-controls.stacked ? folder-controls.width
                                : max(0px, folder-controls.width - add-path.width - browse.width - 20px);
                            placeholder: "Enter music directory path (e.g. ~/Music) or click Browse...";
                            text <=> root.new-folder-path;
                            accepted(val) => { root.add-folder-path(val); }
                        }
                        add-path := M3Button {
                            x: folder-controls.stacked ? 0px : folder-input.width + 10px;
                            y: folder-controls.stacked ? 48px : 1px;
                            width: self.preferred-width;
                            variant: "primary-tonal";
                            has-icon: true;
                            icon: @image-url("../../assets/icons/plus.svg");
                            text: "Add Path";
                            enabled: root.new-folder-path != "";
                            clicked => { root.add-folder-path(root.new-folder-path); }
                        }
                        browse := M3Button {
                            x: folder-controls.buttons-stacked ? 0px : add-path.x + add-path.width + 10px;
                            y: folder-controls.buttons-stacked ? 88px : add-path.y;
                            width: self.preferred-width;
                            variant: "outlined";
                            has-icon: true;
                            icon: @image-url("../../assets/icons/folder-plus.svg");
                            text: "Browse...";
                            clicked => { root.browse-for-folder(); }
                        }
                    }

                    if root.library-folders.length == 0 : Text {
                        text: "No music folders added yet.";
                        font-size: 12px;
                        color: Theme.on-surface-muted;
                    }

                    for folder in root.library-folders : FolderItemRow {
                        folder: folder;
                        remove-folder(id) => { root.remove-folder(id); }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.outline-variant;
                    }

                    VerticalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "Artist Discovery Source";
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.on-surface;
                        }

                        discovery-grid := M3ChipGrid {
                            labels: ["Album Artist + Folder (Recommended)", "Folder Structure Only", "All Metadata Tags + Folder"];
                            selections: [root.pref-discovery-mode == 0, root.pref-discovery-mode == 1, root.pref-discovery-mode == 2];
                            item-width: 310px;
                            widest-label: "Album Artist + Folder (Recommended)";
                            activated(index) => {
                                root.pref-discovery-mode = index;
                                root.scan-preferences-changed();
                            }
                        }

                        Text {
                            text: root.pref-discovery-mode == 0
                                ? "Uses ALBUMARTIST tags and structured <Artist>/<Album> folder names first so guest track credits never pollute your artist list."
                                : root.pref-discovery-mode == 1
                                    ? "Discovers artists strictly from <MusicRoot>/<Artist>/<Album> directory names, ignoring embedded artist tags."
                                    : "Reads ALBUMARTIST and track ARTIST tags across all files, falling back to folder names.";
                            font-size: 11.5px;
                            color: Theme.on-surface-muted;
                            wrap: word-wrap;
                        }
                    }

                    M3Switch {
                        text: "Clean multi-artist collaboration delimiters (';', '/', 'feat.', ', ') into primary artist";
                        checked <=> root.pref-split-collaborations;
                        toggled => { root.scan-preferences-changed(); }
                    }

                    M3Switch {
                        text: "Include one-off track artists from 'Various Artists' soundtrack/compilation albums";
                        checked <=> root.pref-include-compilations;
                        toggled => { root.scan-preferences-changed(); }
                    }

                    HorizontalLayout {
                        alignment: start;
                        M3Button {
                            variant: "filled";
                            has-icon: true;
                            icon: @image-url("../../assets/icons/refresh.svg");
                            text: "Rescan All Folders Now";
                            enabled: !root.is-busy && root.library-folders.length > 0;
                            clicked => { root.scan-library(); }
                        }
                    }
                }

                // Card 3: Release Filtering & Smart Deduplication
                SectionCard {
                    title: "Release Radar & Smart Deduplication";
                    subtitle: "Control which release types appear in your feed and suppress albums already owned in your local library.";

                    M3LabeledChipGrid {
                        label: "Included Release Types:";
                        labels: ["Albums", "EPs", "Singles"];
                        selections: [root.pref-include-albums, root.pref-include-eps, root.pref-include-singles];
                        item-width: 98px;
                        widest-label: "Singles";
                        activated(index) => {
                            if (index == 0) { root.pref-include-albums = !root.pref-include-albums; }
                            else if (index == 1) { root.pref-include-eps = !root.pref-include-eps; }
                            else if (index == 2) { root.pref-include-singles = !root.pref-include-singles; }
                            root.preferences-changed();
                        }
                    }

                    M3Switch {
                        text: "Smart Local Deduplication — hide releases already in your local music folders";
                        checked <=> root.pref-hide-owned;
                        toggled => { root.preferences-changed(); }
                    }

                    M3Switch {
                        text: "Filter out greatest-hits compilations, live bootlegs & karaoke editions";
                        checked <=> root.pref-hide-noise;
                        toggled => { root.preferences-changed(); }
                    }

                    M3LabeledSelect {
                        label: "Release lookback window:";
                        select-width: 240px;
                        model: ["Last 90 days", "Last 6 months", "Last 1 year", "Last 2 years", "All time"];
                        current-index <=> root.pref-lookback-index;
                        selected => { root.preferences-changed(); }
                    }
                }

                // Card 4: Data Sources & Sync Schedule
                SectionCard {
                    title: "Metadata Providers & Automatic Schedule";
                    subtitle: "Deezer provides artwork, tracklists, and in-app 30s audio previews; MusicBrainz provides exact MBID disambiguation and upcoming release dates.";

                    M3LabeledSelect {
                        label: "Release lookup sources:";
                        select-width: 290px;
                        model: ["Deezer + MusicBrainz (Recommended)", "Deezer Only", "MusicBrainz Only"];
                        current-index <=> root.pref-provider-index;
                        selected => { root.preferences-changed(); }
                    }

                    M3LabeledSelect {
                        label: "Automatic check schedule:";
                        select-width: 290px;
                        model: ["Manual check only", "Every 6 hours", "Every 12 hours", "Every 24 hours"];
                        current-index <=> root.pref-schedule-index;
                        selected => { root.preferences-changed(); }
                    }
                }
            }
        }
    }

    M3HorizontalScrollBar {
        x: 0px;
        y: parent.height - self.height;
        width: settings-scroll.visible-width;
        page-size: settings-scroll.visible-width;
        maximum: max(0px, settings-scroll.content-width - settings-scroll.visible-width);
        value: -settings-scroll.content-x;
        scrolled(val) => { settings-scroll.content-x = -val; }
    }

    M3ScrollBar {
        x: parent.width - self.width - 2px;
        y: 4px;
        height: parent.height - 8px;
        page-size: settings-scroll.visible-height;
        maximum: max(0px, settings-scroll.content-height - settings-scroll.visible-height);
        value: -settings-scroll.content-y;
        scrolled(val) => { settings-scroll.content-y = -val; }
    }
}
