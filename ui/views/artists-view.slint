import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ArtistRowData, SearchCandidateRowData } from "../models.slint";
import {
    ArtistListRow,
    M3Button,
    M3FilterChip,
    M3HorizontalScrollBar,
    M3ScrollBar,
    M3SearchField,
    M3Spinner,
    SearchCandidateRow,
} from "../components.slint";

export component ArtistsView inherits HorizontalLayout {
    in-out property <int> active-view;
    callback add-artist-by-name(string);
    callback add-search-candidate(int);
    in-out property <int> artist-filter-index;
    callback artist-filters-changed();
    in property <[SearchCandidateRowData]> artist-search-candidates;
    in-out property <string> artist-search-text;
    in property <[ArtistRowData]> artists;
    in-out property <int> inspector-mode;
    in-out property <string> manual-artist-query;
    callback search-external-artist(string);
    in property <bool> searching-external-artists;
    callback select-artist(int);
    in property <int> selected-artist-id;
    in-out property <bool> show-add-artist-bar;
    callback toggle-artist-ignore(int);
    callback toggle-artist-mute(int);
    callback view-artist-releases(int);

    public function focus-search() {
        artist-search-input.focus-input();
    }

    visible: root.active-view == 1;
    width: 100%;
    height: 100%;
    alignment: center;

    VerticalLayout {
        max-width: 1040px;
        preferred-width: 1040px;
        min-width: 0px;
        horizontal-stretch: 1;
        height: 100%;
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 16px;
        padding-bottom: 14px;
        spacing: 12px;

        // Keep the add action reachable when the inspector narrows this view.
        heading := Rectangle {
            property <bool> narrow: self.width < 760px;
            height: self.narrow ? 84px : 40px;
            vertical-stretch: 0;

            VerticalLayout {
                x: 0px;
                y: 0px;
                width: heading.narrow ? heading.width : max(0px, heading.width - 138px);
                height: 40px;
                alignment: center;
                spacing: 2px;
                Text {
                    text: "Tracked Artists";
                    font-size: 21px;
                    font-weight: 800;
                    color: Theme.on-surface;
                    overflow: elide;
                }
                Text {
                    text: "Primary artists discovered from your library — click any artist to inspect, mute, hide, or override IDs";
                    font-size: 12px;
                    color: Theme.on-surface-variant;
                    overflow: elide;
                }
            }
            M3Button {
                x: heading.narrow ? 0px : max(0px, heading.width - self.width);
                y: heading.narrow ? 46px : 2px;
                width: min(130px, heading.width);
                variant: root.show-add-artist-bar ? "outlined" : "filled";
                has-icon: true;
                icon: root.show-add-artist-bar
                    ? @image-url("../../assets/icons/close.svg")
                    : @image-url("../../assets/icons/plus.svg");
                text: root.show-add-artist-bar ? "Close" : "Add Artist";
                clicked => { root.show-add-artist-bar = !root.show-add-artist-bar; }
            }
        }

        // Collapsible Manual Artist Search & Add Card
        if root.show-add-artist-bar : Rectangle {
            vertical-stretch: 0;
            border-radius: 14px;
            background: Theme.surface-container;
            border-width: 1px;
            border-color: Theme.primary.with-alpha(0.45);

            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                alignment: start;

                artist-add-controls := Rectangle {
                    property <bool> narrow: self.width < 500px;
                    property <bool> stacked: self.width < 274px;
                    height: self.stacked ? 126px : self.narrow ? 86px : 38px;
                    vertical-stretch: 0;

                    M3SearchField {
                        x: 0px;
                        y: 0px;
                        width: artist-add-controls.narrow ? artist-add-controls.width
                            : max(0px, artist-add-controls.width - 284px);
                        height: 38px;
                        text <=> root.manual-artist-query;
                        placeholder: "Search Deezer & MusicBrainz for an artist to track...";
                        accepted(val) => { root.search-external-artist(val); }
                    }
                    search-online := M3Button {
                        x: artist-add-controls.narrow ? 0px : artist-add-controls.width - 274px;
                        y: artist-add-controls.narrow ? 48px : 1px;
                        width: min(132px, artist-add-controls.width);
                        variant: "filled";
                        text: "Search Online";
                        enabled: root.manual-artist-query != "" && !root.searching-external-artists;
                        clicked => { root.search-external-artist(root.manual-artist-query); }
                    }
                    M3Button {
                        x: artist-add-controls.stacked ? 0px : search-online.x + search-online.width + 10px;
                        y: artist-add-controls.stacked ? 88px : search-online.y;
                        width: min(132px, artist-add-controls.width);
                        variant: "tonal";
                        text: "Add by Name";
                        enabled: root.manual-artist-query != "";
                        clicked => { root.add-artist-by-name(root.manual-artist-query); }
                    }
                }

                if root.searching-external-artists : HorizontalLayout {
                    spacing: 8px;
                    M3Spinner { width: 16px; height: 16px; indeterminate: true; }
                    Text {
                        text: "Searching Deezer & MusicBrainz...";
                        font-size: 12px;
                        color: Theme.on-surface-variant;
                        vertical-alignment: center;
                    }
                }

                if root.artist-search-candidates.length > 0 : VerticalLayout {
                    spacing: 6px;
                    alignment: start;
                    for cand in root.artist-search-candidates : SearchCandidateRow {
                        candidate: cand;
                        add-candidate(idx) => { root.add-search-candidate(idx); }
                    }
                }
            }
        }

        // Stack search and filters as needed; the chips remain scrollable at
        // very narrow widths rather than being clipped behind the drawer.
        artist-filter-bar := Rectangle {
            property <bool> narrow: self.width < artist-chip-row.preferred-width + 200px;
            height: self.narrow ? 84px : 44px;
            vertical-stretch: 0;

            artist-search-input := M3SearchField {
                x: 0px;
                y: 0px;
                width: artist-filter-bar.narrow ? artist-filter-bar.width
                    : min(340px, max(190px, artist-filter-bar.width - artist-chip-row.preferred-width - 10px));
                height: 38px;
                text <=> root.artist-search-text;
                placeholder: "Filter artists by name...  (/)";
                edited => { root.artist-filters-changed(); }
            }
            artist-chip-scroll := ScrollView {
                x: artist-filter-bar.narrow ? 0px : artist-search-input.width + 10px;
                y: artist-filter-bar.narrow ? 42px : 3px;
                width: max(0px, artist-filter-bar.width - self.x);
                height: 44px;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                content-width: max(self.visible-width, artist-chip-row.preferred-width);
                content-height: 32px;

                artist-chip-row := HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    spacing: 6px;
                    width: self.preferred-width;
                    height: 32px;
                    M3FilterChip {
                        label: "All";
                        selected: root.artist-filter-index == 0;
                        clicked => { root.artist-filter-index = 0; root.artist-filters-changed(); }
                    }
                    M3FilterChip {
                        label: "Tracked";
                        selected: root.artist-filter-index == 1;
                        clicked => { root.artist-filter-index = 1; root.artist-filters-changed(); }
                    }
                    M3FilterChip {
                        label: "Muted";
                        selected: root.artist-filter-index == 2;
                        clicked => { root.artist-filter-index = 2; root.artist-filters-changed(); }
                    }
                    M3FilterChip {
                        label: "Ignored";
                        selected: root.artist-filter-index == 3;
                        clicked => { root.artist-filter-index = 3; root.artist-filters-changed(); }
                    }
                    M3FilterChip {
                        label: "Manual";
                        selected: root.artist-filter-index == 4;
                        clicked => { root.artist-filter-index = 4; root.artist-filters-changed(); }
                    }
                }
            }
            M3HorizontalScrollBar {
                x: artist-chip-scroll.x;
                y: artist-chip-scroll.y + 34px;
                width: artist-chip-scroll.visible-width;
                page-size: artist-chip-scroll.visible-width;
                maximum: max(0px, artist-chip-scroll.content-width - artist-chip-scroll.visible-width);
                value: -artist-chip-scroll.content-x;
                scrolled(val) => { artist-chip-scroll.content-x = -val; }
            }
        }

        if root.artists.length == 0 : Rectangle {
            vertical-stretch: 1;
            Text {
                text: "No matching artists found. Scan your music folders or click 'Add Artist' above.";
                font-size: 13px;
                color: Theme.on-surface-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.artists.length > 0 : Rectangle {
            vertical-stretch: 1;
            clip: true;

            artists-list := ListView {
                width: 100%;
                height: 100%;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                content-width: self.visible-width;

                for art in root.artists : VerticalLayout {
                    padding-bottom: 6px;
                    ArtistListRow {
                        artist: art;
                        selected: root.inspector-mode == 2 && root.selected-artist-id == art.id;
                        select-artist(id) => {
                            root.select-artist(
                                (root.inspector-mode == 2 && root.selected-artist-id == id) ? 0 : id
                            );
                        }
                        view-drops(id) => { root.view-artist-releases(id); }
                        toggle-mute(id) => { root.toggle-artist-mute(id); }
                        toggle-ignore(id) => { root.toggle-artist-ignore(id); }
                    }
                }
            }

            M3ScrollBar {
                x: parent.width - self.width;
                y: 2px;
                height: parent.height - 4px;
                page-size: artists-list.visible-height;
                maximum: max(0px, artists-list.content-height - artists-list.visible-height);
                value: -artists-list.content-y;
                scrolled(val) => { artists-list.content-y = -val; }
            }
        }
    }
}
